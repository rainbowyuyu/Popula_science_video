# Explicit presentation allowlist. No blanket image/model ignore: the export
# deliberately includes selected small assets and existing project covers.
!/docs/assets/
!/docs/assets/**/*.svg
!/docs/assets/**/*.png
!/docs/assets/**/*.jpg
!/docs/assets/**/*.jpeg
!/docs/assets/**/*.webp
!/video_project/creator_workbench/web/assets/
!/video_project/creator_workbench/web/assets/editor-*.svg
!/video_project/creator_workbench/web/assets/editor-*.png
!/video_project/creator_workbench/web/assets/editor-*.ico
!/video_project/creator_workbench/web/assets/editor-brand-manifest.json
!/video_project/creator_workbench/web/assets/rainbow-source.svg

# Deliberately do NOT ignore all work/, output/, delivery/, public/, assets/,
# or research/: some legacy projects keep original scripts and manifests there.
# Do not force-add credentials or private state; use the export/asset manifest.
