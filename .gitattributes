* text=auto eol=lf

# Native Windows entry points
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Text authoring formats
*.md text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
*.svg text eol=lf
*.srt text eol=lf
*.vtt text eol=lf
*.ass text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.tex text eol=lf
*.bib text eol=lf

