[
  {
    "id": "v4c-hero-0-0",
    "sourceClip": "v4c-hero-0",
    "text": "二十兆瓦海上风机。",
    "startMs": 550,
    "endMs": 2030
  },
  {
    "id": "v4c-hero-0-1",
    "sourceClip": "v4c-hero-0",
    "text": "让工程需求，",
    "startMs": 2410,
    "endMs": 3290
  },
  {
    "id": "v4c-hero-0-2",
    "sourceClip": "v4c-hero-0",
    "text": "接上真实计算。",
    "startMs": 3510,
    "endMs": 4410
  },
  {
    "id": "v4c-brief-0-0",
    "sourceClip": "v4c-brief-0",
    "text": "AI Engineer，",
    "startMs": 7550,
    "endMs": 8510
  },
  {
    "id": "v4c-brief-0-1",
    "sourceClip": "v4c-brief-0",
    "text": "把这条路接起来。",
    "startMs": 8830,
    "endMs": 9770
  },
  {
    "id": "v4c-brief-1-0",
    "sourceClip": "v4c-brief-1",
    "text": "目标、海况、材料和约束，",
    "startMs": 10083,
    "endMs": 12143
  },
  {
    "id": "v4c-brief-1-1",
    "sourceClip": "v4c-brief-1",
    "text": "变成参数与任务。",
    "startMs": 12443,
    "endMs": 13623
  },
  {
    "id": "v4c-brief-1-2",
    "sourceClip": "v4c-brief-1",
    "text": "系统安排工具，",
    "startMs": 14003,
    "endMs": 15123
  },
  {
    "id": "v4c-brief-1-3",
    "sourceClip": "v4c-brief-1",
    "text": "让每一步接得上。",
    "startMs": 15323,
    "endMs": 16283
  },
  {
    "id": "v4c-topology-0-0",
    "sourceClip": "v4c-topology-0",
    "text": "先建立几何，",
    "startMs": 19550,
    "endMs": 20620
  },
  {
    "id": "v4c-topology-0-1",
    "sourceClip": "v4c-topology-0",
    "text": "划分网格，再让贝索沿着受力路径调整材料。",
    "startMs": 20620,
    "endMs": 23990
  },
  {
    "id": "v4c-topology-1-0",
    "sourceClip": "v4c-topology-1",
    "text": "哪里保留，哪里移除，",
    "startMs": 24314,
    "endMs": 25774
  },
  {
    "id": "v4c-topology-1-1",
    "sourceClip": "v4c-topology-1",
    "text": "构件多粗多厚，",
    "startMs": 25994,
    "endMs": 27014
  },
  {
    "id": "v4c-topology-1-2",
    "sourceClip": "v4c-topology-1",
    "text": "都交给计算。",
    "startMs": 27014,
    "endMs": 28054
  },
  {
    "id": "v4c-topology-1-3",
    "sourceClip": "v4c-topology-1",
    "text": "系统把前一步的结果，",
    "startMs": 28294,
    "endMs": 29614
  },
  {
    "id": "v4c-topology-1-4",
    "sourceClip": "v4c-topology-1",
    "text": "送到下一步。",
    "startMs": 29614,
    "endMs": 30794
  },
  {
    "id": "v4c-physics-0-0",
    "sourceClip": "v4c-physics-0",
    "text": "有了结构，还要看它在风浪里怎样运动。",
    "startMs": 34550,
    "endMs": 37890
  },
  {
    "id": "v4c-physics-1-0",
    "sourceClip": "v4c-physics-1",
    "text": "Z-wind 求解风浪和缆绳共同作用下，",
    "startMs": 38160,
    "endMs": 41280
  },
  {
    "id": "v4c-physics-1-1",
    "sourceClip": "v4c-physics-1",
    "text": "平台的运动响应。",
    "startMs": 41300,
    "endMs": 42240
  },
  {
    "id": "v4c-physics-2-0",
    "sourceClip": "v4c-physics-2",
    "text": "这里回放保存的响应。",
    "startMs": 42539,
    "endMs": 43939
  },
  {
    "id": "v4c-physics-2-1",
    "sourceClip": "v4c-physics-2",
    "text": "平台的纵荡、纵摇，",
    "startMs": 44359,
    "endMs": 45919
  },
  {
    "id": "v4c-physics-2-2",
    "sourceClip": "v4c-physics-2",
    "text": "和系泊张力，",
    "startMs": 45919,
    "endMs": 47019
  },
  {
    "id": "v4c-physics-2-3",
    "sourceClip": "v4c-physics-2",
    "text": "沿着同一条时间线展开。",
    "startMs": 47019,
    "endMs": 49099
  },
  {
    "id": "v4c-interaction-0-0",
    "sourceClip": "v4c-interaction-0",
    "text": "如果网格出错，",
    "startMs": 52550,
    "endMs": 53570
  },
  {
    "id": "v4c-interaction-0-1",
    "sourceClip": "v4c-interaction-0",
    "text": "求解中断，系统读取日志，",
    "startMs": 53570,
    "endMs": 55950
  },
  {
    "id": "v4c-interaction-0-2",
    "sourceClip": "v4c-interaction-0",
    "text": "定位原因，再调整下一轮任务。",
    "startMs": 55950,
    "endMs": 58470
  },
  {
    "id": "v4c-interaction-1-0",
    "sourceClip": "v4c-interaction-1",
    "text": "每次尝试，都留下输入、结果和修改记录。",
    "startMs": 58776,
    "endMs": 62536
  },
  {
    "id": "v4c-toolchain-0-0",
    "sourceClip": "v4c-toolchain-0",
    "text": "这就是闭环：",
    "startMs": 65525,
    "endMs": 66725
  },
  {
    "id": "v4c-toolchain-0-1",
    "sourceClip": "v4c-toolchain-0",
    "text": "需求驱动工具，",
    "startMs": 67245,
    "endMs": 68305
  },
  {
    "id": "v4c-toolchain-0-2",
    "sourceClip": "v4c-toolchain-0",
    "text": "结果反过来推动决策。",
    "startMs": 68645,
    "endMs": 70105
  },
  {
    "id": "v4c-toolchain-1-0",
    "sourceClip": "v4c-toolchain-1",
    "text": "工程师可以改模型、看证据、复查方案。",
    "startMs": 70443,
    "endMs": 74323
  },
  {
    "id": "v4c-toolchain-1-1",
    "sourceClip": "v4c-toolchain-1",
    "text": "一次对话，连起整个工作流程。",
    "startMs": 74723,
    "endMs": 76843
  },
  {
    "id": "v4c-proof-0-0",
    "sourceClip": "v4c-proof-0",
    "text": "价值也要经得起复查。",
    "startMs": 78346,
    "endMs": 80326
  },
  {
    "id": "v4c-proof-0-1",
    "sourceClip": "v4c-proof-0",
    "text": "论文案例中，",
    "startMs": 80726,
    "endMs": 81806
  },
  {
    "id": "v4c-proof-0-2",
    "sourceClip": "v4c-proof-0",
    "text": "单位功率用钢量减少约百分之八点一。",
    "startMs": 82106,
    "endMs": 85086
  },
  {
    "id": "v4c-proof-1-0",
    "sourceClip": "v4c-proof-1",
    "text": "强度、运动和系泊缆绳逐项检查。",
    "startMs": 85341,
    "endMs": 88461
  },
  {
    "id": "v4c-proof-1-1",
    "sourceClip": "v4c-proof-1",
    "text": "模型、图纸、日志和报告，",
    "startMs": 88761,
    "endMs": 91021
  },
  {
    "id": "v4c-proof-1-2",
    "sourceClip": "v4c-proof-1",
    "text": "一起成为可追溯的交付。",
    "startMs": 91021,
    "endMs": 93181
  },
  {
    "id": "v4c-close-0-0",
    "sourceClip": "v4c-close-0",
    "text": "AI Engineer，",
    "startMs": 94550,
    "endMs": 95410
  },
  {
    "id": "v4c-close-0-1",
    "sourceClip": "v4c-close-0",
    "text": "让智能连接工具，",
    "startMs": 95410,
    "endMs": 96890
  },
  {
    "id": "v4c-close-0-2",
    "sourceClip": "v4c-close-0",
    "text": "让计算提供依据。",
    "startMs": 96890,
    "endMs": 98190
  },
  {
    "id": "v4c-close-1-0",
    "sourceClip": "v4c-close-1",
    "text": "从想法，到可复查的工程。",
    "startMs": 98468,
    "endMs": 100888
  }
]
