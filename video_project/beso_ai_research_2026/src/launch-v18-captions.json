[
  {
    "id": "v18-hero-0-0",
    "sourceClip": "v18-hero-0",
    "text": "工程设计里，",
    "startMs": 550,
    "endMs": 1790
  },
  {
    "id": "v18-hero-0-1",
    "sourceClip": "v18-hero-0",
    "text": "改一个要求，",
    "startMs": 1790,
    "endMs": 2790
  },
  {
    "id": "v18-hero-0-2",
    "sourceClip": "v18-hero-0",
    "text": "常常要重接一串软件。",
    "startMs": 2790,
    "endMs": 4710
  },
  {
    "id": "v18-hero-0-3",
    "sourceClip": "v18-hero-0",
    "text": "AI Engineer，",
    "startMs": 4910,
    "endMs": 5830
  },
  {
    "id": "v18-hero-0-4",
    "sourceClip": "v18-hero-0",
    "text": "把工程流程接起来。",
    "startMs": 6170,
    "endMs": 7490
  },
  {
    "id": "v18-brief-0-0",
    "sourceClip": "v18-brief-0",
    "text": "以二十兆瓦浮式风机为例：",
    "startMs": 12550,
    "endMs": 14950
  },
  {
    "id": "v18-brief-0-1",
    "sourceClip": "v18-brief-0",
    "text": "少用钢，还要适应更深的海。",
    "startMs": 15250,
    "endMs": 17370
  },
  {
    "id": "v18-brief-1-0",
    "sourceClip": "v18-brief-1",
    "text": "你改目标，它把功率、水深和用钢要求，",
    "startMs": 19260,
    "endMs": 23000
  },
  {
    "id": "v18-brief-1-1",
    "sourceClip": "v18-brief-1",
    "text": "写进同一份任务清单。",
    "startMs": 23000,
    "endMs": 24800
  },
  {
    "id": "v18-topology-0-0",
    "sourceClip": "v18-topology-0",
    "text": "从几何、网格到贝索优化，",
    "startMs": 27550,
    "endMs": 30450
  },
  {
    "id": "v18-topology-0-1",
    "sourceClip": "v18-topology-0",
    "text": "AI Engineer 调用工具，",
    "startMs": 30450,
    "endMs": 32750
  },
  {
    "id": "v18-topology-0-2",
    "sourceClip": "v18-topology-0",
    "text": "把上一步的结果交给下一步。",
    "startMs": 33130,
    "endMs": 34970
  },
  {
    "id": "v18-topology-1-0",
    "sourceClip": "v18-topology-1",
    "text": "模型、参数和文件，",
    "startMs": 36420,
    "endMs": 38720
  },
  {
    "id": "v18-topology-1-1",
    "sourceClip": "v18-topology-1",
    "text": "沿着一条任务链流动。",
    "startMs": 38720,
    "endMs": 40500
  },
  {
    "id": "v18-physics-0-0",
    "sourceClip": "v18-physics-0",
    "text": "平台会晃多大，",
    "startMs": 42550,
    "endMs": 44050
  },
  {
    "id": "v18-physics-0-1",
    "sourceClip": "v18-physics-0",
    "text": "系泊锚链拉得多紧，",
    "startMs": 44330,
    "endMs": 45910
  },
  {
    "id": "v18-physics-0-2",
    "sourceClip": "v18-physics-0",
    "text": "再交给 Zwind 检查。",
    "startMs": 45990,
    "endMs": 47610
  },
  {
    "id": "v18-physics-1-0",
    "sourceClip": "v18-physics-1",
    "text": "这里用保存的响应，",
    "startMs": 49180,
    "endMs": 50820
  },
  {
    "id": "v18-physics-1-1",
    "sourceClip": "v18-physics-1",
    "text": "展示计算如何回到设计判断。",
    "startMs": 51160,
    "endMs": 53480
  },
  {
    "id": "v18-interaction-0-0",
    "sourceClip": "v18-interaction-0",
    "text": "真正耗时间的，",
    "startMs": 57550,
    "endMs": 58830
  },
  {
    "id": "v18-interaction-0-1",
    "sourceClip": "v18-interaction-0",
    "text": "往往是计算卡住以后。",
    "startMs": 58830,
    "endMs": 60670
  },
  {
    "id": "v18-interaction-1-0",
    "sourceClip": "v18-interaction-1",
    "text": "它读取失败日志，",
    "startMs": 62660,
    "endMs": 64140
  },
  {
    "id": "v18-interaction-1-1",
    "sourceClip": "v18-interaction-1",
    "text": "调整下一轮计划；",
    "startMs": 64420,
    "endMs": 65620
  },
  {
    "id": "v18-interaction-1-2",
    "sourceClip": "v18-interaction-1",
    "text": "这次增加迭代次数，",
    "startMs": 65880,
    "endMs": 67320
  },
  {
    "id": "v18-interaction-1-3",
    "sourceClip": "v18-interaction-1",
    "text": "交给工程师复查。",
    "startMs": 67540,
    "endMs": 68760
  },
  {
    "id": "v18-toolchain-0-0",
    "sourceClip": "v18-toolchain-0",
    "text": "工程师随时能改几何；",
    "startMs": 72550,
    "endMs": 74590
  },
  {
    "id": "v18-toolchain-0-1",
    "sourceClip": "v18-toolchain-0",
    "text": "旧网格和载荷随之失效，",
    "startMs": 74590,
    "endMs": 76810
  },
  {
    "id": "v18-toolchain-0-2",
    "sourceClip": "v18-toolchain-0",
    "text": "后续步骤按新版本接续，",
    "startMs": 77110,
    "endMs": 78950
  },
  {
    "id": "v18-toolchain-0-3",
    "sourceClip": "v18-toolchain-0",
    "text": "避免拿旧输入算新方案。",
    "startMs": 79210,
    "endMs": 81010
  },
  {
    "id": "v18-proof-0-0",
    "sourceClip": "v18-proof-0",
    "text": "最后留下模型、输入和日志，",
    "startMs": 88550,
    "endMs": 91550
  },
  {
    "id": "v18-proof-0-1",
    "sourceClip": "v18-proof-0",
    "text": "每个结论都能找到来路，",
    "startMs": 91550,
    "endMs": 93450
  },
  {
    "id": "v18-proof-0-2",
    "sourceClip": "v18-proof-0",
    "text": "团队能复查，",
    "startMs": 93790,
    "endMs": 94850
  },
  {
    "id": "v18-proof-0-3",
    "sourceClip": "v18-proof-0",
    "text": "也能接着做。",
    "startMs": 94950,
    "endMs": 95770
  },
  {
    "id": "v18-close-0-0",
    "sourceClip": "v18-close-0",
    "text": "AI Engineer，",
    "startMs": 98550,
    "endMs": 99490
  },
  {
    "id": "v18-close-0-1",
    "sourceClip": "v18-close-0",
    "text": "让工具协同，",
    "startMs": 99490,
    "endMs": 100830
  },
  {
    "id": "v18-close-0-2",
    "sourceClip": "v18-close-0",
    "text": "让工程经验积累。",
    "startMs": 101050,
    "endMs": 102250
  }
]
