[
  {
    "id": "v20-hook-0-0",
    "sourceClip": "v20-hook-0",
    "text": "少用钢，还要扛住风浪。",
    "startMs": 250,
    "endMs": 2310
  },
  {
    "id": "v20-hook-0-1",
    "sourceClip": "v20-hook-0",
    "text": "这是 AI Engineer 要解决的工程问题。",
    "startMs": 2510,
    "endMs": 5170
  },
  {
    "id": "v20-value-0-0",
    "sourceClip": "v20-value-0",
    "text": "你提出目标和约束，",
    "startMs": 6100,
    "endMs": 7780
  },
  {
    "id": "v20-value-0-1",
    "sourceClip": "v20-value-0",
    "text": "它拆成任务，",
    "startMs": 8020,
    "endMs": 8960
  },
  {
    "id": "v20-value-0-2",
    "sourceClip": "v20-value-0",
    "text": "调度工具，自动推进设计。",
    "startMs": 9120,
    "endMs": 11280
  },
  {
    "id": "v20-tools-0-0",
    "sourceClip": "v20-tools-0",
    "text": "建几何、划网格、运行贝索优化，",
    "startMs": 12083,
    "endMs": 15383
  },
  {
    "id": "v20-tools-0-1",
    "sourceClip": "v20-tools-0",
    "text": "模型和参数沿同一条任务链传递。",
    "startMs": 15583,
    "endMs": 18183
  },
  {
    "id": "v20-sizing-0-0",
    "sourceClip": "v20-sizing-0",
    "text": "先找到材料该放在哪里，",
    "startMs": 18950,
    "endMs": 21130
  },
  {
    "id": "v20-sizing-0-1",
    "sourceClip": "v20-sizing-0",
    "text": "再优化构件尺寸，",
    "startMs": 21470,
    "endMs": 22710
  },
  {
    "id": "v20-sizing-0-2",
    "sourceClip": "v20-sizing-0",
    "text": "把强度、稳定和用钢量一起考虑。",
    "startMs": 22990,
    "endMs": 25950
  },
  {
    "id": "v20-recovery-0-0",
    "sourceClip": "v20-recovery-0",
    "text": "网格出错、计算不收敛，",
    "startMs": 26750,
    "endMs": 28910
  },
  {
    "id": "v20-recovery-0-1",
    "sourceClip": "v20-recovery-0",
    "text": "它读取诊断，",
    "startMs": 29170,
    "endMs": 30130
  },
  {
    "id": "v20-recovery-0-2",
    "sourceClip": "v20-recovery-0",
    "text": "自动调整参数，重新执行。",
    "startMs": 30250,
    "endMs": 32330
  },
  {
    "id": "v20-recheck-0-0",
    "sourceClip": "v20-recheck-0",
    "text": "改完还要再算、再查。",
    "startMs": 33533,
    "endMs": 35633
  },
  {
    "id": "v20-recheck-0-1",
    "sourceClip": "v20-recheck-0",
    "text": "通过检查才继续，",
    "startMs": 35953,
    "endMs": 37413
  },
  {
    "id": "v20-recheck-0-2",
    "sourceClip": "v20-recheck-0",
    "text": "原来的设计要求始终保留。",
    "startMs": 37673,
    "endMs": 39433
  },
  {
    "id": "v20-selection-0-0",
    "sourceClip": "v20-selection-0",
    "text": "多个候选版本保留下来，",
    "startMs": 40717,
    "endMs": 43117
  },
  {
    "id": "v20-selection-0-1",
    "sourceClip": "v20-selection-0",
    "text": "工程师比较结果，",
    "startMs": 43317,
    "endMs": 44577
  },
  {
    "id": "v20-selection-0-2",
    "sourceClip": "v20-selection-0",
    "text": "选择要推进的方案。",
    "startMs": 44837,
    "endMs": 46257
  },
  {
    "id": "v20-physics-0-0",
    "sourceClip": "v20-physics-0",
    "text": "选定方案，再交给 Zwind 做风浪耦合验证，",
    "startMs": 47767,
    "endMs": 51387
  },
  {
    "id": "v20-physics-0-1",
    "sourceClip": "v20-physics-0",
    "text": "检查运动和系泊响应。",
    "startMs": 51607,
    "endMs": 53107
  },
  {
    "id": "v20-comparison-0-0",
    "sourceClip": "v20-comparison-0",
    "text": "最新研究案例中，",
    "startMs": 53967,
    "endMs": 55587
  },
  {
    "id": "v20-comparison-0-1",
    "sourceClip": "v20-comparison-0",
    "text": "同为二十兆瓦，",
    "startMs": 55947,
    "endMs": 57067
  },
  {
    "id": "v20-comparison-0-2",
    "sourceClip": "v20-comparison-0",
    "text": "对比图强号参考基线，",
    "startMs": 57347,
    "endMs": 59287
  },
  {
    "id": "v20-comparison-0-3",
    "sourceClip": "v20-comparison-0",
    "text": "单位功率用钢量降低约百分之十点八。",
    "startMs": 59467,
    "endMs": 62507
  },
  {
    "id": "v20-steel-0-0",
    "sourceClip": "v20-steel-0",
    "text": "按同容量折算，",
    "startMs": 64400,
    "endMs": 65940
  },
  {
    "id": "v20-steel-0-1",
    "sourceClip": "v20-steel-0",
    "text": "基础少用约六百零二吨钢。",
    "startMs": 66200,
    "endMs": 68520
  },
  {
    "id": "v20-tradeoff-0-0",
    "sourceClip": "v20-tradeoff-0",
    "text": "极端工况下，",
    "startMs": 70433,
    "endMs": 71693
  },
  {
    "id": "v20-tradeoff-0-1",
    "sourceClip": "v20-tradeoff-0",
    "text": "系泊张力略降，",
    "startMs": 71933,
    "endMs": 72993
  },
  {
    "id": "v20-tradeoff-0-2",
    "sourceClip": "v20-tradeoff-0",
    "text": "纵摇增加，但仍在该案例的限值内。",
    "startMs": 73213,
    "endMs": 75873
  },
  {
    "id": "v20-workflow-0-0",
    "sourceClip": "v20-workflow-0",
    "text": "从自动纠错到方案筛选，",
    "startMs": 77417,
    "endMs": 79597
  },
  {
    "id": "v20-workflow-0-1",
    "sourceClip": "v20-workflow-0",
    "text": "工程师把精力放在取舍上，",
    "startMs": 79597,
    "endMs": 81817
  },
  {
    "id": "v20-workflow-0-2",
    "sourceClip": "v20-workflow-0",
    "text": "重复操作交给流程。",
    "startMs": 81817,
    "endMs": 83757
  },
  {
    "id": "v20-version-0-0",
    "sourceClip": "v20-version-0",
    "text": "选中的版本连同模型、输入和日志一起保留，",
    "startMs": 84367,
    "endMs": 88467
  },
  {
    "id": "v20-version-0-1",
    "sourceClip": "v20-version-0",
    "text": "图纸与报告随之生成。",
    "startMs": 88747,
    "endMs": 90487
  },
  {
    "id": "v20-certificate-0-0",
    "sourceClip": "v20-certificate-0",
    "text": "AI Engineer 智能设计软件，",
    "startMs": 91250,
    "endMs": 93890
  },
  {
    "id": "v20-certificate-0-1",
    "sourceClip": "v20-certificate-0",
    "text": "已获中国船级社原则性批准。",
    "startMs": 93890,
    "endMs": 96510
  },
  {
    "id": "v20-close-0-0",
    "sourceClip": "v20-close-0",
    "text": "AI Engineer，",
    "startMs": 97333,
    "endMs": 98353
  },
  {
    "id": "v20-close-0-1",
    "sourceClip": "v20-close-0",
    "text": "让设计自动向前，",
    "startMs": 98353,
    "endMs": 100293
  },
  {
    "id": "v20-close-0-2",
    "sourceClip": "v20-close-0",
    "text": "让设计过程，有据可查。",
    "startMs": 100533,
    "endMs": 102313
  }
]
