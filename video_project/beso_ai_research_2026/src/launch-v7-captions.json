[
  {
    "id": "v7-hero-0-0",
    "sourceClip": "v7-hero-0",
    "text": "改一个尺寸，",
    "startMs": 353,
    "endMs": 1353
  },
  {
    "id": "v7-hero-0-1",
    "sourceClip": "v7-hero-0",
    "text": "几何、网格、强度、风浪响应，",
    "startMs": 1573,
    "endMs": 4333
  },
  {
    "id": "v7-hero-0-2",
    "sourceClip": "v7-hero-0",
    "text": "又要跟着重做。",
    "startMs": 4333,
    "endMs": 5533
  },
  {
    "id": "v7-hero-1-0",
    "sourceClip": "v7-hero-1",
    "text": "海上风机设计，",
    "startMs": 6053,
    "endMs": 7493
  },
  {
    "id": "v7-hero-1-1",
    "sourceClip": "v7-hero-1",
    "text": "时间常常花在这些反复操作里。",
    "startMs": 7653,
    "endMs": 9993
  },
  {
    "id": "v7-brief-0-0",
    "sourceClip": "v7-brief-0",
    "text": "AI Engineer，",
    "startMs": 11550,
    "endMs": 12510
  },
  {
    "id": "v7-brief-0-1",
    "sourceClip": "v7-brief-0",
    "text": "让需求变成可执行的工程任务。",
    "startMs": 12510,
    "endMs": 15170
  },
  {
    "id": "v7-brief-1-0",
    "sourceClip": "v7-brief-1",
    "text": "输入功率、目标用钢量和约束，",
    "startMs": 15650,
    "endMs": 18650
  },
  {
    "id": "v7-brief-1-1",
    "sourceClip": "v7-brief-1",
    "text": "系统把它们写进同一份设计清单。",
    "startMs": 18910,
    "endMs": 21250
  },
  {
    "id": "v7-topology-0-0",
    "sourceClip": "v7-topology-0",
    "text": "从这份清单，",
    "startMs": 23487,
    "endMs": 24787
  },
  {
    "id": "v7-topology-0-1",
    "sourceClip": "v7-topology-0",
    "text": "建立模型、划分网格，",
    "startMs": 25067,
    "endMs": 26727
  },
  {
    "id": "v7-topology-0-2",
    "sourceClip": "v7-topology-0",
    "text": "再做拓扑优化。",
    "startMs": 26727,
    "endMs": 28527
  },
  {
    "id": "v7-topology-1-0",
    "sourceClip": "v7-topology-1",
    "text": "计算决定材料留在哪里，",
    "startMs": 29347,
    "endMs": 31367
  },
  {
    "id": "v7-topology-1-1",
    "sourceClip": "v7-topology-1",
    "text": "尺寸优化再调整构件。",
    "startMs": 31527,
    "endMs": 33227
  },
  {
    "id": "v7-topology-1-2",
    "sourceClip": "v7-topology-1",
    "text": "数据沿着任务传递，",
    "startMs": 33627,
    "endMs": 35207
  },
  {
    "id": "v7-topology-1-3",
    "sourceClip": "v7-topology-1",
    "text": "省下反复导出、转格式和重新配置。",
    "startMs": 35407,
    "endMs": 38567
  },
  {
    "id": "v7-physics-0-0",
    "sourceClip": "v7-physics-0",
    "text": "减了钢，还要稳。",
    "startMs": 40550,
    "endMs": 42050
  },
  {
    "id": "v7-physics-0-1",
    "sourceClip": "v7-physics-0",
    "text": "Z-wind 检查风浪下的平台运动，",
    "startMs": 42050,
    "endMs": 45250
  },
  {
    "id": "v7-physics-0-2",
    "sourceClip": "v7-physics-0",
    "text": "和系泊缆绳的张力。",
    "startMs": 45250,
    "endMs": 46830
  },
  {
    "id": "v7-physics-1-0",
    "sourceClip": "v7-physics-1",
    "text": "把响应放回设计约束里，",
    "startMs": 47530,
    "endMs": 49450
  },
  {
    "id": "v7-physics-1-1",
    "sourceClip": "v7-physics-1",
    "text": "再决定方案能不能继续。",
    "startMs": 49650,
    "endMs": 51150
  },
  {
    "id": "v7-interaction-0-0",
    "sourceClip": "v7-interaction-0",
    "text": "算不下去，系统读取日志，",
    "startMs": 53527,
    "endMs": 55927
  },
  {
    "id": "v7-interaction-0-1",
    "sourceClip": "v7-interaction-0",
    "text": "把原因带回任务规划。",
    "startMs": 56127,
    "endMs": 57747
  },
  {
    "id": "v7-interaction-1-0",
    "sourceClip": "v7-interaction-1",
    "text": "调整参数，再安排下一轮。",
    "startMs": 58107,
    "endMs": 60367
  },
  {
    "id": "v7-interaction-1-1",
    "sourceClip": "v7-interaction-1",
    "text": "改了什么、得到什么，",
    "startMs": 60687,
    "endMs": 62047
  },
  {
    "id": "v7-interaction-1-2",
    "sourceClip": "v7-interaction-1",
    "text": "都能回头查。",
    "startMs": 62047,
    "endMs": 63207
  },
  {
    "id": "v7-toolchain-0-0",
    "sourceClip": "v7-toolchain-0",
    "text": "你也可以在网格生成前暂停，",
    "startMs": 65550,
    "endMs": 67730
  },
  {
    "id": "v7-toolchain-0-1",
    "sourceClip": "v7-toolchain-0",
    "text": "亲手修改模型，",
    "startMs": 68050,
    "endMs": 69150
  },
  {
    "id": "v7-toolchain-0-2",
    "sourceClip": "v7-toolchain-0",
    "text": "再提交回当前任务。",
    "startMs": 69410,
    "endMs": 70790
  },
  {
    "id": "v7-toolchain-1-0",
    "sourceClip": "v7-toolchain-1",
    "text": "过期的网格和载荷会被清掉，",
    "startMs": 71090,
    "endMs": 73450
  },
  {
    "id": "v7-toolchain-1-1",
    "sourceClip": "v7-toolchain-1",
    "text": "按新几何继续。",
    "startMs": 73610,
    "endMs": 74910
  },
  {
    "id": "v7-toolchain-1-2",
    "sourceClip": "v7-toolchain-1",
    "text": "关键决定，工程师能介入。",
    "startMs": 74910,
    "endMs": 77330
  },
  {
    "id": "v7-proof-0-0",
    "sourceClip": "v7-proof-0",
    "text": "论文案例里，",
    "startMs": 79473,
    "endMs": 80753
  },
  {
    "id": "v7-proof-0-1",
    "sourceClip": "v7-proof-0",
    "text": "单位功率用钢量减少约百分之八点一。",
    "startMs": 80933,
    "endMs": 83713
  },
  {
    "id": "v7-proof-1-0",
    "sourceClip": "v7-proof-1",
    "text": "省下多少钢，",
    "startMs": 84373,
    "endMs": 85573
  },
  {
    "id": "v7-proof-1-1",
    "sourceClip": "v7-proof-1",
    "text": "也要看强度和运动响应。",
    "startMs": 85893,
    "endMs": 87553
  },
  {
    "id": "v7-proof-1-2",
    "sourceClip": "v7-proof-1",
    "text": "模型、计算输入、日志和报告，",
    "startMs": 87873,
    "endMs": 90573
  },
  {
    "id": "v7-proof-1-3",
    "sourceClip": "v7-proof-1",
    "text": "随方案一起交付，",
    "startMs": 90873,
    "endMs": 91993
  },
  {
    "id": "v7-proof-1-4",
    "sourceClip": "v7-proof-1",
    "text": "打开就能复查。",
    "startMs": 92193,
    "endMs": 93373
  },
  {
    "id": "v7-close-0-0",
    "sourceClip": "v7-close-0",
    "text": "把重复操作交给工具，",
    "startMs": 95340,
    "endMs": 97280
  },
  {
    "id": "v7-close-0-1",
    "sourceClip": "v7-close-0",
    "text": "把判断留给工程师。",
    "startMs": 97540,
    "endMs": 98980
  },
  {
    "id": "v7-close-1-0",
    "sourceClip": "v7-close-1",
    "text": "AI Engineer。",
    "startMs": 99360,
    "endMs": 100520
  },
  {
    "id": "v7-close-1-1",
    "sourceClip": "v7-close-1",
    "text": "带着你的设计目标，",
    "startMs": 100980,
    "endMs": 102020
  },
  {
    "id": "v7-close-1-2",
    "sourceClip": "v7-close-1",
    "text": "让工程任务真正跑起来。",
    "startMs": 102020,
    "endMs": 103760
  }
]
