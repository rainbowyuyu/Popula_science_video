[
  {
    "id": "v17-hero-0-0",
    "sourceClip": "v17-hero-0",
    "text": "AI Engineer，",
    "startMs": 550,
    "endMs": 1710
  },
  {
    "id": "v17-hero-0-1",
    "sourceClip": "v17-hero-0",
    "text": "把分散的工程软件，",
    "startMs": 1990,
    "endMs": 3190
  },
  {
    "id": "v17-hero-0-2",
    "sourceClip": "v17-hero-0",
    "text": "接成一个会接力的工作流。",
    "startMs": 3190,
    "endMs": 5110
  },
  {
    "id": "v17-hero-0-3",
    "sourceClip": "v17-hero-0",
    "text": "需求变了，建模、计算和复查，",
    "startMs": 5430,
    "endMs": 8250
  },
  {
    "id": "v17-hero-0-4",
    "sourceClip": "v17-hero-0",
    "text": "跟着同一份任务走。",
    "startMs": 8530,
    "endMs": 9690
  },
  {
    "id": "v17-brief-0-0",
    "sourceClip": "v17-brief-0",
    "text": "比如，一台二十兆瓦的浮式风机，",
    "startMs": 12550,
    "endMs": 15190
  },
  {
    "id": "v17-brief-0-1",
    "sourceClip": "v17-brief-0",
    "text": "想减轻浮体，",
    "startMs": 15470,
    "endMs": 16510
  },
  {
    "id": "v17-brief-0-2",
    "sourceClip": "v17-brief-0",
    "text": "还得适应新的水深。",
    "startMs": 16670,
    "endMs": 17970
  },
  {
    "id": "v17-brief-1-0",
    "sourceClip": "v17-brief-1",
    "text": "改一次要求，",
    "startMs": 19900,
    "endMs": 21040
  },
  {
    "id": "v17-brief-1-1",
    "sourceClip": "v17-brief-1",
    "text": "功率、用钢目标和水深，",
    "startMs": 21280,
    "endMs": 23420
  },
  {
    "id": "v17-brief-1-2",
    "sourceClip": "v17-brief-1",
    "text": "就写回同一份设计清单。",
    "startMs": 23420,
    "endMs": 25280
  },
  {
    "id": "v17-topology-0-0",
    "sourceClip": "v17-topology-0",
    "text": "清单交给几何工具，",
    "startMs": 27550,
    "endMs": 29330
  },
  {
    "id": "v17-topology-0-1",
    "sourceClip": "v17-topology-0",
    "text": "生成网格，再调用贝索，",
    "startMs": 29590,
    "endMs": 31650
  },
  {
    "id": "v17-topology-0-2",
    "sourceClip": "v17-topology-0",
    "text": "寻找材料该留在哪里。",
    "startMs": 31830,
    "endMs": 33330
  },
  {
    "id": "v17-topology-1-0",
    "sourceClip": "v17-topology-1",
    "text": "前一步的输出，",
    "startMs": 34900,
    "endMs": 36140
  },
  {
    "id": "v17-topology-1-1",
    "sourceClip": "v17-topology-1",
    "text": "就是下一步的输入，",
    "startMs": 36140,
    "endMs": 37640
  },
  {
    "id": "v17-topology-1-2",
    "sourceClip": "v17-topology-1",
    "text": "文件和参数不用来回搬。",
    "startMs": 37940,
    "endMs": 39580
  },
  {
    "id": "v17-physics-0-0",
    "sourceClip": "v17-physics-0",
    "text": "材料减少了，",
    "startMs": 42550,
    "endMs": 43830
  },
  {
    "id": "v17-physics-0-1",
    "sourceClip": "v17-physics-0",
    "text": "平台会晃多大，",
    "startMs": 44110,
    "endMs": 45170
  },
  {
    "id": "v17-physics-0-2",
    "sourceClip": "v17-physics-0",
    "text": "系泊缆绳拉得有多紧，",
    "startMs": 45630,
    "endMs": 47310
  },
  {
    "id": "v17-physics-0-3",
    "sourceClip": "v17-physics-0",
    "text": "也要检查。",
    "startMs": 47370,
    "endMs": 48070
  },
  {
    "id": "v17-physics-0-4",
    "sourceClip": "v17-physics-0",
    "text": "这里回放 Zwind 的一组保存响应。",
    "startMs": 48490,
    "endMs": 51170
  },
  {
    "id": "v17-physics-1-0",
    "sourceClip": "v17-physics-1",
    "text": "计算响应回到设计约束，",
    "startMs": 52000,
    "endMs": 54200
  },
  {
    "id": "v17-physics-1-1",
    "sourceClip": "v17-physics-1",
    "text": "给下一轮修改提供依据。",
    "startMs": 54400,
    "endMs": 56160
  },
  {
    "id": "v17-interaction-0-0",
    "sourceClip": "v17-interaction-0",
    "text": "求解没有收敛，",
    "startMs": 57550,
    "endMs": 59090
  },
  {
    "id": "v17-interaction-0-1",
    "sourceClip": "v17-interaction-0",
    "text": "就沿着日志找原因，",
    "startMs": 59190,
    "endMs": 60690
  },
  {
    "id": "v17-interaction-0-2",
    "sourceClip": "v17-interaction-0",
    "text": "调整迭代上限，",
    "startMs": 61050,
    "endMs": 62250
  },
  {
    "id": "v17-interaction-0-3",
    "sourceClip": "v17-interaction-0",
    "text": "安排下一轮。",
    "startMs": 62370,
    "endMs": 63370
  },
  {
    "id": "v17-interaction-1-0",
    "sourceClip": "v17-interaction-1",
    "text": "哪里失败、为什么修改，",
    "startMs": 64900,
    "endMs": 66900
  },
  {
    "id": "v17-interaction-1-1",
    "sourceClip": "v17-interaction-1",
    "text": "都跟着任务留下来，",
    "startMs": 66900,
    "endMs": 68480
  },
  {
    "id": "v17-interaction-1-2",
    "sourceClip": "v17-interaction-1",
    "text": "方便工程师复查。",
    "startMs": 68660,
    "endMs": 70020
  },
  {
    "id": "v17-toolchain-0-0",
    "sourceClip": "v17-toolchain-0",
    "text": "你也可以在生成网格前停下来，",
    "startMs": 72550,
    "endMs": 74750
  },
  {
    "id": "v17-toolchain-0-1",
    "sourceClip": "v17-toolchain-0",
    "text": "亲手修改梁的截面。",
    "startMs": 75030,
    "endMs": 76390
  },
  {
    "id": "v17-toolchain-0-2",
    "sourceClip": "v17-toolchain-0",
    "text": "提交新几何后，",
    "startMs": 76730,
    "endMs": 77870
  },
  {
    "id": "v17-toolchain-0-3",
    "sourceClip": "v17-toolchain-0",
    "text": "旧网格和旧载荷失效，",
    "startMs": 78090,
    "endMs": 79750
  },
  {
    "id": "v17-toolchain-0-4",
    "sourceClip": "v17-toolchain-0",
    "text": "后续按新模型重新生成。",
    "startMs": 80130,
    "endMs": 82070
  },
  {
    "id": "v17-proof-0-0",
    "sourceClip": "v17-proof-0",
    "text": "最后，",
    "startMs": 88550,
    "endMs": 89270
  },
  {
    "id": "v17-proof-0-1",
    "sourceClip": "v17-proof-0",
    "text": "模型、计算输入、日志和报告一起交付。",
    "startMs": 89470,
    "endMs": 93090
  },
  {
    "id": "v17-proof-0-2",
    "sourceClip": "v17-proof-0",
    "text": "每个结果，都能找到来路。",
    "startMs": 93590,
    "endMs": 95350
  },
  {
    "id": "v17-close-0-0",
    "sourceClip": "v17-close-0",
    "text": "AI Engineer。",
    "startMs": 98550,
    "endMs": 99610
  },
  {
    "id": "v17-close-0-1",
    "sourceClip": "v17-close-0",
    "text": "少忙着接软件，",
    "startMs": 100090,
    "endMs": 101270
  },
  {
    "id": "v17-close-0-2",
    "sourceClip": "v17-close-0",
    "text": "多花时间做设计。",
    "startMs": 101550,
    "endMs": 102750
  }
]
