[
  {
    "id": "v5-hero-0-0",
    "sourceClip": "v5-hero-0",
    "text": "二十兆瓦海上风机。",
    "startMs": 550,
    "endMs": 2510
  },
  {
    "id": "v5-hero-0-1",
    "sourceClip": "v5-hero-0",
    "text": "让工程需求，",
    "startMs": 2630,
    "endMs": 3710
  },
  {
    "id": "v5-hero-0-2",
    "sourceClip": "v5-hero-0",
    "text": "接上真实计算。",
    "startMs": 3710,
    "endMs": 5070
  },
  {
    "id": "v5-brief-0-0",
    "sourceClip": "v5-brief-0",
    "text": "AI Engineer，",
    "startMs": 8007,
    "endMs": 8747
  },
  {
    "id": "v5-brief-0-1",
    "sourceClip": "v5-brief-0",
    "text": "把这条路接起来。",
    "startMs": 9207,
    "endMs": 10247
  },
  {
    "id": "v5-brief-1-0",
    "sourceClip": "v5-brief-1",
    "text": "目标、海况、材料和约束，",
    "startMs": 10587,
    "endMs": 13407
  },
  {
    "id": "v5-brief-1-1",
    "sourceClip": "v5-brief-1",
    "text": "变成参数与任务。",
    "startMs": 13407,
    "endMs": 15167
  },
  {
    "id": "v5-brief-1-2",
    "sourceClip": "v5-brief-1",
    "text": "系统安排工具，",
    "startMs": 15467,
    "endMs": 16427
  },
  {
    "id": "v5-brief-1-3",
    "sourceClip": "v5-brief-1",
    "text": "让每一步接得上。",
    "startMs": 16427,
    "endMs": 17947
  },
  {
    "id": "v5-topology-0-0",
    "sourceClip": "v5-topology-0",
    "text": "先建立几何，",
    "startMs": 19407,
    "endMs": 20633
  },
  {
    "id": "v5-topology-0-1",
    "sourceClip": "v5-topology-0",
    "text": "划分网格，再让贝索沿着受力路径调整材料。",
    "startMs": 20633,
    "endMs": 24467
  },
  {
    "id": "v5-topology-1-0",
    "sourceClip": "v5-topology-1",
    "text": "哪里保留，哪里移除，",
    "startMs": 25187,
    "endMs": 27227
  },
  {
    "id": "v5-topology-1-1",
    "sourceClip": "v5-topology-1",
    "text": "构件多粗多厚，",
    "startMs": 27547,
    "endMs": 28827
  },
  {
    "id": "v5-topology-1-2",
    "sourceClip": "v5-topology-1",
    "text": "都交给计算。",
    "startMs": 28827,
    "endMs": 30007
  },
  {
    "id": "v5-topology-1-3",
    "sourceClip": "v5-topology-1",
    "text": "系统把前一步的结果，",
    "startMs": 30307,
    "endMs": 31507
  },
  {
    "id": "v5-topology-1-4",
    "sourceClip": "v5-topology-1",
    "text": "送到下一步。",
    "startMs": 31507,
    "endMs": 32627
  },
  {
    "id": "v5-physics-0-0",
    "sourceClip": "v5-physics-0",
    "text": "有了结构，还要看它在风浪里怎样运动。",
    "startMs": 34387,
    "endMs": 37687
  },
  {
    "id": "v5-physics-1-0",
    "sourceClip": "v5-physics-1",
    "text": "Z-wind 求解风浪和缆绳共同作用下，",
    "startMs": 38487,
    "endMs": 42347
  },
  {
    "id": "v5-physics-1-1",
    "sourceClip": "v5-physics-1",
    "text": "平台的运动响应。",
    "startMs": 42527,
    "endMs": 43727
  },
  {
    "id": "v5-physics-2-0",
    "sourceClip": "v5-physics-2",
    "text": "这里回放保存的响应。",
    "startMs": 44107,
    "endMs": 45847
  },
  {
    "id": "v5-physics-2-1",
    "sourceClip": "v5-physics-2",
    "text": "平台的纵荡、纵摇，",
    "startMs": 46147,
    "endMs": 47727
  },
  {
    "id": "v5-physics-2-2",
    "sourceClip": "v5-physics-2",
    "text": "和系泊张力，",
    "startMs": 47727,
    "endMs": 48847
  },
  {
    "id": "v5-physics-2-3",
    "sourceClip": "v5-physics-2",
    "text": "沿着同一条时间线展开。",
    "startMs": 48847,
    "endMs": 50807
  },
  {
    "id": "v5-interaction-0-0",
    "sourceClip": "v5-interaction-0",
    "text": "如果网格出错，",
    "startMs": 52550,
    "endMs": 53850
  },
  {
    "id": "v5-interaction-0-1",
    "sourceClip": "v5-interaction-0",
    "text": "求解中断，系统读取日志，",
    "startMs": 54110,
    "endMs": 56410
  },
  {
    "id": "v5-interaction-0-2",
    "sourceClip": "v5-interaction-0",
    "text": "定位原因，再调整下一轮任务。",
    "startMs": 56670,
    "endMs": 58970
  },
  {
    "id": "v5-interaction-1-0",
    "sourceClip": "v5-interaction-1",
    "text": "每次尝试，都留下输入、结果和修改记录。",
    "startMs": 59610,
    "endMs": 63550
  },
  {
    "id": "v5-toolchain-0-0",
    "sourceClip": "v5-toolchain-0",
    "text": "这就是闭环：",
    "startMs": 65487,
    "endMs": 66627
  },
  {
    "id": "v5-toolchain-0-1",
    "sourceClip": "v5-toolchain-0",
    "text": "需求驱动工具，",
    "startMs": 66987,
    "endMs": 68107
  },
  {
    "id": "v5-toolchain-0-2",
    "sourceClip": "v5-toolchain-0",
    "text": "结果反过来推动决策。",
    "startMs": 68427,
    "endMs": 69867
  },
  {
    "id": "v5-toolchain-1-0",
    "sourceClip": "v5-toolchain-1",
    "text": "工程师可以改模型、看证据、复查方案。",
    "startMs": 70227,
    "endMs": 73827
  },
  {
    "id": "v5-toolchain-1-1",
    "sourceClip": "v5-toolchain-1",
    "text": "一次对话，连起整个工作流程。",
    "startMs": 74127,
    "endMs": 76427
  },
  {
    "id": "v5-proof-0-0",
    "sourceClip": "v5-proof-0",
    "text": "价值也要经得起复查。",
    "startMs": 78287,
    "endMs": 80067
  },
  {
    "id": "v5-proof-0-1",
    "sourceClip": "v5-proof-0",
    "text": "论文案例中，",
    "startMs": 80327,
    "endMs": 81207
  },
  {
    "id": "v5-proof-0-2",
    "sourceClip": "v5-proof-0",
    "text": "单位功率用钢量减少约百分之八点一。",
    "startMs": 81427,
    "endMs": 84267
  },
  {
    "id": "v5-proof-1-0",
    "sourceClip": "v5-proof-1",
    "text": "强度、运动和系泊缆绳逐项检查。",
    "startMs": 84627,
    "endMs": 88167
  },
  {
    "id": "v5-proof-1-1",
    "sourceClip": "v5-proof-1",
    "text": "模型、图纸、日志和报告，",
    "startMs": 88567,
    "endMs": 91027
  },
  {
    "id": "v5-proof-1-2",
    "sourceClip": "v5-proof-1",
    "text": "一起成为可追溯的交付。",
    "startMs": 91027,
    "endMs": 92927
  },
  {
    "id": "v5-close-0-0",
    "sourceClip": "v5-close-0",
    "text": "AI Engineer，",
    "startMs": 94550,
    "endMs": 95690
  },
  {
    "id": "v5-close-0-1",
    "sourceClip": "v5-close-0",
    "text": "让智能连接工具，",
    "startMs": 96150,
    "endMs": 97290
  },
  {
    "id": "v5-close-0-2",
    "sourceClip": "v5-close-0",
    "text": "让计算提供依据。",
    "startMs": 97630,
    "endMs": 98950
  },
  {
    "id": "v5-close-1-0",
    "sourceClip": "v5-close-1",
    "text": "从想法，到可复查的工程。",
    "startMs": 99690,
    "endMs": 102270
  }
]
