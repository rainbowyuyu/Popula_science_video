[
  {
    "id": "compact-hook-0-c0",
    "text": "把一座二十兆瓦的风机放到深海里，",
    "startMs": 300,
    "endMs": 3190,
    "sourceCaption": "hook-0-c0"
  },
  {
    "id": "compact-hook-0-c1",
    "text": "最难的，往往是水面下面的基础。",
    "startMs": 3440,
    "endMs": 6190,
    "sourceCaption": "hook-0-c1"
  },
  {
    "id": "compact-hook-3-c0",
    "text": "浙江大学团队研究的 AI Engineer，",
    "startMs": 6900,
    "endMs": 10720,
    "sourceCaption": "hook-3-c0"
  },
  {
    "id": "compact-hook-3-c1",
    "text": "就是要让这几道难题，",
    "startMs": 10720,
    "endMs": 12660,
    "sourceCaption": "hook-3-c1"
  },
  {
    "id": "compact-hook-3-c2",
    "text": "在同一条设计流程里反复求解。",
    "startMs": 12660,
    "endMs": 15410,
    "sourceCaption": "hook-3-c2"
  },
  {
    "id": "compact-brief-0-c0",
    "text": "起点是这样一项需求：",
    "startMs": 16633,
    "endMs": 18403,
    "sourceCaption": "brief-0-c0"
  },
  {
    "id": "compact-brief-0-c1",
    "text": "设计一座二十兆瓦的浮式风电基础。",
    "startMs": 18793,
    "endMs": 21403,
    "sourceCaption": "brief-0-c1"
  },
  {
    "id": "compact-brief-2-c0",
    "text": "语言模型安排下一步调用哪个工具，",
    "startMs": 22283,
    "endMs": 25193,
    "sourceCaption": "brief-2-c0"
  },
  {
    "id": "compact-brief-2-c1",
    "text": "求解器负责算出受力和响应。",
    "startMs": 25503,
    "endMs": 27633,
    "sourceCaption": "brief-2-c1"
  },
  {
    "id": "compact-mesh-0-c0",
    "text": "先在三维空间里圈出材料可以出现的范围，",
    "startMs": 29133,
    "endMs": 32483,
    "sourceCaption": "mesh-0-c0"
  },
  {
    "id": "compact-mesh-0-c1",
    "text": "这就是设计域。",
    "startMs": 32853,
    "endMs": 33663,
    "sourceCaption": "mesh-0-c1"
  },
  {
    "id": "compact-mesh-2-c0",
    "text": "看这组保存的静力算例：",
    "startMs": 34067,
    "endMs": 36237,
    "sourceCaption": "mesh-2-c0"
  },
  {
    "id": "compact-mesh-2-c1",
    "text": "塔底合力向下作用，",
    "startMs": 36547,
    "endMs": 38117,
    "sourceCaption": "mesh-2-c1"
  },
  {
    "id": "compact-mesh-2-c2",
    "text": "弯矩同时让两侧承受不同的拉压。",
    "startMs": 38407,
    "endMs": 40877,
    "sourceCaption": "mesh-2-c2"
  },
  {
    "id": "compact-beso-0-c0",
    "text": "接下来，BESO 开始调整材料分布。",
    "startMs": 42467,
    "endMs": 45337,
    "sourceCaption": "beso-0-c0"
  },
  {
    "id": "compact-beso-0-c1",
    "text": "我们把同一张网格上的迭代记录逐步展开。",
    "startMs": 45707,
    "endMs": 48457,
    "sourceCaption": "beso-0-c1"
  },
  {
    "id": "compact-beso-4-c0",
    "text": "这组研究算例留下四十四个状态，",
    "startMs": 48833,
    "endMs": 51783,
    "sourceCaption": "beso-4-c0"
  },
  {
    "id": "compact-beso-4-c1",
    "text": "最终保留的质量，",
    "startMs": 51953,
    "endMs": 53053,
    "sourceCaption": "beso-4-c1"
  },
  {
    "id": "compact-beso-4-c2",
    "text": "大约是初始的百分之二十五。",
    "startMs": 53053,
    "endMs": 54763,
    "sourceCaption": "beso-4-c2"
  },
  {
    "id": "compact-rebuild-0-c0",
    "text": "不过，一块块单元拼出的骨架，",
    "startMs": 56633,
    "endMs": 59063,
    "sourceCaption": "rebuild-0-c0"
  },
  {
    "id": "compact-rebuild-0-c1",
    "text": "还需要变成能下料、能焊接的构件。",
    "startMs": 59333,
    "endMs": 61743,
    "sourceCaption": "rebuild-0-c1"
  },
  {
    "id": "compact-rebuild-3-c0",
    "text": "拓扑优化决定材料放在哪里，",
    "startMs": 62517,
    "endMs": 64987,
    "sourceCaption": "rebuild-3-c0"
  },
  {
    "id": "compact-rebuild-3-c1",
    "text": "尺寸优化继续回答，",
    "startMs": 65297,
    "endMs": 66807,
    "sourceCaption": "rebuild-3-c1"
  },
  {
    "id": "compact-rebuild-3-c2",
    "text": "每一根构件需要多粗、多厚。",
    "startMs": 67237,
    "endMs": 69287,
    "sourceCaption": "rebuild-3-c2"
  },
  {
    "id": "compact-zwind-0-c0",
    "text": "静力算得过，",
    "startMs": 70967,
    "endMs": 72057,
    "sourceCaption": "zwind-0-c0"
  },
  {
    "id": "compact-zwind-0-c1",
    "text": "还要把候选结构放进随时间变化的风和浪里。",
    "startMs": 72287,
    "endMs": 75257,
    "sourceCaption": "zwind-0-c1"
  },
  {
    "id": "compact-zwind-0-c2",
    "text": "这里用到 Zwind。",
    "startMs": 75567,
    "endMs": 76497,
    "sourceCaption": "zwind-0-c2"
  },
  {
    "id": "compact-zwind-3-c0",
    "text": "同时还要检查固有频率，",
    "startMs": 77333,
    "endMs": 79323,
    "sourceCaption": "zwind-3-c0"
  },
  {
    "id": "compact-zwind-3-c1",
    "text": "避免它落进叶片旋转带来的激励频带。",
    "startMs": 79633,
    "endMs": 82203,
    "sourceCaption": "zwind-3-c1"
  },
  {
    "id": "compact-compare-1-c0",
    "text": "单位功率用钢量，",
    "startMs": 83800,
    "endMs": 85420,
    "sourceCaption": "compare-1-c0"
  },
  {
    "id": "compact-compare-1-c1",
    "text": "从每兆瓦二百七十八吨，",
    "startMs": 85420,
    "endMs": 87540,
    "sourceCaption": "compare-1-c1"
  },
  {
    "id": "compact-compare-1-c2",
    "text": "降到二百五十五点五吨，",
    "startMs": 87540,
    "endMs": 89810,
    "sourceCaption": "compare-1-c2"
  },
  {
    "id": "compact-compare-1-c3",
    "text": "减少约百分之八点一。",
    "startMs": 89820,
    "endMs": 91450,
    "sourceCaption": "compare-1-c3"
  },
  {
    "id": "compact-compare-3-c0",
    "text": "这些变化提醒我们，",
    "startMs": 92250,
    "endMs": 93760,
    "sourceCaption": "compare-3-c0"
  },
  {
    "id": "compact-compare-3-c1",
    "text": "轻量化会改变系统的动力特性。",
    "startMs": 94110,
    "endMs": 96290,
    "sourceCaption": "compare-3-c1"
  },
  {
    "id": "compact-compare-3-c2",
    "text": "设计需要在多种响应之间寻找平衡。",
    "startMs": 96290,
    "endMs": 99440,
    "sourceCaption": "compare-3-c2"
  },
  {
    "id": "compact-close-1-c0",
    "text": "人工智能负责衔接工具、读懂反馈，",
    "startMs": 100800,
    "endMs": 103710,
    "sourceCaption": "close-1-c0"
  },
  {
    "id": "compact-close-1-c1",
    "text": "工程计算给出检验，",
    "startMs": 104060,
    "endMs": 105450,
    "sourceCaption": "close-1-c1"
  },
  {
    "id": "compact-close-1-c2",
    "text": "工程师再把关现实中的条件。",
    "startMs": 105680,
    "endMs": 107670,
    "sourceCaption": "close-1-c2"
  },
  {
    "id": "compact-close-2-c0",
    "text": "从一句需求，",
    "startMs": 108450,
    "endMs": 109710,
    "sourceCaption": "close-2-c0"
  },
  {
    "id": "compact-close-2-c1",
    "text": "到模型、图纸和报告，",
    "startMs": 109710,
    "endMs": 111960,
    "sourceCaption": "close-2-c1"
  },
  {
    "id": "compact-close-2-c2",
    "text": "每一步都带着证据，",
    "startMs": 112270,
    "endMs": 113580,
    "sourceCaption": "close-2-c2"
  },
  {
    "id": "compact-close-2-c3",
    "text": "下一步才有可靠的起点。",
    "startMs": 113750,
    "endMs": 115500,
    "sourceCaption": "close-2-c3"
  }
]
