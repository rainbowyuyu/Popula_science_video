      "startFrame": 6480,
      "endFrame": 6530,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0080",
      "cueId": "n28",
      "shotId": "s07-model-assist",
      "text": "它先把 DNA 看成一串 token，",
