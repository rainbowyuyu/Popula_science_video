      "endSec": 220.333363,
      "startFrame": 6530,
      "endFrame": 6610,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0081",
      "cueId": "n28",
      "shotId": "s07-model-assist",
      "text": "而不是一句自然语言。",
