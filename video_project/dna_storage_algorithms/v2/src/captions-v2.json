      "startFrame": 6315,
      "endFrame": 6385,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0079",
      "cueId": "n28",
      "shotId": "s07-model-assist",
      "text": "那大模型能帮哪一步？",
      "startSec": 216.0,
