  "sourceManifestSha256": "25b7dae631ad9d5353748c5dca566050292d4d69a6959df10c0e2aa0dfa86687",
  "captions": [
    {
      "id": "c0001",
      "cueId": "n01",
      "shotId": "s01-hook",
      "text": "一段家庭视频，",
      "startSec": 0.0,
      "endSec": 1.493333,
      "startFrame": 0,
      "endFrame": 45,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0002",
      "cueId": "n01",
      "shotId": "s01-hook",
      "text": "手机能存，",
      "startSec": 1.493333,
      "endSec": 2.56,
      "startFrame": 45,
      "endFrame": 77,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0003",
      "cueId": "n01",
      "shotId": "s01-hook",
      "text": "硬盘也能存。",
      "startSec": 2.56,
      "endSec": 3.84,
      "startFrame": 77,
      "endFrame": 115,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0004",
      "cueId": "n02",
      "shotId": "s01-hook",
      "text": "要是换成一滴液体，",
      "startSec": 6.0,
      "endSec": 7.52,
      "startFrame": 180,
      "endFrame": 226,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0005",
      "cueId": "n02",
      "shotId": "s01-hook",
      "text": "画面还能留下来吗？",
      "startSec": 7.52,
      "endSec": 9.04,
      "startFrame": 226,
      "endFrame": 271,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0006",
      "cueId": "n03",
      "shotId": "s01-hook",
      "text": "科学家试着把文件写进 DNA，",
      "startSec": 12.0,
      "endSec": 14.24,
      "startFrame": 360,
      "endFrame": 427,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0007",
      "cueId": "n03",
      "shotId": "s01-hook",
      "text": "再把它读回来。",
      "startSec": 14.24,
      "endSec": 15.36,
      "startFrame": 427,
      "endFrame": 461,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0008",
      "cueId": "n04",
      "shotId": "s02-encode",
      "text": "DNA 的字母表只有四个符号。",
      "startSec": 18.0,
      "endSec": 20.477576,
      "startFrame": 540,
      "endFrame": 614,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0009",
      "cueId": "n04",
      "shotId": "s02-encode",
      "text": "把二进制两位一组，",
      "startSec": 20.477576,
      "endSec": 22.070303,
      "startFrame": 614,
      "endFrame": 662,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0010",
      "cueId": "n04",
      "shotId": "s02-encode",
      "text": "就能映射成一枚碱基。",
      "startSec": 22.070303,
      "endSec": 23.84,
      "startFrame": 662,
      "endFrame": 715,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0011",
      "cueId": "n05",
      "shotId": "s02-encode",
      "text": "文件不能只剩一串字母。",
      "startSec": 24.0,
      "endSec": 26.288,
      "startFrame": 720,
      "endFrame": 789,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0012",
      "cueId": "n05",
      "shotId": "s02-encode",
      "text": "算法先分片，",
      "startSec": 26.288,
      "endSec": 27.536,
      "startFrame": 789,
      "endFrame": 826,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0013",
      "cueId": "n05",
      "shotId": "s02-encode",
      "text": "再给每片加地址。",
      "startSec": 27.536,
      "endSec": 29.2,
      "startFrame": 826,
      "endFrame": 876,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0014",
      "cueId": "n06",
      "shotId": "s02-encode",
      "text": "这样读回片段时，",
      "startSec": 31.0,
      "endSec": 32.371429,
      "startFrame": 930,
      "endFrame": 971,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0015",
      "cueId": "n06",
      "shotId": "s02-encode",
      "text": "算法知道它来自文件哪一段。",
      "startSec": 32.371429,
      "endSec": 34.6,
      "startFrame": 971,
      "endFrame": 1038,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0016",
      "cueId": "n07",
      "shotId": "s02-encode",
      "text": "看到 DNA，",
      "startSec": 37.0,
      "endSec": 38.168696,
      "startFrame": 1110,
      "endFrame": 1145,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0017",
      "cueId": "n07",
      "shotId": "s02-encode",
      "text": "算法已经留下两条线索：",
      "startSec": 38.168696,
      "endSec": 40.311304,
      "startFrame": 1145,
      "endFrame": 1209,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0018",
      "cueId": "n07",
      "shotId": "s02-encode",
      "text": "内容和地址。",
      "startSec": 40.311304,
      "endSec": 41.48,
      "startFrame": 1209,
      "endFrame": 1244,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0019",
      "cueId": "n08",
      "shotId": "s03-constraint",
      "text": "写入前，",
      "startSec": 44.0,
      "endSec": 44.948577,
      "startFrame": 1320,
      "endFrame": 1348,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0020",
      "cueId": "n08",
      "shotId": "s03-constraint",
      "text": "每条候选先过质检。",
      "startSec": 44.948577,
      "endSec": 47.082876,
      "startFrame": 1348,
      "endFrame": 1412,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0021",
      "cueId": "n08",
      "shotId": "s03-constraint",
      "text": "GC 失衡，",
      "startSec": 47.082876,
      "endSec": 48.268598,
      "startFrame": 1412,
      "endFrame": 1448,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0022",
      "cueId": "n08",
      "shotId": "s03-constraint",
      "text": "合成和读取都会变难。",
      "startSec": 48.268598,
      "endSec": 50.640042,
      "startFrame": 1448,
      "endFrame": 1519,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0023",
      "cueId": "n09",
      "shotId": "s03-constraint",
      "text": "第二关看同一字母是否连得太长。",
      "startSec": 51.0,
      "endSec": 54.184615,
      "startFrame": 1530,
      "endFrame": 1626,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0024",
      "cueId": "n09",
      "shotId": "s03-constraint",
      "text": "长串 A，",
      "startSec": 54.184615,
      "endSec": 55.033846,
      "startFrame": 1626,
      "endFrame": 1651,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0025",
      "cueId": "n09",
      "shotId": "s03-constraint",
      "text": "设备容易读错。",
      "startSec": 55.033846,
      "endSec": 56.52,
      "startFrame": 1651,
      "endFrame": 1696,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0026",
      "cueId": "n10",
      "shotId": "s03-constraint",
      "text": "不合格的候选会被重新映射，",
      "startSec": 58.0,
      "endSec": 60.322667,
      "startFrame": 1740,
      "endFrame": 1810,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0027",
      "cueId": "n10",
      "shotId": "s03-constraint",
      "text": "直到它给分子读写设备留出足够余量。",
      "startSec": 60.322667,
      "endSec": 63.36,
      "startFrame": 1810,
      "endFrame": 1901,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0028",
      "cueId": "n11",
      "shotId": "s03-constraint",
      "text": "这不是把字母挑得更漂亮，",
      "startSec": 66.0,
      "endSec": 68.092308,
      "startFrame": 1980,
      "endFrame": 2043,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0029",
      "cueId": "n11",
      "shotId": "s03-constraint",
      "text": "而是提前承认真实世界有噪声，",
      "startSec": 68.092308,
      "endSec": 70.533333,
      "startFrame": 2043,
      "endFrame": 2116,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0030",
      "cueId": "n11",
      "shotId": "s03-constraint",
      "text": "把风险留在写入之前处理掉。",
      "startSec": 70.533333,
      "endSec": 72.8,
      "startFrame": 2116,
      "endFrame": 2184,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0031",
      "cueId": "n12",
      "shotId": "s04-fountain",
      "text": "可只挑好序列还不够，",
      "startSec": 75.0,
      "endSec": 76.971429,
      "startFrame": 2250,
      "endFrame": 2309,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0032",
      "cueId": "n12",
      "shotId": "s04-fountain",
      "text": "因为保存和测序都可能让某些片段消失。",
      "startSec": 76.971429,
      "endSec": 80.52,
      "startFrame": 2309,
      "endFrame": 2416,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0033",
      "cueId": "n13",
      "shotId": "s04-fountain",
      "text": "DNA Fountain 的想法，",
      "startSec": 83.0,
      "endSec": 85.782992,
      "startFrame": 2490,
      "endFrame": 2573,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0034",
      "cueId": "n13",
      "shotId": "s04-fountain",
      "text": "是把源片段随机组合成很多液滴，",
      "startSec": 85.782992,
      "endSec": 88.565984,
      "startFrame": 2573,
      "endFrame": 2657,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0035",
      "cueId": "n13",
      "shotId": "s04-fountain",
      "text": "每滴都记住自己由哪些片段组合而成。",
      "startSec": 88.565984,
      "endSec": 91.720042,
      "startFrame": 2657,
      "endFrame": 2752,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0036",
      "cueId": "n14",
      "shotId": "s04-fountain",
      "text": "液滴足够多时，",
      "startSec": 92.0,
      "endSec": 93.358,
      "startFrame": 2760,
      "endFrame": 2801,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0037",
      "cueId": "n14",
      "shotId": "s04-fountain",
      "text": "解码器先找只有一个未知数的那滴。",
      "startSec": 93.358,
      "endSec": 96.462,
      "startFrame": 2801,
      "endFrame": 2894,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0038",
      "cueId": "n14",
      "shotId": "s04-fountain",
      "text": "找回一片，",
      "startSec": 96.462,
      "endSec": 97.432,
      "startFrame": 2894,
      "endFrame": 2923,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0039",
      "cueId": "n14",
      "shotId": "s04-fountain",
      "text": "就能继续消掉其他未知数。",
      "startSec": 97.432,
      "endSec": 99.76,
      "startFrame": 2923,
      "endFrame": 2993,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0040",
      "cueId": "n15",
      "shotId": "s04-fountain",
      "text": "所以冗余不是把文件复制很多遍，",
      "startSec": 101.0,
      "endSec": 103.524138,
      "startFrame": 3030,
      "endFrame": 3106,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0041",
      "cueId": "n15",
      "shotId": "s04-fountain",
      "text": "而是把恢复关系设计进组合里。",
      "startSec": 103.524138,
      "endSec": 105.88,
      "startFrame": 3106,
      "endFrame": 3176,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0042",
      "cueId": "n16",
      "shotId": "s04-fountain",
      "text": "多一些不同的组合，",
      "startSec": 110.0,
      "endSec": 111.272558,
      "startFrame": 3300,
      "endFrame": 3338,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0043",
      "cueId": "n16",
      "shotId": "s04-fountain",
      "text": "换来丢掉几片以后仍能恢复的机会。",
      "startSec": 111.272558,
      "endSec": 113.534884,
      "startFrame": 3338,
      "endFrame": 3406,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0044",
      "cueId": "n16",
      "shotId": "s04-fountain",
      "text": "这是 Fountain 真正有用的地方。",
      "startSec": 113.534884,
      "endSec": 116.08,
      "startFrame": 3406,
      "endFrame": 3482,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0045",
      "cueId": "n17",
      "shotId": "s05-wet-lab",
      "text": "接下来进入真正麻烦的环节：",
      "startSec": 118.0,
      "endSec": 120.34,
      "startFrame": 3540,
      "endFrame": 3610,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0046",
      "cueId": "n17",
      "shotId": "s05-wet-lab",
      "text": "合成、",
      "startSec": 120.34,
      "endSec": 120.88,
      "startFrame": 3610,
      "endFrame": 3626,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0047",
      "cueId": "n17",
      "shotId": "s05-wet-lab",
      "text": "保存，",
      "startSec": 120.88,
      "endSec": 121.42,
      "startFrame": 3626,
      "endFrame": 3643,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0048",
      "cueId": "n17",
      "shotId": "s05-wet-lab",
      "text": "再把 DNA 测回来。",
      "startSec": 121.42,
      "endSec": 123.04,
      "startFrame": 3643,
      "endFrame": 3691,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0049",
      "cueId": "n18",
      "shotId": "s05-wet-lab",
      "text": "读回来的不是整齐原文，",
      "startSec": 126.0,
      "endSec": 128.084223,
      "startFrame": 3780,
      "endFrame": 3843,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0050",
      "cueId": "n18",
      "shotId": "s05-wet-lab",
      "text": "可能有替换、",
      "startSec": 128.084223,
      "endSec": 129.221071,
      "startFrame": 3843,
      "endFrame": 3877,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0051",
      "cueId": "n18",
      "shotId": "s05-wet-lab",
      "text": "插入、",
      "startSec": 129.221071,
      "endSec": 129.789496,
      "startFrame": 3877,
      "endFrame": 3894,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0052",
      "cueId": "n18",
      "shotId": "s05-wet-lab",
      "text": "缺失，",
      "startSec": 129.789496,
      "endSec": 130.35792,
      "startFrame": 3894,
      "endFrame": 3911,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0053",
      "cueId": "n18",
      "shotId": "s05-wet-lab",
      "text": "也可能整条片段根本没有被读到。",
      "startSec": 130.35792,
      "endSec": 133.200042,
      "startFrame": 3911,
      "endFrame": 3996,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0054",
      "cueId": "n19",
      "shotId": "s05-wet-lab",
      "text": "画面里的红色字母是固定生成的教学样本，",
      "startSec": 135.0,
      "endSec": 138.42002,
      "startFrame": 4050,
      "endFrame": 4153,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0055",
      "cueId": "n19",
      "shotId": "s05-wet-lab",
      "text": "只用来让错误看得见，",
      "startSec": 138.42002,
      "endSec": 140.22003,
      "startFrame": 4153,
      "endFrame": 4207,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0056",
      "cueId": "n19",
      "shotId": "s05-wet-lab",
      "text": "不冒充某一次真实实验。",
      "startSec": 140.22003,
      "endSec": 142.200042,
      "startFrame": 4207,
      "endFrame": 4266,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0057",
      "cueId": "n20",
      "shotId": "s05-wet-lab",
      "text": "这一步的关键不是把噪声藏起来，",
      "startSec": 143.0,
      "endSec": 145.689655,
      "startFrame": 4290,
      "endFrame": 4371,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0058",
      "cueId": "n20",
      "shotId": "s05-wet-lab",
      "text": "而是让后面的算法有证据可用。",
      "startSec": 145.689655,
      "endSec": 148.2,
      "startFrame": 4371,
      "endFrame": 4446,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0059",
      "cueId": "n21",
      "shotId": "s05-wet-lab",
      "text": "镜头跟着一条读段离开实验台，",
      "startSec": 151.0,
      "endSec": 153.775678,
      "startFrame": 4530,
      "endFrame": 4613,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0060",
      "cueId": "n21",
      "shotId": "s05-wet-lab",
      "text": "下一站是地址分桶。",
      "startSec": 153.775678,
      "endSec": 155.560042,
      "startFrame": 4613,
      "endFrame": 4667,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0061",
      "cueId": "n22",
      "shotId": "s06-decode",
      "text": "读回的短片段，",
      "startSec": 160.0,
      "endSec": 161.306667,
      "startFrame": 4800,
      "endFrame": 4839,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0062",
      "cueId": "n22",
      "shotId": "s06-decode",
      "text": "首先要找到自己的位置。",
      "startSec": 161.306667,
      "endSec": 163.36,
      "startFrame": 4839,
      "endFrame": 4901,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0063",
      "cueId": "n23",
      "shotId": "s06-decode",
      "text": "同一位置的多条读段，",
      "startSec": 169.0,
      "endSec": 170.846165,
      "startFrame": 5070,
      "endFrame": 5125,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0064",
      "cueId": "n23",
      "shotId": "s06-decode",
      "text": "还要做局部比对。",
      "startSec": 170.846165,
      "endSec": 172.323096,
      "startFrame": 5125,
      "endFrame": 5170,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0065",
      "cueId": "n23",
      "shotId": "s06-decode",
      "text": "动态规划矩阵展示的，",
      "startSec": 172.323096,
      "endSec": 174.169261,
      "startFrame": 5170,
      "endFrame": 5225,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0066",
      "cueId": "n23",
      "shotId": "s06-decode",
      "text": "就是这一小块相似关系。",
      "startSec": 174.169261,
      "endSec": 176.200042,
      "startFrame": 5225,
      "endFrame": 5286,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0067",
      "cueId": "n24",
      "shotId": "s06-decode",
      "text": "对齐以后，",
      "startSec": 179.0,
      "endSec": 180.019355,
      "startFrame": 5370,
      "endFrame": 5401,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0068",
      "cueId": "n24",
      "shotId": "s06-decode",
      "text": "每一列都有几种候选。",
      "startSec": 180.019355,
      "endSec": 182.058065,
      "startFrame": 5401,
      "endFrame": 5462,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0069",
      "cueId": "n24",
      "shotId": "s06-decode",
      "text": "质量更高的读段，",
      "startSec": 182.058065,
      "endSec": 183.689032,
      "startFrame": 5462,
      "endFrame": 5511,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0070",
      "cueId": "n24",
      "shotId": "s06-decode",
      "text": "投下更亮的权重。",
      "startSec": 183.689032,
      "endSec": 185.32,
      "startFrame": 5511,
      "endFrame": 5560,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0071",
      "cueId": "n25",
      "shotId": "s06-decode",
      "text": "按列取共识，",
      "startSec": 188.0,
      "endSec": 189.156364,
      "startFrame": 5640,
      "endFrame": 5675,
      "source": "audio-mix-manifest.json"
    },
    {
      "id": "c0072",
      "cueId": "n25",
      "shotId": "s06-decode",
      "text": "缺口就从多条证据的交集里补回来。",
