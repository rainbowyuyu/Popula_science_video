  "narration": [
    {
      "id": "n01",
      "startSec": 0,
      "endSec": 6,
      "shotId": "s01-hook",
      "text": "一段家庭视频，手机能存，硬盘也能存。",
      "visualIntent": "手机画面压缩为发光文件块并靠近液滴。",
      "pronunciation": "一段家庭视频，手机能存，硬盘也能存。"
    },
    {
      "id": "n02",
      "startSec": 6,
      "endSec": 12,
      "shotId": "s01-hook",
      "text": "要是换成一滴液体，画面还能留下来吗？",
      "visualIntent": "错误读回样本出现替换、插入、缺失，红色仅作教学标记。",
      "evidenceIds": [
        "e-teaching-errors"
      ],
      "pronunciation": "要是换成一滴液体，画面还能留下来吗？"
    },
    {
      "id": "n03",
      "startSec": 12,
      "endSec": 18,
      "shotId": "s01-hook",
      "text": "科学家试着把文件写进 DNA，再把它读回来。",
      "visualIntent": "镜头从失败读段沿轨迹推进到编码入口。",
      "pronunciation": "科学家试着把文件写进 DNA，再把它读回来。"
    },
    {
      "id": "n04",
      "startSec": 18,
      "endSec": 24,
      "shotId": "s02-encode",
      "text": "DNA 的字母表只有四个符号。把二进制两位一组，就能映射成一枚碱基。",
      "visualIntent": "比特方块成对合并，亮起 A、T、C、G。"
    },
    {
      "id": "n05",
      "startSec": 24,
      "endSec": 31,
      "shotId": "s02-encode",
      "text": "文件不能只剩一串字母。算法先分片，再给每片加地址。",
      "visualIntent": "片段分离并挂上地址卡，地址随镜头向双螺旋移动。",
      "pronunciation": "文件不能只剩一串字母。算法先分片，再给每片加地址。"
    },
    {
      "id": "n06",
      "startSec": 31,
      "endSec": 37,
      "shotId": "s02-encode",
      "text": "这样读回片段时，算法知道它来自文件哪一段。",
      "visualIntent": "地址标签把散开的读段送入正确轨道。",
      "pronunciation": "这样读回片段时，算法知道它来自文件哪一段。"
    },
    {
      "id": "n07",
      "startSec": 37,
      "endSec": 44,
      "shotId": "s02-encode",
      "text": "看到 DNA，算法已经留下两条线索：内容和地址。",
      "visualIntent": "镜头绕过双螺旋，地址和序列同时入焦。",
      "evidenceIds": [
        "e-goldman-2013"
      ],
      "pronunciation": "看到 DNA，算法已经留下两条线索：内容和地址。"
    },
    {
      "id": "n08",
      "startSec": 44,
      "endSec": 51,
      "shotId": "s03-constraint",
      "text": "写入前，每条候选先过质检。GC 失衡，合成和读取都会变难。",
      "visualIntent": "GC 仪表从危险区滑回可控区。",
      "pronunciation": "写入前，每条候选先过质检。GC 失衡，合成和读取都会变难。"
    },
    {
      "id": "n09",
      "startSec": 51,
      "endSec": 58,
      "shotId": "s03-constraint",
      "text": "第二关看同一字母是否连得太长。长串 A，设备容易读错。",
      "visualIntent": "同聚物长度条超限变红，候选序列退回。",
      "pronunciation": "第二关看同一字母是否连得太长。长串 A，设备容易读错。"
    },
    {
      "id": "n10",
      "startSec": 58,
      "endSec": 66,
      "shotId": "s03-constraint",
      "text": "不合格的候选会被重新映射，直到它给分子读写设备留出足够余量。",
      "visualIntent": "失败候选沿屏幕外退出，新候选从同一方向平滑进入。"
    },
    {
      "id": "n11",
      "startSec": 66,
      "endSec": 75,
      "shotId": "s03-constraint",
      "text": "这不是把字母挑得更漂亮，而是提前承认真实世界有噪声，把风险留在写入之前处理掉。",
      "visualIntent": "质检门闭合，镜头穿过扫描线进入液滴关系网。",
      "evidenceIds": [
        "e-teaching-errors"
      ]
    },
    {
      "id": "n12",
      "startSec": 75,
      "endSec": 83,
      "shotId": "s04-fountain",
      "text": "可只挑好序列还不够，因为保存和测序都可能让某些片段消失。",
      "visualIntent": "若干片段熄灭，关系网仍保持连通。"
    },
    {
      "id": "n13",
      "startSec": 83,
      "endSec": 92,
      "shotId": "s04-fountain",
      "text": "DNA Fountain 的想法，是把源片段随机组合成很多液滴，每滴都记住自己由哪些片段组合而成。",
      "visualIntent": "源片段进入液滴，连线显示组合关系。",
      "evidenceIds": [
        "e-fountain-2017"
      ]
    },
    {
      "id": "n14",
      "startSec": 92,
      "endSec": 101,
      "shotId": "s04-fountain",
      "text": "液滴足够多时，解码器先找只有一个未知数的那滴。找回一片，就能继续消掉其他未知数。",
      "visualIntent": "解码过程像数独，已知块依次点亮并向外传播。",
      "pronunciation": "液滴足够多时，解码器先找只有一个未知数的那滴。找回一片，就能继续消掉其他未知数。"
    },
    {
      "id": "n15",
      "startSec": 101,
      "endSec": 110,
      "shotId": "s04-fountain",
      "text": "所以冗余不是把文件复制很多遍，而是把恢复关系设计进组合里。",
      "visualIntent": "复制的视觉退到背景，关系边被高亮。"
    },
    {
      "id": "n16",
      "startSec": 110,
      "endSec": 118,
      "shotId": "s04-fountain",
      "text": "多一些不同的组合，换来丢掉几片以后仍能恢复的机会。这是 Fountain 真正有用的地方。",
      "visualIntent": "缺片后剩余液滴汇成完整文件轮廓。",
      "evidenceIds": [
        "e-fountain-2017"
      ]
    },
    {
      "id": "n17",
      "startSec": 118,
      "endSec": 126,
      "shotId": "s05-wet-lab",
      "text": "接下来进入真正麻烦的环节：合成、保存，再把 DNA 测回来。",
      "visualIntent": "液滴飞入透明实验台，三个步骤沿同一条轨道排开。"
    },
    {
      "id": "n18",
      "startSec": 126,
      "endSec": 135,
      "shotId": "s05-wet-lab",
      "text": "读回来的不是整齐原文，可能有替换、插入、缺失，也可能整条片段根本没有被读到。",
      "visualIntent": "读段逐类出现错误，镜头做微距推进。"
    },
    {
      "id": "n19",
      "startSec": 135,
      "endSec": 143,
      "shotId": "s05-wet-lab",
      "text": "画面里的红色字母是固定生成的教学样本，只用来让错误看得见，不冒充某一次真实实验。",
      "visualIntent": "红色错误标签短暂出现后贴回读段。",
      "evidenceIds": [
        "e-teaching-errors"
      ]
    },
    {
      "id": "n20",
      "startSec": 143,
      "endSec": 151,
      "shotId": "s05-wet-lab",
      "text": "这一步的关键不是把噪声藏起来，而是让后面的算法有证据可用。",
      "visualIntent": "噪声被分层保存，清晰读段保持可追踪。"
    },
    {
      "id": "n21",
      "startSec": 151,
      "endSec": 160,
      "shotId": "s05-wet-lab",
      "text": "镜头跟着一条读段离开实验台，下一站是地址分桶。",
      "visualIntent": "镜头穿过水面高光，沿地址标签进入分桶空间。"
    },
    {
      "id": "n22",
      "startSec": 160,
      "endSec": 169,
      "shotId": "s06-decode",
      "text": "读回的短片段，首先要找到自己的位置。",
      "visualIntent": "读段沿地址轨道进入不同桶，镜头横向滑行。",
      "pronunciation": "读回的短片段，首先要找到自己的位置。"
    },
    {
      "id": "n23",
      "startSec": 169,
      "endSec": 179,
      "shotId": "s06-decode",
      "text": "同一位置的多条读段，还要做局部比对。动态规划矩阵展示的，就是这一小块相似关系。",
      "visualIntent": "镜头从桶内压入矩阵，格点沿对角线生长。",
      "evidenceIds": [
        "e-alignment"
      ]
    },
    {
      "id": "n24",
      "startSec": 179,
      "endSec": 188,
      "shotId": "s06-decode",
      "text": "对齐以后，每一列都有几种候选。质量更高的读段，投下更亮的权重。",
      "visualIntent": "列方向权重光束聚合，低质量读段半透明。"
    },
    {
      "id": "n25",
      "startSec": 188,
      "endSec": 198,
      "shotId": "s06-decode",
      "text": "按列取共识，缺口就从多条证据的交集里补回来。",
      "visualIntent": "共识列向上收束，缺失位置由多条路径共同填充。"
    },
    {
      "id": "n26",
      "startSec": 198,
      "endSec": 207,
      "shotId": "s06-decode",
      "text": "外层纠错再补最后一层余量：编码负责写入前，局部比对和共识负责读回后。",
      "visualIntent": "写入端与读回端两条轨道在镜头前后对齐。"
    },
    {
      "id": "n27",
      "startSec": 207,
      "endSec": 216,
      "shotId": "s06-decode",
      "text": "生信算法的价值，就是把杂乱的短读段，变成可以核对的文件证据。",
      "visualIntent": "矩阵退成文件块，镜头向 token 网格平滑转场。",
      "evidenceIds": [
        "e-alignment"
      ]
    },
    {
      "id": "n28",
      "startSec": 216,
      "endSec": 225,
      "shotId": "s07-model-assist",
      "text": "那大模型能帮哪一步？它先把 DNA 看成一串 token，而不是一句自然语言。",
      "visualIntent": "共识列切成 token，形成可旋转的序列带。"
    },
    {
      "id": "n29",
      "startSec": 225,
      "endSec": 235,
      "shotId": "s07-model-assist",
      "text": "模型可以给候选序列打分，提示哪一段更可能在这次实验里出错，也能检索论文和调用约束检查器。",
      "visualIntent": "候选评分、检索和工具节点依次点亮。",
      "evidenceIds": [
        "e-transformer"
      ]
    },
    {
      "id": "n30",
      "startSec": 235,
      "endSec": 245,
      "shotId": "s07-model-assist",
      "text": "它还可以观察读回结果，提出下一轮候选，把筛选变成一个会回看的闭环。",
      "visualIntent": "读回反馈箭头回到候选入口，镜头绕环一周。"
    },
    {
      "id": "n31",
      "startSec": 245,
      "endSec": 254,
      "shotId": "s07-model-assist",
      "text": "但模型不能凭空替代纠错码，也不能保证一条序列一定合成成功。",
      "visualIntent": "模型节点降低亮度，编码器与实验设备保留实体高光。",
      "evidenceIds": [
        "e-model-limit"
      ]
    },
    {
      "id": "n32",
      "startSec": 254,
      "endSec": 262,
      "shotId": "s07-model-assist",
      "text": "预测可以加快筛选，证据仍要回到编码器、合成仪和测序仪。",
      "visualIntent": "闭环收束为三类真实设备图标。",
      "evidenceIds": [
        "e-model-limit"
      ]
    },
    {
      "id": "n33",
      "startSec": 262,
      "endSec": 273,
      "shotId": "s08-return",
      "text": "回到开头那段视频：切片、地址、约束和冗余，经历一次分子读写。",
      "visualIntent": "镜头沿同一轨迹反向飞行，四层标签依次回到文件块。"
    },
    {
      "id": "n34",
      "startSec": 273,
      "endSec": 284,
      "shotId": "s08-return",
      "text": "再靠分桶、比对和共识，把噪声里的证据重新拼起来。",
      "visualIntent": "读段、矩阵和共识列连续变回原文件。"
    },
    {
      "id": "n35",
      "startSec": 284,
      "endSec": 295,
      "shotId": "s08-return",
      "text": "DNA 存储的难点，从来不只是把数据塞进去，而是让多年后的每一步，都留下可检查的证据。",
      "visualIntent": "文件重新播放，镜头拉远展示完整数据链。",
      "evidenceIds": [
        "e-fountain-2017",
        "e-model-limit"
      ]
    },
    {
