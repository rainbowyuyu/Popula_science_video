    },
    "requestHash": "e6c3482eda0ace13756ce5a21ce880d732642f9c761e09bd80e5d71644fd89de",
    "seconds": 8.720041666666667,
    "file": "D:/python_project/manim_extend_rainbow/video_project/dna_storage_algorithms/v2/public/audio/raw/028.wav"
  },
  "029": {
    "text": "它还可以观察读回结果，提出下一轮候选，把筛选变成一个会回看的闭环。",
    "referenceSha256": "dd8b89f70ab634af820966c01f3af535adcba7323427866d646c0dc1f6280bf7",
    "model": "Qwen3-TTS-0.6B",
    "parameters": {
      "temperature": 0.55,
      "top_p": 0.9,
      "repetition_penalty": 1.08,
      "max_new_tokens": 560,
      "non_streaming_mode": true
    },
    "requestHash": "b5c01175473fd620fbfe64bfd82af1cc78d5f73e7e22807f55e4fc2571bc34b5",
    "seconds": 6.000041666666666,
    "file": "D:/python_project/manim_extend_rainbow/video_project/dna_storage_algorithms/v2/public/audio/raw/029.wav"
  },
  "030": {
    "text": "但模型不能凭空替代纠错码，也不能保证一条序列一定合成成功。",
    "referenceSha256": "dd8b89f70ab634af820966c01f3af535adcba7323427866d646c0dc1f6280bf7",
    "model": "Qwen3-TTS-0.6B",
