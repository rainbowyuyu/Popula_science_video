    },
    {
      "id": "005",
      "startSec": 31,
      "endSec": 37,
      "file": "D:/python_project/manim_extend_rainbow/video_project/dna_storage_algorithms/v2/public/audio/raw/005.wav",
      "text": "这样读回片段时，算法知道它来自文件哪一段。",
