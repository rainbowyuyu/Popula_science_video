  "captions": [
    {
      "start": 0.0,
      "end": 0.97,
      "text": "雨刚停，",
      "clipId": "r001"
    },
    {
      "start": 1.28,
      "end": 2.53,
      "text": "路上还泛着水光。",
      "clipId": "r001"
    },
    {
      "start": 2.76,
      "end": 4.57,
      "text": "一道彩虹落在街道尽头。",
      "clipId": "r001"
    },
    {
      "start": 4.86,
      "end": 6.64,
      "text": "你有没有想过，走到那里，",
      "clipId": "r001"
    },
    {
      "start": 6.64,
      "end": 7.87,
      "text": "能摸到彩虹吗？",
      "clipId": "r001"
    },
    {
      "start": 8.6,
      "end": 9.95,
      "text": "往前走几步，",
      "clipId": "r002"
    },
    {
      "start": 10.16,
      "end": 11.21,
      "text": "它还在远处。",
      "clipId": "r002"
    },
    {
      "start": 11.58,
      "end": 12.57,
      "text": "明明像一座桥，",
      "clipId": "r002"
    },
    {
      "start": 12.92,
      "end": 14.39,
      "text": "却始终找不到桥脚。",
      "clipId": "r002"
    },
    {
      "start": 14.78,
      "end": 15.45,
      "text": "还有个问题，",
      "clipId": "r002"
    },
    {
      "start": 15.78,
      "end": 17.01,
      "text": "它为什么总是弯的？",
      "clipId": "r002"
    },
    {
      "start": 17.6,
      "end": 18.39,
      "text": "回头看看，",
      "clipId": "r003"
    },
    {
      "start": 18.74,
      "end": 19.69,
      "text": "太阳在背后；",
      "clipId": "r003"
    },
    {
      "start": 19.94,
      "end": 20.97,
      "text": "前方的天空里，",
      "clipId": "r003"
    },
    {
      "start": 21.26,
      "end": 21.99,
      "text": "还有一片雨。",
      "clipId": "r003"
    },
    {
      "start": 22.3,
      "end": 23.53,
      "text": "阳光、水滴，",
      "clipId": "r003"
    },
    {
      "start": 23.82,
      "end": 25.11,
      "text": "再加上你站的位置，",
      "clipId": "r003"
    },
    {
      "start": 25.34,
      "end": 26.39,
      "text": "答案就藏在这里。",
      "clipId": "r003"
    },
    {
      "start": 27.08,
      "end": 28.54,
      "text": "我们从这片雨里，",
      "clipId": "r004"
    },
    {
      "start": 28.54,
      "end": 29.73,
      "text": "挑出一滴水。",
      "clipId": "r004"
    },
    {
      "start": 29.94,
      "end": 31.61,
      "text": "天空那么大的一道彩虹，",
      "clipId": "r004"
    },
    {
      "start": 31.78,
      "end": 33.29,
      "text": "要从这个小地方说起。",
      "clipId": "r004"
    },
    {
      "start": 33.92,
      "end": 35.25,
      "text": "很小的雨滴，",
      "clipId": "r005"
    },
    {
      "start": 35.54,
      "end": 37.07,
      "text": "形状接近一个圆球。",
      "clipId": "r005"
    },
    {
      "start": 37.4,
      "end": 38.41,
      "text": "阳光碰到它，",
      "clipId": "r005"
    },
    {
      "start": 38.7,
      "end": 40.49,
      "text": "先经过空气和水的交界。",
      "clipId": "r005"
    },
    {
      "start": 41.16,
      "end": 42.97,
      "text": "光在水里传播得慢一些，",
      "clipId": "r006"
    },
    {
      "start": 43.34,
      "end": 44.23,
      "text": "斜着进入时，",
      "clipId": "r006"
    },
    {
      "start": 44.38,
      "end": 45.59,
      "text": "方向也会转弯。",
      "clipId": "r006"
    },
    {
      "start": 45.82,
      "end": 46.79,
      "text": "这就叫折射。",
      "clipId": "r006"
    },
    {
      "start": 47.28,
      "end": 48.83,
      "text": "把筷子放进水杯，",
      "clipId": "r007"
    },
    {
      "start": 49.1,
      "end": 50.27,
      "text": "看着像折了一下，",
      "clipId": "r007"
    },
    {
      "start": 50.46,
      "end": 51.63,
      "text": "也是同样的道理。",
      "clipId": "r007"
    },
    {
      "start": 51.88,
      "end": 53.23,
      "text": "水没有把筷子折断，",
      "clipId": "r007"
    },
    {
      "start": 53.4,
      "end": 55.43,
      "text": "转弯的是来到眼睛里的光。",
      "clipId": "r007"
    },
    {
      "start": 56.04,
      "end": 57.69,
      "text": "一滴水的表面是弯的。",
      "clipId": "r008"
    },
    {
      "start": 57.92,
      "end": 59.35,
      "text": "光从不同位置进去，",
      "clipId": "r008"
    },
    {
      "start": 59.48,
      "end": 60.87,
      "text": "就会走上不同的路线。",
      "clipId": "r008"
    },
    {
      "start": 61.1,
      "end": 62.33,
      "text": "我们跟住其中一条。",
      "clipId": "r008"
    },
    {
      "start": 62.72,
      "end": 64.45,
      "text": "阳光看起来是白色，",
      "clipId": "r009"
    },
    {
      "start": 64.7,
      "end": 66.49,
      "text": "里面却混着一整段颜色。",
      "clipId": "r009"
    },
    {
      "start": 66.82,
      "end": 67.81,
      "text": "进入水滴时，",
      "clipId": "r009"
    },
    {
      "start": 68.04,
      "end": 70.09,
      "text": "各种颜色转弯的程度略有不同。",
      "clipId": "r009"
    },
    {
      "start": 70.6,
      "end": 72.07,
      "text": "红光拐得少一点，",
      "clipId": "r010"
    },
    {
      "start": 72.36,
      "end": 73.59,
      "text": "紫光拐得多一点。",
      "clipId": "r010"
    },
    {
      "start": 73.92,
      "end": 75.26,
      "text": "原本挤在一起的颜色，",
      "clipId": "r010"
    },
    {
      "start": 75.26,
      "end": 76.63,
      "text": "开始慢慢分开。",
      "clipId": "r010"
    },
    {
      "start": 77.200042,
      "end": 78.570042,
      "text": "光也有起伏，",
      "clipId": "r042"
    },
    {
      "start": 78.900042,
      "end": 81.840042,
      "text": "波长就是相邻两次起伏之间的距离。",
      "clipId": "r042"
    },
    {
      "start": 81.840042,
      "end": 84.330042,
      "text": "红光的波长较长，紫光较短。",
      "clipId": "r042"
    },
    {
      "start": 84.680042,
      "end": 86.350042,
      "text": "水对它们的折射程度不同，",
      "clipId": "r042"
    },
    {
      "start": 86.660042,
      "end": 87.830042,
      "text": "颜色才会分开。",
      "clipId": "r042"
    },
    {
      "start": 88.520042,
      "end": 91.890042,
      "text": "中间还有橙、黄、绿、蓝，",
      "clipId": "r011"
    },
    {
      "start": 92.160042,
      "end": 93.250042,
      "text": "一种接着一种。",
      "clipId": "r011"
    },
    {
      "start": 93.520042,
      "end": 94.625042,
      "text": "水滴做的事，",
      "clipId": "r011"
    },
    {
      "start": 94.720042,
      "end": 96.870042,
      "text": "是把白光里原有的颜色展开。",
      "clipId": "r011"
    },
    {
      "start": 97.680083,
      "end": 99.670083,
      "text": "颜色之间一直在过渡。",
      "clipId": "r012"
    },
    {
      "start": 99.800083,
      "end": 100.980083,
      "text": "我们常说的七色，",
      "clipId": "r012"
    },
    {
      "start": 100.980083,
      "end": 102.610083,
      "text": "是方便记忆的名字，",
      "clipId": "r012"
    },
    {
      "start": 102.800083,
      "end": 104.530083,
      "text": "真实的光谱连成一片。",
      "clipId": "r012"
    },
    {
      "start": 105.000125,
      "end": 106.990125,
      "text": "沿着这片光谱慢慢移动，",
      "clipId": "r043"
    },
    {
      "start": 107.340125,
      "end": 109.270125,
      "text": "红色先偏橙，再偏黄。",
      "clipId": "r043"
    },
    {
      "start": 109.600125,
      "end": 112.610125,
      "text": "七个名字，像给渐变色放了几个路标，",
      "clipId": "r043"
    },
    {
      "start": 113.140125,
      "end": 114.970125,
      "text": "中间还有许多细微的颜色。",
      "clipId": "r043"
    },
    {
      "start": 115.280125,
      "end": 116.290125,
      "text": "继续往里走。",
      "clipId": "r013"
    },
    {
      "start": 116.660125,
      "end": 118.350125,
      "text": "光到达水滴的另一面，",
      "clipId": "r013"
    },
    {
      "start": 118.580125,
      "end": 119.630125,
      "text": "有一部分穿出去，",
      "clipId": "r013"
    },
    {
      "start": 119.880125,
      "end": 122.570125,
      "text": "还有一部分在水里反射，回过头来。",
      "clipId": "r013"
    },
    {
      "start": 123.240125,
      "end": 126.120125,
      "text": "这一部分光再次走到水和空气的交界，",
      "clipId": "r014"
    },
    {
      "start": 126.120125,
      "end": 127.840125,
      "text": "出门时又折射一次。",
      "clipId": "r014"
    },
    {
      "start": 127.840125,
      "end": 130.810125,
      "text": "它已经朝着阳光来时的那一侧返回。",
      "clipId": "r014"
    },
    {
      "start": 131.520125,
      "end": 132.890125,
      "text": "进门转一次弯，",
      "clipId": "r015"
    },
    {
      "start": 133.160125,
      "end": 134.170125,
      "text": "里面回一次头，",
      "clipId": "r015"
    },
    {
      "start": 134.480125,
      "end": 136.620125,
      "text": "出门再转一次弯。这条路线，",
      "clipId": "r015"
    },
    {
      "start": 136.620125,
      "end": 138.090125,
      "text": "就是最常见的主虹。",
      "clipId": "r015"
    },
    {
      "start": 138.840167,
      "end": 140.010167,
      "text": "这一来一回，",
      "clipId": "r044"
    },
    {
      "start": 140.300167,
      "end": 142.200167,
      "text": "红光和紫光的出口就错开了。",
      "clipId": "r044"
    },
    {
      "start": 142.200167,
      "end": 144.460167,
      "text": "等许多雨滴同时把光送过来，",
      "clipId": "r044"
    },
    {
      "start": 144.460167,
      "end": 145.870167,
      "text": "这点方向差异，",
      "clipId": "r044"
    },
    {
      "start": 146.020167,
      "end": 148.850167,
      "text": "才会展开成天空中有宽度的一道彩带。",
      "clipId": "r044"
    },
    {
      "start": 149.680167,
      "end": 153.000167,
      "text": "让更多光线从不同位置进入。你会发现，",
      "clipId": "r017"
    },
    {
      "start": 153.000167,
      "end": 155.640167,
      "text": "许多出射光挤在相近的角度，",
      "clipId": "r017"
    },
    {
      "start": 155.640167,
      "end": 157.530167,
      "text": "形成一处明亮的集中。",
      "clipId": "r017"
    },
    {
      "start": 158.280167,
      "end": 159.680167,
      "text": "红光最亮的方向，",
      "clipId": "r018"
    },
    {
      "start": 159.680167,
      "end": 161.090167,
      "text": "大约在四十二度；",
      "clipId": "r018"
    },
    {
      "start": 161.580167,
      "end": 163.050167,
      "text": "紫光大约四十度。",
      "clipId": "r018"
    },
    {
      "start": 163.300167,
      "end": 164.600167,
      "text": "差出来的这点角度，",
      "clipId": "r018"
    },
    {
      "start": 164.600167,
      "end": 166.610167,
      "text": "把彩色的边缘拉开了。",
      "clipId": "r018"
    },
    {
      "start": 167.280167,
      "end": 168.180167,
      "text": "这两个角，",
      "clipId": "r019"
    },
    {
      "start": 168.180167,
      "end": 171.120167,
      "text": "是对着哪里量的呢？从太阳，",
      "clipId": "r019"
    },
    {
      "start": 171.120167,
      "end": 172.590167,
      "text": "经过你的眼睛，",
      "clipId": "r019"
    },
    {
      "start": 172.660167,
      "end": 173.630167,
      "text": "再向前延伸，",
      "clipId": "r019"
    },
    {
      "start": 173.860167,
      "end": 175.410167,
      "text": "就是背向太阳的方向。",
      "clipId": "r019"
    },
    {
      "start": 176.040167,
      "end": 177.870167,
      "text": "你的影子也指向那边。",
      "clipId": "r020"
    },
    {
      "start": 178.060167,
      "end": 179.410167,
      "text": "以这条方向为中心，",
      "clipId": "r020"
    },
    {
      "start": 179.580167,
      "end": 180.890167,
      "text": "往外偏四十二度，",
      "clipId": "r020"
    },
    {
      "start": 181.100167,
      "end": 182.910167,
      "text": "就找到了主虹的红色外缘。",
      "clipId": "r020"
    },
    {
      "start": 183.760167,
      "end": 185.000167,
      "text": "现在把一滴水，",
      "clipId": "r021"
    },
    {
      "start": 185.000167,
      "end": 186.450167,
      "text": "换成一整片雨。",
      "clipId": "r021"
    },
    {
      "start": 186.640167,
      "end": 188.700167,
      "text": "能把红光送进你眼睛的水滴，",
      "clipId": "r021"
    },
    {
      "start": 188.700167,
      "end": 190.290167,
      "text": "都落在这组方向上。",
      "clipId": "r021"
    },
    {
      "start": 190.600167,
      "end": 192.770167,
      "text": "朝上、朝左、朝右，",
      "clipId": "r022"
    },
    {
      "start": 193.120167,
      "end": 195.290167,
      "text": "只要和中心线保持同样的角度，",
      "clipId": "r022"
    },
    {
      "start": 195.440167,
      "end": 197.870167,
      "text": "都有机会出现红光。绕一圈，",
      "clipId": "r022"
    },
    {
      "start": 198.100167,
      "end": 199.210167,
      "text": "就围出一个圆锥。",
      "clipId": "r022"
    },
    {
      "start": 199.680208,
      "end": 201.290208,
      "text": "你的眼睛在尖端。",
      "clipId": "r023"
    },
    {
      "start": 201.560208,
      "end": 203.030208,
      "text": "那些水滴可以很近，",
      "clipId": "r023"
    },
    {
      "start": 203.320208,
      "end": 205.130208,
      "text": "也可以很远，重要的是，",
      "clipId": "r023"
    },
    {
      "start": 205.460208,
      "end": 207.310208,
      "text": "它们有没有落在合适的方向。",
      "clipId": "r023"
    },
    {
      "start": 207.720208,
      "end": 209.250208,
      "text": "从尖端望出去，",
      "clipId": "r024"
    },
    {
      "start": 209.600208,
      "end": 213.270208,
      "text": "这些方向围成一个圆。红色在外，紫色在内。",
      "clipId": "r024"
    },
    {
      "start": 213.580208,
      "end": 215.990208,
      "text": "原来彩虹的完整形状，是圆的。",
      "clipId": "r024"
    },
    {
      "start": 216.640208,
      "end": 218.090208,
      "text": "我们站在地面上，",
      "clipId": "r025"
    },
    {
      "start": 218.280208,
      "end": 220.370208,
      "text": "往下看的方向被地面挡住，",
      "clipId": "r025"
    },
    {
      "start": 220.620208,
      "end": 223.450208,
      "text": "下面也常常缺少被阳光照到的雨滴。",
      "clipId": "r025"
    },
    {
      "start": 223.760208,
      "end": 225.630208,
      "text": "于是只剩天空里的这一段弧。",
      "clipId": "r025"
    },
    {
      "start": 226.440208,
      "end": 228.166875,
      "text": "太阳贴近地平线时，",
      "clipId": "r026"
    },
    {
      "start": 228.166875,
      "end": 229.930208,
      "text": "圆心也接近地平线，",
      "clipId": "r026"
    },
    {
      "start": 230.180208,
      "end": 234.130208,
      "text": "彩虹能露出较长的一段。太阳升高，圆心下沉，",
      "clipId": "r026"
    },
    {
      "start": 234.380208,
      "end": 235.670208,
      "text": "露出的弧就短了。",
      "clipId": "r026"
    },
    {
      "start": 236.240208,
      "end": 238.110208,
      "text": "飞机旁、瀑布上方，",
      "clipId": "r027"
    },
    {
      "start": 238.360208,
      "end": 239.550208,
      "text": "有时能看见整圆。",
      "clipId": "r027"
    },
    {
      "start": 239.860208,
      "end": 242.365208,
      "text": "条件是脚下也有阳光照亮的水雾，",
      "clipId": "r027"
    },
    {
      "start": 242.500208,
      "end": 243.850208,
      "text": "而且视野足够开阔。",
      "clipId": "r027"
    },
    {
      "start": 244.600208,
      "end": 245.246875,
      "text": "所以，",
      "clipId": "r028"
    },
    {
      "start": 245.246875,
      "end": 247.990208,
      "text": "弧形来自我们的位置和地面的遮挡。",
      "clipId": "r028"
    },
    {
      "start": 248.260208,
      "end": 249.210208,
      "text": "换一个视野，",
      "clipId": "r028"
    },
    {
      "start": 249.460208,
      "end": 250.380208,
      "text": "藏起来的那一段，",
      "clipId": "r028"
    },
    {
      "start": 250.380208,
      "end": 251.810208,
      "text": "也可能重新出现。",
      "clipId": "r028"
    },
    {
      "start": 252.16025,
      "end": 254.25025,
      "text": "还记得开头那座追不到的桥吗？",
      "clipId": "r029"
    },
    {
      "start": 254.44025,
      "end": 255.50025,
      "text": "让我们横着走几步，",
      "clipId": "r029"
    },
    {
      "start": 255.50025,
      "end": 256.93025,
      "text": "看看会发生什么。",
      "clipId": "r029"
    },
    {
      "start": 257.72025,
      "end": 259.09025,
      "text": "眼睛换了位置，",
      "clipId": "r030"
    },
    {
      "start": 259.34025,
      "end": 261.11025,
      "text": "圆锥的尖端也跟着移动。",
      "clipId": "r030"
    },
    {
      "start": 261.14025,
      "end": 263.47025,
      "text": "原先送来红光的水滴退下，",
      "clipId": "r030"
    },
    {
      "start": 263.66025,
      "end": 265.27025,
      "text": "旁边另一批水滴接上。",
      "clipId": "r030"
    },
    {
      "start": 265.60025,
      "end": 267.09025,
      "text": "两个人肩并肩，",
      "clipId": "r031"
    },
    {
      "start": 267.32025,
      "end": 269.05025,
      "text": "看见的彩虹非常相似。",
      "clipId": "r031"
    },
    {
      "start": 269.26025,
      "end": 270.62025,
      "text": "送进各自眼睛的光，",
      "clipId": "r031"
    },
    {
      "start": 270.62025,
      "end": 272.29025,
      "text": "却来自不同的水滴。",
      "clipId": "r031"
    },
    {
      "start": 273.00025,
      "end": 276.25025,
      "text": "这就是追不到彩虹的原因。你往前走，",
      "clipId": "r032"
    },
    {
      "start": 276.48025,
      "end": 277.99025,
      "text": "成虹的水滴也在换。",
      "clipId": "r032"
    },
    {
      "start": 278.38025,
      "end": 279.50025,
      "text": "所谓彩虹的尽头，",
      "clipId": "r032"
    },
    {
      "start": 279.50025,
      "end": 280.99025,
      "text": "是视线里的位置。",
      "clipId": "r032"
    },
    {
      "start": 281.60025,
      "end": 282.47025,
      "text": "有时，",
      "clipId": "r033"
    },
    {
      "start": 282.66025,
      "end": 285.53025,
      "text": "外面还会出现一条更淡的弧。仔细看，",
      "clipId": "r033"
    },
    {
      "start": 285.80025,
      "end": 287.01025,
      "text": "红色跑到了里面，",
      "clipId": "r033"
    },
    {
      "start": 287.14025,
      "end": 288.73025,
      "text": "紫色反而在外面。",
      "clipId": "r033"
    },
    {
      "start": 289.24025,
      "end": 290.55025,
      "text": "再回到水滴。",
      "clipId": "r034"
    },
    {
      "start": 290.88025,
      "end": 293.51025,
      "text": "这次光在里面回头两次，才离开。",
      "clipId": "r034"
    },
    {
      "start": 293.72025,
      "end": 294.73025,
      "text": "多一次反射，",
      "clipId": "r034"
    },
    {
      "start": 294.94025,
      "end": 296.45025,
      "text": "出口的方向就变了。",
      "clipId": "r034"
    },
    {
      "start": 297.80025,
      "end": 299.29025,
      "text": "副虹大约在五十一度附近，",
      "clipId": "r035"
    },
    {
      "start": 299.62025,
      "end": 300.67025,
      "text": "紫光更靠外。",
      "clipId": "r035"
    },
    {
      "start": 300.96025,
      "end": 302.63025,
      "text": "于是它围在主虹外面，",
      "clipId": "r035"
    },
    {
      "start": 302.78025,
      "end": 304.19025,
      "text": "颜色顺序也倒过来。",
      "clipId": "r035"
    },
    {
      "start": 304.52025,
      "end": 305.56025,
      "text": "每次反射，",
      "clipId": "r036"
    },
    {
      "start": 305.56025,
      "end": 309.01025,
      "text": "都有一部分光离开原来的路线。多绕一圈，",
      "clipId": "r036"
    },
    {
      "start": 309.24025,
      "end": 310.953583,
      "text": "送到眼睛里的光更少，",
      "clipId": "r036"
    },
    {
      "start": 310.953583,
      "end": 312.53025,
      "text": "副虹也就显得淡。",
      "clipId": "r036"
    },
    {
      "start": 313.20025,
      "end": 314.53025,
      "text": "两道虹之间，",
      "clipId": "r037"
    },
    {
      "start": 314.76025,
      "end": 317.25025,
      "text": "这两类光路送到眼睛里的光比较少。",
      "clipId": "r037"
    },
    {
      "start": 317.94025,
      "end": 319.71025,
      "text": "那一圈偏暗的天空，",
      "clipId": "r037"
    },
    {
      "start": 319.84025,
      "end": 321.11025,
      "text": "叫亚历山大暗带。",
      "clipId": "r037"
    },
    {
      "start": 322.06025,
      "end": 323.89025,
      "text": "空气散射的光仍在，",
      "clipId": "r037"
    },
    {
      "start": 324.26025,
      "end": 325.97025,
      "text": "所以它并没有变成一片漆黑。",
      "clipId": "r037"
    },
    {
      "start": 326.760292,
      "end": 328.450292,
      "text": "不必等下一场雨。",
      "clipId": "r038"
    },
    {
      "start": 328.820292,
      "end": 329.620292,
      "text": "晴天的喷泉，",
      "clipId": "r038"
    },
    {
      "start": 329.620292,
      "end": 332.200292,
      "text": "或者洒水时形成的细水雾，",
      "clipId": "r038"
    },
    {
      "start": 332.200292,
      "end": 333.810292,
      "text": "就能做一次小实验。",
      "clipId": "r038"
    },
    {
      "start": 334.080333,
      "end": 336.290333,
      "text": "背对太阳，看向水雾，",
      "clipId": "r039"
    },
    {
      "start": 336.340333,
      "end": 337.630333,
      "text": "慢慢调整位置。",
      "clipId": "r039"
    },
    {
      "start": 338.000333,
      "end": 339.020333,
      "text": "合适的角度一到，",
      "clipId": "r039"
    },
    {
      "start": 339.020333,
      "end": 340.340333,
      "text": "几滴普通的水，",
      "clipId": "r039"
    },
    {
      "start": 340.340333,
      "end": 342.150333,
      "text": "就能亮出一小段彩虹。",
      "clipId": "r039"
    },
    {
      "start": 342.920375,
      "end": 344.570375,
      "text": "下次雨后抬头，",
      "clipId": "r041"
    },
    {
      "start": 344.760375,
      "end": 347.430375,
      "text": "你可以试着找出太阳、影子和雨幕。",
      "clipId": "r041"
    },
    {
      "start": 347.720375,
      "end": 348.930375,
      "text": "那道弯弯的彩虹，",
      "clipId": "r041"
    },
    {
      "start": 349.160375,
      "end": 350.950375,
      "text": "是光和你共同画出的圆。",
      "clipId": "r041"
    }
  ],
