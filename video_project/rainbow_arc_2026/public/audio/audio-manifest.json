      "model": "Qwen3-TTS-0.6B",
      "reference": "D:/python_project/tts/work/clone-reference.wav",
      "subjectiveListeningChecked": false
    },
    {
      "id": "r032",
      "scene": "observer",
      "text": "这就是追不到彩虹的原因。你往前走，成虹的水滴也在换。所谓彩虹的尽头，是视线里的位置。",
      "raw": "research/audio/raw/r032-raw.wav",
      "audio": "public/audio/r032.wav",
      "duration": 8.48,
      "sampleRate": 48000,
      "sha256": "a5f7bee2874342b5fd238a42b621217ef5216d9ebd54036699a67b0e74893ce4",
      "rawSHA256": "c5033a500cdf815f1f14f4e4f2c781eaa2d00b9d10ca037022cc74fe56623010",
      "version": "V06-protected-broadcast",
      "referenceSHA256": "dd8b89f70ab634af820966c01f3af535adcba7323427866d646c0dc1f6280bf7",
      "seed": 3522524905,
      "settings": {
