      "duration": 7.440042,
      "sampleRate": 48000,
      "sha256": "99eb1df1940f9a1d1fd06cea42d94cf07ed75946835ba2acbbe2dd2bf1c58070",
      "rawSHA256": "d76a477e4d35ee26e139875aa4b55dabf9ef7c502a948ed151e89ca86903561d",
      "version": "V06-protected-broadcast",
      "referenceSHA256": "dd8b89f70ab634af820966c01f3af535adcba7323427866d646c0dc1f6280bf7",
