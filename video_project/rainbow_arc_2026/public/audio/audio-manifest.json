      "model": "Qwen3-TTS-0.6B",
      "reference": "D:/python_project/tts/work/clone-reference.wav",
      "subjectiveListeningChecked": false
    },
    {
      "id": "r023",
      "scene": "cone",
      "text": "你的眼睛在尖端。那些水滴可以很近，也可以很远，重要的是，它们有没有落在合适的方向。",
      "raw": "research/audio/raw/r023-raw.wav",
      "audio": "public/audio/r023.wav",
      "duration": 7.92,
      "sampleRate": 48000,
      "sha256": "acef653031626a5b3d11547055ed69fdaec7caf6f15c51d526c86e6a48271015",
      "rawSHA256": "da44ce370ecd7f36f01983f2c88007443cf1937b05d9d0cae273f1797fa600ba",
      "version": "V06-protected-broadcast",
      "referenceSHA256": "dd8b89f70ab634af820966c01f3af535adcba7323427866d646c0dc1f6280bf7",
      "seed": 26970057,
      "settings": {
        "temperature": 0.42,
        "top_p": 0.86,
        "repetition_penalty": 1.05,
