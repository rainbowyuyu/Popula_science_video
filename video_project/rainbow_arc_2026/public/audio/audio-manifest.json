      "model": "Qwen3-TTS-0.6B",
      "reference": "D:/python_project/tts/work/clone-reference.wav",
      "subjectiveListeningChecked": false
    },
    {
      "id": "r031",
      "scene": "observer",
      "text": "两个人肩并肩，看见的彩虹非常相似。送进各自眼睛的光，却来自不同的水滴。",
      "raw": "research/audio/raw/r031-raw.wav",
      "audio": "public/audio/r031.wav",
      "duration": 7.28,
      "sampleRate": 48000,
      "sha256": "45a88ecfd15fbd740080747b5087cbaa6686accecf295e535ea47afea0d79dde",
      "rawSHA256": "42c39225a8b8c4657dc0841ff9a6a35a5484b5e560ba5655feb0680cb450a5aa",
      "version": "V06-protected-broadcast",
      "referenceSHA256": "dd8b89f70ab634af820966c01f3af535adcba7323427866d646c0dc1f6280bf7",
      "seed": 3309931848,
      "settings": {
