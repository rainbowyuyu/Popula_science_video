      "model": "Qwen3-TTS-0.6B",
      "reference": "D:/python_project/tts/work/clone-reference.wav",
      "subjectiveListeningChecked": false
    },
    {
      "id": "r034",
      "scene": "secondary",
      "text": "再回到水滴。这次光在里面回头两次，才离开。多一次反射，出口的方向就变了。",
      "raw": "research/audio/raw/r034-raw.wav",
      "audio": "public/audio/r034.wav",
      "duration": 7.68,
      "sampleRate": 48000,
      "sha256": "c751edf75844a7df55ea3971c91b3a730ae3ec185b0f600b9e93c545f9f36343",
