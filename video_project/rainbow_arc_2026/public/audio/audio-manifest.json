      "model": "Qwen3-TTS-0.6B",
      "reference": "D:/python_project/tts/work/clone-reference.wav",
      "subjectiveListeningChecked": false
    },
    {
      "id": "r022",
      "scene": "cone",
      "text": "朝上、朝左、朝右，只要和中心线保持同样的角度，都有机会出现红光。绕一圈，就围出一个圆锥。",
      "raw": "research/audio/raw/r022-raw.wav",
      "audio": "public/audio/r022.wav",
      "duration": 8.960042,
      "sampleRate": 48000,
      "sha256": "aa8aa1c607042a167498df210290817792806f5e2a33b334e26236a445624a31",
      "rawSHA256": "fba4793912b418b4f10f2e7bb8f0cc8f750acffa5f57dc0cf728bd4b576e47b8",
      "version": "V06-protected-broadcast",
      "referenceSHA256": "dd8b89f70ab634af820966c01f3af535adcba7323427866d646c0dc1f6280bf7",
      "seed": 396565949,
      "settings": {
