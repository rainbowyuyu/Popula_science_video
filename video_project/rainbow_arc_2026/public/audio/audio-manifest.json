      "sampleRate": 48000,
      "sha256": "60d3d27b061ed1a61ab8b56d108eae536b8b95700bc5a4924503c1a96a84437d",
      "rawSHA256": "af313f86c573dd644ce9491e969f9e3888ebbfcfc9efc6c73e280b0be8b4e1b9",
      "version": "V06-protected-broadcast",
      "referenceSHA256": "dd8b89f70ab634af820966c01f3af535adcba7323427866d646c0dc1f6280bf7",
