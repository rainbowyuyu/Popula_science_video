      "model": "Qwen3-TTS-0.6B",
      "reference": "D:/python_project/tts/work/clone-reference.wav",
      "subjectiveListeningChecked": false
    },
    {
      "id": "r024",
      "scene": "cone",
      "text": "从尖端望出去，这些方向围成一个圆。红色在外，紫色在内。原来彩虹的完整形状，是圆的。",
      "raw": "research/audio/raw/r024-raw.wav",
      "audio": "public/audio/r024.wav",
      "duration": 8.8,
      "sampleRate": 48000,
      "sha256": "525819a2d5257cf737af8dcda8083d7b645b4d385042b2672870b717e4f247a2",
