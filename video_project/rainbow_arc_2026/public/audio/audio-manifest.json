      "subjectiveListeningChecked": false
    },
    {
      "id": "r003",
      "scene": "street",
      "text": "回头看看，太阳在背后；前方的天空里，还有一片雨。阳光、水滴，再加上你站的位置，答案就藏在这里。",
      "raw": "research/audio/raw/r003-raw.wav",
      "audio": "public/audio/r003.wav",
      "duration": 9.36,
      "sampleRate": 48000,
      "sha256": "26d126f7c7f3be5575a2baf6a9a6ae4c0f9e885556de63a428585142045956c9",
      "rawSHA256": "0683f5688e88825a9efbb5eb02b0e206129fbdcb5e82b49413cbcad390a8bcf6",
      "version": "V06-protected-broadcast",
      "referenceSHA256": "dd8b89f70ab634af820966c01f3af535adcba7323427866d646c0dc1f6280bf7",
