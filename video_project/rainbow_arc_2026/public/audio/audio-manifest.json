      "subjectiveListeningChecked": false
    },
    {
      "id": "r004",
      "scene": "street",
      "text": "我们从这片雨里，挑出一滴水。天空那么大的一道彩虹，要从这个小地方说起。",
      "raw": "research/audio/raw/r004-raw.wav",
