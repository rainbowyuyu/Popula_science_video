      "duration": 7.52,
      "sampleRate": 48000,
      "sha256": "1d84bf66c17d5ea19d925f745817fd4aa60ffec179b6f81aa06e2a4705b16606",
      "rawSHA256": "a0683a2a39b102ebefb870b05e267d8beb66c349a6c29e4af48e68fb633cbdc8",
      "version": "V06-protected-broadcast",
      "referenceSHA256": "dd8b89f70ab634af820966c01f3af535adcba7323427866d646c0dc1f6280bf7",
