      "subjectiveListeningChecked": false
    },
    {
      "id": "r015",
      "scene": "reflection",
      "text": "进门转一次弯，里面回一次头，出门再转一次弯。这条路线，就是最常见的主虹。",
      "raw": "research/audio/raw/r015-raw.wav",
