      "model": "Qwen3-TTS-0.6B",
      "reference": "D:/python_project/tts/work/clone-reference.wav",
      "subjectiveListeningChecked": false
    },
    {
      "id": "r035",
      "scene": "secondary",
      "text": "副虹大约在五十一度附近，紫光更靠外。于是它围在主虹外面，颜色顺序也倒过来。",
      "raw": "research/audio/raw/r035-raw.wav",
      "audio": "public/audio/r035.wav",
      "duration": 7.36,
      "sampleRate": 48000,
      "sha256": "da7443e0195d4a722c67746d6d164dc7454ba172ac7ebfb5a3aa8aac6ae67646",
