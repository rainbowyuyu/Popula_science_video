      "subjectiveListeningChecked": false
    },
    {
      "id": "r029",
      "scene": "observer",
      "text": "还记得开头那座追不到的桥吗？让我们横着走几步，看看会发生什么。",
      "raw": "research/audio/raw/r029-raw.wav",
      "audio": "public/audio/r029.wav",
      "duration": 5.44,
      "sampleRate": 48000,
      "sha256": "eb6e0be4eb8aaa031a43a8c0c8c29f9225168510deb881ece477b6df9df26965",
      "rawSHA256": "bdd3156ddeb721e82cd1bd6960f4748e742a182b2fbe9f8d2e4eee55fb29cc75",
      "version": "V06-protected-broadcast",
      "referenceSHA256": "dd8b89f70ab634af820966c01f3af535adcba7323427866d646c0dc1f6280bf7",
