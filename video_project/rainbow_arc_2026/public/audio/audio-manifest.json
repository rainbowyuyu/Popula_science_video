      "duration": 7.76,
      "sampleRate": 48000,
      "sha256": "f6cf088b9a7ac8f7709d645cf451662c7ae77dab97a4e587c7d15bbd9bafe36d",
      "rawSHA256": "38e119ccc753f7cbdb0b294983b26ab394a3ceda288fd0202d71f9776f4a4c34",
      "version": "V06-protected-broadcast",
      "referenceSHA256": "dd8b89f70ab634af820966c01f3af535adcba7323427866d646c0dc1f6280bf7",
