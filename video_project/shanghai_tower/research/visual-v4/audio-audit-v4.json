      }
    },
    {
      "id": "s006",
      "ratio": 0.8823529411764706,
      "reasons": [
        "ASR字面覆盖低于0.90，优先听审"
      ],
      "displayText": "如果只把重量压在浅层软土上，地基会明显变形。所以，工程师把桩伸进更深的土层。",
      "processedEdges": {
        "leadingSeconds": 0.24,
        "trailingSeconds": 0.41000000000000014,
        "first20msDBFS": -68.38958719099926,
        "last20msDBFS": -92.09363615981916,
        "thresholdDBFS": -48.0
      }
    },
    {
      "id": "s010",
      "ratio": 1.0,
      "reasons": [
        "原始尾部小于80ms；处理后已增加尾部保护"
      ],
      "displayText": "它叫核心筒。电梯、楼梯和不少设备管线，都集中在这片靠近楼中心的区域。",
      "processedEdges": {
        "leadingSeconds": 0.24,
        "trailingSeconds": 0.20999999999999996,
        "first20msDBFS": -112.42734153568034,
        "last20msDBFS": -240.0,
        "thresholdDBFS": -48.0
      }
    },
    {
      "id": "s012",
      "ratio": 0.8928571428571429,
      "reasons": [
        "ASR字面覆盖低于0.90，优先听审"
      ],
      "displayText": "钢材和混凝土一起工作：往下，接住楼层的重量；往侧面，抵抗风的推力。",
      "processedEdges": {
        "leadingSeconds": 0.28,
        "trailingSeconds": 0.9299999999999997,
        "first20msDBFS": -117.45890530509827,
        "last20msDBFS": -240.0,
        "thresholdDBFS": -48.0
      }
    },
    {
      "id": "s013",
      "ratio": 0.8285714285714286,
      "reasons": [
        "ASR字面覆盖低于0.90，优先听审"
      ],
      "displayText": "想象一阵风把楼顶推向一边，核心筒会像竖起的尺子那样弯曲，离地越高，位移越明显。",
      "processedEdges": {
        "leadingSeconds": 0.3,
        "trailingSeconds": 0.41999999999999993,
        "first20msDBFS": -90.05221825634095,
