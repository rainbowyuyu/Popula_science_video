      "ratio": 0.9705882352941176,
      "reasons": [
        "原始尾部小于80ms；处理后已增加尾部保护"
      ],
      "displayText": "把玻璃外衣轻轻揭开，里面远比想象中热闹。楼板、钢梁和粗壮的柱子，一层接着一层。",
      "processedEdges": {
        "leadingSeconds": 0.34,
        "trailingSeconds": 0.20000000000000018,
        "first20msDBFS": -115.32310817975853,
        "last20msDBFS": -240.0,
