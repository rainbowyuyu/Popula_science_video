{
  "version": "v15",
  "kind": "main",
  "fps": 30,
  "durationFrames": 10800,
  "durationSeconds": 360.0,
  "source": "src/timeline-v15.json",
  "entries": [
    {
      "id": "s001",
      "text": "上海中心，六百三十二米。",
      "startFrame": 12,
      "endFrame": 80,
      "startSeconds": 0.4,
      "endSeconds": 2.6666666666666665
    },
    {
      "id": "s001",
      "text": "先把这座楼拆开，",
      "startFrame": 80,
      "endFrame": 128,
      "startSeconds": 2.6666666666666665,
      "endSeconds": 4.266666666666667
    },
    {
      "id": "s001",
      "text": "摊在眼前。看着像一排排重复的构件，",
      "startFrame": 136,
      "endFrame": 215,
      "startSeconds": 4.533333333333333,
      "endSeconds": 7.166666666666667
    },
    {
      "id": "s001",
      "text": "其实每一组都有自己的位置和任务。",
      "startFrame": 215,
      "endFrame": 294,
      "startSeconds": 7.166666666666667,
      "endSeconds": 9.8
    },
    {
      "id": "s001",
      "text": "名字旁边写着它来自哪一段、站在哪个位置，",
      "startFrame": 294,
      "endFrame": 415,
      "startSeconds": 9.8,
      "endSeconds": 13.833333333333334
    },
    {
      "id": "s001",
      "text": "合起来，就是这栋楼的骨架。",
      "startFrame": 415,
      "endFrame": 477,
      "startSeconds": 13.833333333333334,
      "endSeconds": 15.9
    },
    {
      "id": "s002",
      "text": "最外面，玻璃和边框挡住风雨，",
      "startFrame": 488,
      "endFrame": 575,
      "startSeconds": 16.266666666666666,
      "endSeconds": 19.166666666666668
    },
    {
      "id": "s002",
      "text": "围出室内空间。",
      "startFrame": 579,
      "endFrame": 613,
      "startSeconds": 19.3,
      "endSeconds": 20.433333333333334
    },
    {
      "id": "s002",
      "text": "往里一层，楼板接住人和家具，",
      "startFrame": 624,
      "endFrame": 700,
      "startSeconds": 20.8,
      "endSeconds": 23.333333333333332
    },
    {
      "id": "s002",
      "text": "脚下的钢梁再把这些重量，",
      "startFrame": 709,
      "endFrame": 767,
      "startSeconds": 23.633333333333333,
      "endSeconds": 25.566666666666666
    },
    {
      "id": "s002",
      "text": "交给旁边的柱子。",
      "startFrame": 767,
      "endFrame": 816,
      "startSeconds": 25.566666666666666,
      "endSeconds": 27.2
    },
    {
      "id": "s002",
      "text": "人走在上面，",
      "startFrame": 825,
      "endFrame": 851,
      "startSeconds": 27.5,
      "endSeconds": 28.366666666666667
    },
    {
      "id": "s002",
      "text": "看不见这场接力。",
      "startFrame": 862,
      "endFrame": 894,
      "startSeconds": 28.733333333333334,
      "endSeconds": 29.8
    },
    {
      "id": "s003",
      "text": "这些斜着交叉的杆件，",
      "startFrame": 904,
      "endFrame": 957,
      "startSeconds": 30.133333333333333,
      "endSeconds": 31.9
    },
    {
      "id": "s003",
      "text": "就像一座座小钢桥。",
      "startFrame": 957,
      "endFrame": 1008,
      "startSeconds": 31.9,
      "endSeconds": 33.6
    },
    {
      "id": "s003",
      "text": "上下两根横杆，",
      "startFrame": 1020,
      "endFrame": 1051,
      "startSeconds": 34.0,
      "endSeconds": 35.03333333333333
    },
    {
      "id": "s003",
      "text": "分别叫上弦和下弦。",
      "startFrame": 1051,
      "endFrame": 1107,
      "startSeconds": 35.03333333333333,
      "endSeconds": 36.9
    },
    {
      "id": "s003",
      "text": "斜杆把中间连成三角形。",
      "startFrame": 1115,
      "endFrame": 1172,
      "startSeconds": 37.166666666666664,
      "endSeconds": 39.06666666666667
    },
    {
      "id": "s003",
      "text": "伸臂从中间搭到外圈，",
      "startFrame": 1185,
      "endFrame": 1235,
      "startSeconds": 39.5,
      "endSeconds": 41.166666666666664
    },
    {
      "id": "s003",
      "text": "环带沿着周边接力，",
      "startFrame": 1242,
      "endFrame": 1284,
      "startSeconds": 41.4,
      "endSeconds": 42.8
    },
    {
      "id": "s003",
      "text": "把巨柱连成一伙。",
      "startFrame": 1284,
      "endFrame": 1329,
      "startSeconds": 42.8,
      "endSeconds": 44.3
    },
    {
      "id": "s003",
      "text": "风从侧面推来，",
      "startFrame": 1342,
      "endFrame": 1377,
      "startSeconds": 44.733333333333334,
      "endSeconds": 45.9
    },
    {
      "id": "s003",
      "text": "它们就一起分担。",
      "startFrame": 1385,
      "endFrame": 1417,
      "startSeconds": 46.166666666666664,
      "endSeconds": 47.233333333333334
    },
    {
      "id": "s004",
      "text": "中间的厚墙，",
      "startFrame": 1435,
      "endFrame": 1467,
      "startSeconds": 47.833333333333336,
      "endSeconds": 48.9
    },
    {
      "id": "s004",
      "text": "围成核心筒。",
      "startFrame": 1467,
      "endFrame": 1502,
      "startSeconds": 48.9,
      "endSeconds": 50.06666666666667
    },
    {
      "id": "s004",
      "text": "它和外圈巨柱一起，",
      "startFrame": 1511,
      "endFrame": 1545,
      "startSeconds": 50.36666666666667,
      "endSeconds": 51.5
    },
    {
      "id": "s004",
      "text": "把力送往地下的筏板和桩群。",
      "startFrame": 1545,
      "endFrame": 1617,
      "startSeconds": 51.5,
      "endSeconds": 53.9
    },
    {
      "id": "s004",
      "text": "现在，把这些部分放回原位，",
      "startFrame": 1628,
      "endFrame": 1692,
      "startSeconds": 54.266666666666666,
      "endSeconds": 56.4
    },
    {
      "id": "s004",
      "text": "再顺着传力的路，",
      "startFrame": 1700,
      "endFrame": 1729,
      "startSeconds": 56.666666666666664,
      "endSeconds": 57.63333333333333
    },
    {
      "id": "s004",
      "text": "从地下看起。",
      "startFrame": 1729,
      "endFrame": 1770,
      "startSeconds": 57.63333333333333,
      "endSeconds": 59.0
    },
    {
      "id": "s005",
      "text": "先往地下看。",
      "startFrame": 1786,
      "endFrame": 1811,
      "startSeconds": 59.53333333333333,
      "endSeconds": 60.36666666666667
    },
    {
      "id": "s005",
      "text": "上海中心脚下是软土地基，",
      "startFrame": 1820,
      "endFrame": 1862,
      "startSeconds": 60.666666666666664,
      "endSeconds": 62.06666666666667
    },
    {
      "id": "s005",
      "text": "楼越高，地面要接住的重量也越大。",
      "startFrame": 1869,
      "endFrame": 1923,
      "startSeconds": 62.3,
      "endSeconds": 64.1
    },
    {
      "id": "s006",
      "text": "桩伸进更深的土层，",
      "startFrame": 1936,
      "endFrame": 1969,
      "startSeconds": 64.53333333333333,
      "endSeconds": 65.63333333333334
    },
    {
      "id": "s006",
      "text": "楼的重量沿着桩身向下传。",
      "startFrame": 1976,
      "endFrame": 2014,
      "startSeconds": 65.86666666666666,
      "endSeconds": 67.13333333333334
    },
    {
      "id": "s006",
      "text": "周围的土贴着桩身，",
      "startFrame": 2020,
      "endFrame": 2050,
      "startSeconds": 67.33333333333333,
      "endSeconds": 68.33333333333333
    },
    {
      "id": "s006",
      "text": "从侧面提供向上的阻力；",
      "startFrame": 2053,
      "endFrame": 2091,
      "startSeconds": 68.43333333333334,
      "endSeconds": 69.7
    },
    {
      "id": "s006",
      "text": "桩底的土，再托住一部分。",
      "startFrame": 2096,
      "endFrame": 2129,
      "startSeconds": 69.86666666666666,
      "endSeconds": 70.96666666666667
    },
    {
      "id": "s006",
      "text": "这两条传力路线，",
      "startFrame": 2137,
      "endFrame": 2158,
      "startSeconds": 71.23333333333333,
      "endSeconds": 71.93333333333334
    },
    {
      "id": "s006",
      "text": "一起接住上面的重量。",
      "startFrame": 2158,
      "endFrame": 2187,
      "startSeconds": 71.93333333333334,
      "endSeconds": 72.9
    },
    {
      "id": "s007",
      "text": "再看一根独立的桩模型，",
      "startFrame": 2200,
      "endFrame": 2237,
      "startSeconds": 73.33333333333333,
      "endSeconds": 74.56666666666666
    },
    {
      "id": "s007",
      "text": "给它一段变化的侧向推力。",
      "startFrame": 2246,
      "endFrame": 2279,
      "startSeconds": 74.86666666666666,
      "endSeconds": 75.96666666666667
    },
    {
      "id": "s007",
      "text": "桩头先移动，",
      "startFrame": 2285,
      "endFrame": 2304,
      "startSeconds": 76.16666666666667,
      "endSeconds": 76.8
    },
    {
      "id": "s007",
      "text": "桩身跟着弯曲，",
      "startFrame": 2312,
      "endFrame": 2332,
      "startSeconds": 77.06666666666666,
      "endSeconds": 77.73333333333333
    },
    {
      "id": "s007",
      "text": "周围的土沿着深度抵住它。",
      "startFrame": 2339,
      "endFrame": 2378,
      "startSeconds": 77.96666666666667,
      "endSeconds": 79.26666666666667
    },
    {
      "id": "s007",
      "text": "颜色把桩身的受力标出来，",
      "startFrame": 2385,
      "endFrame": 2421,
      "startSeconds": 79.5,
      "endSeconds": 80.7
    },
    {
      "id": "s007",
      "text": "哪一段更吃力，",
      "startFrame": 2427,
      "endFrame": 2446,
      "startSeconds": 80.9,
      "endSeconds": 81.53333333333333
    },
    {
      "id": "s007",
      "text": "就更容易看清。",
      "startFrame": 2446,
      "endFrame": 2471,
      "startSeconds": 81.53333333333333,
      "endSeconds": 82.36666666666666
    },
    {
      "id": "s007",
      "text": "推力撤掉以后，",
      "startFrame": 2482,
      "endFrame": 2504,
      "startSeconds": 82.73333333333333,
      "endSeconds": 83.46666666666667
    },
    {
      "id": "s007",
      "text": "桩还会轻轻摆几下，",
      "startFrame": 2510,
      "endFrame": 2537,
      "startSeconds": 83.66666666666667,
      "endSeconds": 84.56666666666666
    },
    {
      "id": "s007",
      "text": "能量逐渐耗散。",
      "startFrame": 2545,
      "endFrame": 2567,
      "startSeconds": 84.83333333333333,
      "endSeconds": 85.56666666666666
    },
    {
      "id": "s007",
      "text": "这是一根桩的计算例子，",
      "startFrame": 2574,
      "endFrame": 2604,
      "startSeconds": 85.8,
      "endSeconds": 86.8
    },
    {
      "id": "s007",
      "text": "用来读懂桩和土怎样配合。",
      "startFrame": 2609,
      "endFrame": 2649,
      "startSeconds": 86.96666666666667,
      "endSeconds": 88.3
    },
    {
      "id": "s008",
      "text": "桩的上面，是厚达六米的基础底板。",
      "startFrame": 2657,
      "endFrame": 2721,
      "startSeconds": 88.56666666666666,
      "endSeconds": 90.7
    },
    {
      "id": "s008",
      "text": "你可以把它理解成一块厚底盘，",
      "startFrame": 2725,
      "endFrame": 2764,
      "startSeconds": 90.83333333333333,
      "endSeconds": 92.13333333333334
    },
    {
      "id": "s008",
      "text": "把基础连成整体。",
      "startFrame": 2767,
      "endFrame": 2793,
      "startSeconds": 92.23333333333333,
      "endSeconds": 93.1
    },
    {
      "id": "s009",
      "text": "这块厚底盘把桩和大楼连在一起。",
      "startFrame": 2807,
      "endFrame": 2859,
      "startSeconds": 93.56666666666666,
      "endSeconds": 95.3
    },
    {
      "id": "s009",
      "text": "顺着它往上，",
      "startFrame": 2866,
      "endFrame": 2883,
      "startSeconds": 95.53333333333333,
      "endSeconds": 96.1
    },
    {
      "id": "s009",
      "text": "是一根贯穿大楼的硬骨头。",
      "startFrame": 2883,
      "endFrame": 2922,
      "startSeconds": 96.1,
      "endSeconds": 97.4
    },
    {
      "id": "s010",
      "text": "它叫核心筒。",
      "startFrame": 2936,
      "endFrame": 2959,
      "startSeconds": 97.86666666666666,
      "endSeconds": 98.63333333333334
    },
    {
      "id": "s010",
      "text": "电梯、楼梯和不少设备管线，",
      "startFrame": 2963,
      "endFrame": 3012,
      "startSeconds": 98.76666666666667,
      "endSeconds": 100.4
    },
    {
      "id": "s010",
      "text": "都集中在这片靠近楼中心的区域。",
      "startFrame": 3012,
      "endFrame": 3062,
      "startSeconds": 100.4,
      "endSeconds": 102.06666666666666
    },
    {
      "id": "s011",
      "text": "从上面看，底部排着九个格子，",
      "startFrame": 3069,
      "endFrame": 3119,
      "startSeconds": 102.3,
      "endSeconds": 103.96666666666667
    },
    {
      "id": "s011",
      "text": "像一个九宫格。",
      "startFrame": 3122,
      "endFrame": 3142,
      "startSeconds": 104.06666666666666,
      "endSeconds": 104.73333333333333
    },
    {
      "id": "s011",
      "text": "里面的墙和外围的墙连在一起，",
      "startFrame": 3148,
      "endFrame": 3192,
      "startSeconds": 104.93333333333334,
      "endSeconds": 106.4
    },
    {
      "id": "s011",
      "text": "让它更难被推弯。",
      "startFrame": 3198,
      "endFrame": 3221,
      "startSeconds": 106.6,
      "endSeconds": 107.36666666666666
    },
    {
      "id": "s012",
      "text": "钢材和混凝土，",
      "startFrame": 3237,
      "endFrame": 3262,
      "startSeconds": 107.9,
      "endSeconds": 108.73333333333333
    },
    {
      "id": "s012",
      "text": "一起承担楼层的重量，",
      "startFrame": 3262,
      "endFrame": 3296,
      "startSeconds": 108.73333333333333,
      "endSeconds": 109.86666666666666
    },
    {
      "id": "s012",
      "text": "也抵抗从侧面吹来的风。",
      "startFrame": 3296,
      "endFrame": 3335,
      "startSeconds": 109.86666666666666,
      "endSeconds": 111.16666666666667
    },
    {
      "id": "s013",
      "text": "风把楼顶推向一边，",
      "startFrame": 3349,
      "endFrame": 3384,
      "startSeconds": 111.63333333333334,
      "endSeconds": 112.8
    },
    {
      "id": "s013",
      "text": "核心筒会像竖起的尺子那样弯曲，",
      "startFrame": 3391,
      "endFrame": 3437,
      "startSeconds": 113.03333333333333,
      "endSeconds": 114.56666666666666
    },
    {
      "id": "s013",
      "text": "越高的位置移动越明显。",
      "startFrame": 3442,
      "endFrame": 3481,
      "startSeconds": 114.73333333333333,
      "endSeconds": 116.03333333333333
    },
    {
      "id": "s013",
      "text": "画面放大了位移，",
      "startFrame": 3484,
      "endFrame": 3507,
      "startSeconds": 116.13333333333334,
      "endSeconds": 116.9
    },
    {
      "id": "s013",
      "text": "旁边的直线保留原来的位置，",
      "startFrame": 3513,
      "endFrame": 3552,
      "startSeconds": 117.1,
      "endSeconds": 118.4
    },
    {
      "id": "s013",
      "text": "两相对照，就能看清它怎样变形。",
      "startFrame": 3554,
      "endFrame": 3605,
      "startSeconds": 118.46666666666667,
      "endSeconds": 120.16666666666667
    },
    {
      "id": "s014",
      "text": "只靠中间这根硬骨头，",
      "startFrame": 3614,
      "endFrame": 3646,
      "startSeconds": 120.46666666666667,
      "endSeconds": 121.53333333333333
    },
    {
      "id": "s014",
      "text": "离六百多米的目标还差一把力。",
      "startFrame": 3650,
      "endFrame": 3690,
      "startSeconds": 121.66666666666667,
      "endSeconds": 123.0
    },
    {
      "id": "s014",
      "text": "帮手就在钢梁另一头，",
      "startFrame": 3697,
      "endFrame": 3733,
      "startSeconds": 123.23333333333333,
      "endSeconds": 124.43333333333334
    },
    {
      "id": "s014",
      "text": "大楼的外圈。",
      "startFrame": 3738,
      "endFrame": 3756,
      "startSeconds": 124.6,
      "endSeconds": 125.2
    },
    {
      "id": "s015",
      "text": "这些粗壮的柱子，",
      "startFrame": 3765,
      "endFrame": 3793,
      "startSeconds": 125.5,
      "endSeconds": 126.43333333333334
    },
    {
      "id": "s015",
      "text": "叫巨型柱。它们和中间的骨架，",
      "startFrame": 3793,
      "endFrame": 3840,
      "startSeconds": 126.43333333333334,
      "endSeconds": 128.0
    },
    {
      "id": "s015",
      "text": "一起承担整座建筑的重量。",
      "startFrame": 3840,
      "endFrame": 3879,
      "startSeconds": 128.0,
      "endSeconds": 129.3
    },
    {
      "id": "s016",
      "text": "楼板接住人和设备的重量，",
      "startFrame": 3889,
      "endFrame": 3934,
      "startSeconds": 129.63333333333333,
      "endSeconds": 131.13333333333333
    },
    {
      "id": "s016",
      "text": "钢梁把这些重量交给柱子和中间的骨架，",
      "startFrame": 3942,
      "endFrame": 3997,
      "startSeconds": 131.4,
      "endSeconds": 133.23333333333332
    },
    {
      "id": "s016",
      "text": "一路传进基础。",
      "startFrame": 4000,
      "endFrame": 4022,
      "startSeconds": 133.33333333333334,
      "endSeconds": 134.06666666666666
    },
    {
      "id": "s017",
      "text": "遇到侧面的气流，",
      "startFrame": 4033,
      "endFrame": 4064,
      "startSeconds": 134.43333333333334,
      "endSeconds": 135.46666666666667
    },
    {
      "id": "s017",
      "text": "光有几根各自立着的柱子还不够，",
      "startFrame": 4068,
      "endFrame": 4114,
      "startSeconds": 135.6,
      "endSeconds": 137.13333333333333
    },
    {
      "id": "s017",
      "text": "它们需要和中间的骨架拉起手来。",
      "startFrame": 4120,
      "endFrame": 4164,
      "startSeconds": 137.33333333333334,
      "endSeconds": 138.8
    },
    {
      "id": "s018",
      "text": "把两边接起来的，",
      "startFrame": 4171,
      "endFrame": 4198,
      "startSeconds": 139.03333333333333,
      "endSeconds": 139.93333333333334
    },
    {
      "id": "s018",
      "text": "是伸臂钢架。",
      "startFrame": 4202,
      "endFrame": 4222,
      "startSeconds": 140.06666666666666,
      "endSeconds": 140.73333333333332
    },
    {
      "id": "s018",
      "text": "先拆开看：上下两条横杆，",
      "startFrame": 4226,
      "endFrame": 4272,
      "startSeconds": 140.86666666666667,
      "endSeconds": 142.4
    },
    {
      "id": "s018",
      "text": "叫上弦和下弦；",
      "startFrame": 4277,
      "endFrame": 4305,
      "startSeconds": 142.56666666666666,
      "endSeconds": 143.5
    },
    {
      "id": "s018",
      "text": "中间的斜杆，",
      "startFrame": 4312,
      "endFrame": 4330,
      "startSeconds": 143.73333333333332,
      "endSeconds": 144.33333333333334
    },
    {
      "id": "s018",
      "text": "把它们连成一个个三角形。",
      "startFrame": 4334,
      "endFrame": 4366,
      "startSeconds": 144.46666666666667,
      "endSeconds": 145.53333333333333
    },
    {
      "id": "s018",
      "text": "上下弦连住两端，",
      "startFrame": 4374,
      "endFrame": 4400,
      "startSeconds": 145.8,
      "endSeconds": 146.66666666666666
    },
    {
      "id": "s018",
      "text": "斜杆撑在中间。",
      "startFrame": 4406,
      "endFrame": 4428,
      "startSeconds": 146.86666666666667,
      "endSeconds": 147.6
    },
    {
      "id": "s018",
      "text": "楼一弯，这些连接就把力传到外圈。",
      "startFrame": 4435,
      "endFrame": 4490,
      "startSeconds": 147.83333333333334,
      "endSeconds": 149.66666666666666
    },
    {
      "id": "s018",
      "text": "合起来以后，",
      "startFrame": 4499,
      "endFrame": 4516,
      "startSeconds": 149.96666666666667,
      "endSeconds": 150.53333333333333
    },
    {
      "id": "s018",
      "text": "这座小钢桥就能把核心筒和外圈柱连在一起。",
      "startFrame": 4521,
      "endFrame": 4585,
      "startSeconds": 150.7,
      "endSeconds": 152.83333333333334
    },
    {
      "id": "s018",
      "text": "上海中心的六处关键高度，",
      "startFrame": 4595,
      "endFrame": 4629,
      "startSeconds": 153.16666666666666,
      "endSeconds": 154.3
    },
    {
      "id": "s018",
      "text": "都有这种钢架。",
      "startFrame": 4629,
      "endFrame": 4653,
      "startSeconds": 154.3,
      "endSeconds": 155.1
    },
    {
      "id": "s019",
      "text": "核心筒向一边弯，",
      "startFrame": 4661,
      "endFrame": 4687,
      "startSeconds": 155.36666666666667,
      "endSeconds": 156.23333333333332
    },
    {
      "id": "s019",
      "text": "就会带着伸臂一起转动。",
      "startFrame": 4687,
      "endFrame": 4722,
      "startSeconds": 156.23333333333332,
      "endSeconds": 157.4
    },
    {
      "id": "s019",
      "text": "伸臂的一头向下压，",
      "startFrame": 4722,
      "endFrame": 4757,
      "startSeconds": 157.4,
      "endSeconds": 158.56666666666666
    },
    {
      "id": "s019",
      "text": "另一头向上提，",
      "startFrame": 4761,
      "endFrame": 4780,
      "startSeconds": 158.7,
      "endSeconds": 159.33333333333334
    },
    {
      "id": "s019",
      "text": "这个动作把外圈的巨型柱也调动起来。",
      "startFrame": 4785,
      "endFrame": 4842,
      "startSeconds": 159.5,
      "endSeconds": 161.4
    },
    {
      "id": "s019",
      "text": "看这两根斜杆的颜色，",
      "startFrame": 4842,
      "endFrame": 4875,
      "startSeconds": 161.4,
      "endSeconds": 162.5
    },
    {
      "id": "s019",
      "text": "就能看见这一刻的受力变化。",
      "startFrame": 4875,
      "endFrame": 4917,
      "startSeconds": 162.5,
      "endSeconds": 163.9
    },
    {
      "id": "s020",
      "text": "橙色，表示向受压方向变化；",
      "startFrame": 4925,
      "endFrame": 4976,
      "startSeconds": 164.16666666666666,
      "endSeconds": 165.86666666666667
    },
    {
      "id": "s020",
      "text": "蓝色，表示向受拉方向变化。",
      "startFrame": 4982,
      "endFrame": 5026,
      "startSeconds": 166.06666666666666,
      "endSeconds": 167.53333333333333
    },
    {
      "id": "s020",
      "text": "这张色图，读的是风带来的增量。",
      "startFrame": 5031,
      "endFrame": 5078,
      "startSeconds": 167.7,
      "endSeconds": 169.26666666666668
    },
    {
      "id": "s020",
      "text": "再看外圈的柱子，",
      "startFrame": 5085,
      "endFrame": 5108,
      "startSeconds": 169.5,
      "endSeconds": 170.26666666666668
    },
    {
      "id": "s020",
      "text": "它原本还压着整栋楼的重量。",
      "startFrame": 5112,
      "endFrame": 5150,
      "startSeconds": 170.4,
      "endSeconds": 171.66666666666666
    },
    {
      "id": "s020",
      "text": "压力减小的一边，",
      "startFrame": 5155,
      "endFrame": 5177,
      "startSeconds": 171.83333333333334,
      "endSeconds": 172.56666666666666
    },
    {
      "id": "s020",
      "text": "也可能仍然在受压。",
      "startFrame": 5177,
      "endFrame": 5209,
      "startSeconds": 172.56666666666666,
      "endSeconds": 173.63333333333333
    },
    {
      "id": "s021",
      "text": "伸臂把力带到外圈，",
      "startFrame": 5222,
      "endFrame": 5257,
      "startSeconds": 174.06666666666666,
      "endSeconds": 175.23333333333332
    },
    {
      "id": "s021",
      "text": "环带钢架再沿着周边，",
      "startFrame": 5263,
      "endFrame": 5294,
      "startSeconds": 175.43333333333334,
      "endSeconds": 176.46666666666667
    },
    {
      "id": "s021",
      "text": "把这份力分给更多柱子。",
      "startFrame": 5300,
      "endFrame": 5334,
      "startSeconds": 176.66666666666666,
      "endSeconds": 177.8
    },
    {
      "id": "s021",
      "text": "中间、外圈和上下楼层相互连接，",
      "startFrame": 5338,
      "endFrame": 5391,
      "startSeconds": 177.93333333333334,
      "endSeconds": 179.7
    },
    {
      "id": "s021",
      "text": "大楼就能借整个宽度，",
      "startFrame": 5396,
      "endFrame": 5426,
      "startSeconds": 179.86666666666667,
      "endSeconds": 180.86666666666667
    },
    {
      "id": "s021",
      "text": "抵抗侧面的推力。",
      "startFrame": 5426,
      "endFrame": 5456,
      "startSeconds": 180.86666666666667,
      "endSeconds": 181.86666666666667
    },
    {
      "id": "s022",
      "text": "骨架站稳以后，",
      "startFrame": 5471,
      "endFrame": 5497,
      "startSeconds": 182.36666666666667,
      "endSeconds": 183.23333333333332
    },
    {
      "id": "s022",
      "text": "人要怎样在里面生活？",
      "startFrame": 5503,
      "endFrame": 5528,
      "startSeconds": 183.43333333333334,
      "endSeconds": 184.26666666666668
    },
    {
      "id": "s022",
      "text": "上海中心把很高的一栋楼，",
      "startFrame": 5535,
      "endFrame": 5569,
      "startSeconds": 184.5,
      "endSeconds": 185.63333333333333
    },
    {
      "id": "s022",
      "text": "分成了九个垂直分区。",
      "startFrame": 5569,
      "endFrame": 5604,
      "startSeconds": 185.63333333333333,
      "endSeconds": 186.8
    },
    {
      "id": "s023",
      "text": "每一段都有自己的活动空间，",
      "startFrame": 5616,
      "endFrame": 5659,
      "startSeconds": 187.2,
      "endSeconds": 188.63333333333333
    },
    {
      "id": "s023",
      "text": "分区之间设置空中大堂和公共空间，",
      "startFrame": 5664,
      "endFrame": 5718,
      "startSeconds": 188.8,
      "endSeconds": 190.6
    },
    {
      "id": "s023",
      "text": "像把街区往上叠起来。",
      "startFrame": 5723,
      "endFrame": 5756,
      "startSeconds": 190.76666666666668,
      "endSeconds": 191.86666666666667
    },
    {
      "id": "s024",
      "text": "从街上看到的，",
      "startFrame": 5768,
      "endFrame": 5796,
      "startSeconds": 192.26666666666668,
      "endSeconds": 193.2
    },
    {
      "id": "s024",
      "text": "是外面的玻璃；",
      "startFrame": 5799,
      "endFrame": 5820,
      "startSeconds": 193.3,
      "endSeconds": 194.0
    },
    {
      "id": "s024",
      "text": "人真正活动的房间，",
      "startFrame": 5824,
      "endFrame": 5851,
      "startSeconds": 194.13333333333333,
      "endSeconds": 195.03333333333333
    },
    {
      "id": "s024",
      "text": "包在更里面一层。",
      "startFrame": 5851,
      "endFrame": 5881,
      "startSeconds": 195.03333333333333,
      "endSeconds": 196.03333333333333
    },
    {
      "id": "s025",
      "text": "靠里的玻璃围住使用空间，",
      "startFrame": 5893,
      "endFrame": 5938,
      "startSeconds": 196.43333333333334,
      "endSeconds": 197.93333333333334
    },
    {
      "id": "s025",
      "text": "外层玻璃包住整座塔，",
      "startFrame": 5945,
      "endFrame": 5980,
      "startSeconds": 198.16666666666666,
      "endSeconds": 199.33333333333334
    },
    {
      "id": "s025",
      "text": "两层玻璃之间空出了高大的中庭。",
      "startFrame": 5987,
      "endFrame": 6035,
      "startSeconds": 199.56666666666666,
      "endSeconds": 201.16666666666666
    },
    {
      "id": "s026",
      "text": "阳光可以照进来，",
      "startFrame": 6049,
      "endFrame": 6077,
      "startSeconds": 201.63333333333333,
      "endSeconds": 202.56666666666666
    },
    {
      "id": "s026",
      "text": "外界的冷热又多经过一层缓冲。",
      "startFrame": 6080,
      "endFrame": 6126,
      "startSeconds": 202.66666666666666,
      "endSeconds": 204.2
    },
    {
      "id": "s026",
      "text": "这些空间，也给高空里的日常生活留了余地。",
      "startFrame": 6130,
      "endFrame": 6193,
      "startSeconds": 204.33333333333334,
      "endSeconds": 206.43333333333334
    },
    {
      "id": "s027",
      "text": "再回头看外形：",
      "startFrame": 6206,
      "endFrame": 6233,
      "startSeconds": 206.86666666666667,
      "endSeconds": 207.76666666666668
    },
    {
      "id": "s027",
      "text": "圆润的三角轮廓，",
      "startFrame": 6240,
      "endFrame": 6266,
      "startSeconds": 208.0,
      "endSeconds": 208.86666666666667
    },
    {
      "id": "s027",
      "text": "一边向上收小，",
      "startFrame": 6269,
      "endFrame": 6292,
      "startSeconds": 208.96666666666667,
      "endSeconds": 209.73333333333332
    },
    {
      "id": "s027",
      "text": "一边旋转，最终一共转过一百二十度。",
      "startFrame": 6295,
      "endFrame": 6349,
      "startSeconds": 209.83333333333334,
      "endSeconds": 211.63333333333333
    },
    {
      "id": "s028",
      "text": "这一扭，改变了风撞上大楼的方式。",
      "startFrame": 6356,
      "endFrame": 6415,
      "startSeconds": 211.86666666666667,
      "endSeconds": 213.83333333333334
    },
    {
      "id": "s028",
      "text": "越往高处走，",
      "startFrame": 6422,
      "endFrame": 6440,
      "startSeconds": 214.06666666666666,
      "endSeconds": 214.66666666666666
    },
    {
      "id": "s028",
      "text": "迎风的轮廓就越不一样。",
      "startFrame": 6444,
      "endFrame": 6475,
      "startSeconds": 214.8,
      "endSeconds": 215.83333333333334
    },
    {
      "id": "s029",
      "text": "同样的来风，",
      "startFrame": 6492,
      "endFrame": 6516,
      "startSeconds": 216.4,
      "endSeconds": 217.2
    },
    {
      "id": "s029",
      "text": "碰到大楼不同的位置，",
      "startFrame": 6525,
      "endFrame": 6552,
      "startSeconds": 217.5,
      "endSeconds": 218.4
    },
    {
      "id": "s029",
      "text": "效果很不一样。",
      "startFrame": 6558,
      "endFrame": 6577,
      "startSeconds": 218.6,
      "endSeconds": 219.23333333333332
    },
    {
      "id": "s029",
      "text": "先看表面的平均风压：",
      "startFrame": 6583,
      "endFrame": 6615,
      "startSeconds": 219.43333333333334,
      "endSeconds": 220.5
    },
    {
      "id": "s029",
      "text": "迎风的一面受到推压，",
      "startFrame": 6621,
      "endFrame": 6650,
      "startSeconds": 220.7,
      "endSeconds": 221.66666666666666
    },
    {
      "id": "s029",
      "text": "气流绕过转角，",
      "startFrame": 6654,
      "endFrame": 6676,
      "startSeconds": 221.8,
      "endSeconds": 222.53333333333333
    },
    {
      "id": "s029",
      "text": "侧面和背面的压力也会改变。",
      "startFrame": 6681,
      "endFrame": 6720,
      "startSeconds": 222.7,
      "endSeconds": 224.0
    },
    {
      "id": "s029",
      "text": "把颜色贴在表面，",
      "startFrame": 6727,
      "endFrame": 6751,
      "startSeconds": 224.23333333333332,
      "endSeconds": 225.03333333333333
    },
    {
      "id": "s029",
      "text": "就能看见哪一片在被推，",
      "startFrame": 6754,
      "endFrame": 6783,
      "startSeconds": 225.13333333333333,
      "endSeconds": 226.1
    },
    {
      "id": "s029",
      "text": "哪一片在被向外吸。",
      "startFrame": 6792,
      "endFrame": 6819,
      "startSeconds": 226.4,
      "endSeconds": 227.3
    },
    {
      "id": "s030",
      "text": "先把空气横着切开，",
      "startFrame": 6833,
      "endFrame": 6866,
      "startSeconds": 227.76666666666668,
      "endSeconds": 228.86666666666667
    },
    {
      "id": "s030",
      "text": "停在一百米高处。",
      "startFrame": 6871,
      "endFrame": 6893,
      "startSeconds": 229.03333333333333,
      "endSeconds": 229.76666666666668
    },
    {
      "id": "s030",
      "text": "看平均风速：",
      "startFrame": 6896,
      "endFrame": 6916,
      "startSeconds": 229.86666666666667,
      "endSeconds": 230.53333333333333
    },
    {
      "id": "s030",
      "text": "来风迎上大楼，",
      "startFrame": 6916,
      "endFrame": 6944,
      "startSeconds": 230.53333333333333,
      "endSeconds": 231.46666666666667
    },
    {
      "id": "s030",
      "text": "再从两边绕过去，",
      "startFrame": 6949,
      "endFrame": 6976,
      "startSeconds": 231.63333333333333,
      "endSeconds": 232.53333333333333
    },
    {
      "id": "s030",
      "text": "背后留下一片较慢的区域。",
      "startFrame": 6980,
      "endFrame": 7015,
      "startSeconds": 232.66666666666666,
      "endSeconds": 233.83333333333334
    },
    {
      "id": "s030",
      "text": "切面升到三百米，",
      "startFrame": 7021,
      "endFrame": 7046,
      "startSeconds": 234.03333333333333,
      "endSeconds": 234.86666666666667
    },
    {
      "id": "s030",
      "text": "楼的轮廓已经转了一个角度。",
      "startFrame": 7052,
      "endFrame": 7089,
      "startSeconds": 235.06666666666666,
      "endSeconds": 236.3
    },
    {
      "id": "s030",
      "text": "来风方向没变，",
      "startFrame": 7093,
      "endFrame": 7114,
      "startSeconds": 236.43333333333334,
      "endSeconds": 237.13333333333333
    },
    {
      "id": "s030",
      "text": "气流遇到的转角却变了，",
      "startFrame": 7120,
      "endFrame": 7151,
      "startSeconds": 237.33333333333334,
      "endSeconds": 238.36666666666667
    },
    {
      "id": "s030",
      "text": "绕行路线也跟着变化。",
      "startFrame": 7155,
      "endFrame": 7186,
      "startSeconds": 238.5,
      "endSeconds": 239.53333333333333
    },
    {
      "id": "s030",
      "text": "再升到五百米，",
      "startFrame": 7192,
      "endFrame": 7213,
      "startSeconds": 239.73333333333332,
      "endSeconds": 240.43333333333334
    },
    {
      "id": "s030",
      "text": "塔身收得更细，",
      "startFrame": 7217,
      "endFrame": 7237,
      "startSeconds": 240.56666666666666,
      "endSeconds": 241.23333333333332
    },
    {
      "id": "s030",
      "text": "方向又不一样。",
      "startFrame": 7241,
      "endFrame": 7260,
      "startSeconds": 241.36666666666667,
      "endSeconds": 242.0
    },
    {
      "id": "s030",
      "text": "沿着同一套颜色比较，",
      "startFrame": 7267,
      "endFrame": 7294,
      "startSeconds": 242.23333333333332,
      "endSeconds": 243.13333333333333
    },
    {
      "id": "s030",
      "text": "就能看见三个高度的风，",
      "startFrame": 7299,
      "endFrame": 7329,
      "startSeconds": 243.3,
      "endSeconds": 244.3
    },
    {
      "id": "s030",
      "text": "分别从哪里经过。",
      "startFrame": 7334,
      "endFrame": 7355,
      "startSeconds": 244.46666666666667,
      "endSeconds": 245.16666666666666
    },
    {
      "id": "s031",
      "text": "再把切面竖起来，",
      "startFrame": 7363,
      "endFrame": 7396,
      "startSeconds": 245.43333333333334,
      "endSeconds": 246.53333333333333
    },
    {
      "id": "s031",
      "text": "沿着来风的方向，",
      "startFrame": 7398,
      "endFrame": 7418,
      "startSeconds": 246.6,
      "endSeconds": 247.26666666666668
    },
    {
      "id": "s031",
      "text": "穿过塔身中间。",
      "startFrame": 7418,
      "endFrame": 7448,
      "startSeconds": 247.26666666666668,
      "endSeconds": 248.26666666666668
    },
    {
      "id": "s031",
      "text": "楼前、楼顶和背后的空气，",
      "startFrame": 7448,
      "endFrame": 7491,
      "startSeconds": 248.26666666666668,
      "endSeconds": 249.7
    },
    {
      "id": "s031",
      "text": "就连在同一张图里了。",
      "startFrame": 7491,
      "endFrame": 7525,
      "startSeconds": 249.7,
      "endSeconds": 250.83333333333334
    },
    {
      "id": "s031",
      "text": "顺着塔身往上看，",
      "startFrame": 7525,
      "endFrame": 7557,
      "startSeconds": 250.83333333333334,
      "endSeconds": 251.9
    },
    {
      "id": "s031",
      "text": "我们能看清楼顶上方的风怎样越过去，",
      "startFrame": 7563,
      "endFrame": 7614,
      "startSeconds": 252.1,
      "endSeconds": 253.8
    },
    {
      "id": "s031",
      "text": "大楼后面的气流，",
      "startFrame": 7614,
      "endFrame": 7642,
      "startSeconds": 253.8,
      "endSeconds": 254.73333333333332
    },
    {
      "id": "s031",
      "text": "又在哪些地方慢了下来。",
      "startFrame": 7642,
      "endFrame": 7677,
      "startSeconds": 254.73333333333332,
      "endSeconds": 255.9
    },
    {
      "id": "s032",
      "text": "在风洞里，工程师比较过多种方案，",
      "startFrame": 7683,
      "endFrame": 7739,
      "startSeconds": 256.1,
      "endSeconds": 257.96666666666664
    },
    {
      "id": "s032",
      "text": "最后选定一百二十度的扭转。",
      "startFrame": 7744,
      "endFrame": 7780,
      "startSeconds": 258.1333333333333,
      "endSeconds": 259.3333333333333
    },
    {
      "id": "s032",
      "text": "接下来，再给里面的骨架一段变化的侧向推力，",
      "startFrame": 7786,
      "endFrame": 7847,
      "startSeconds": 259.53333333333336,
      "endSeconds": 261.56666666666666
    },
    {
      "id": "s032",
      "text": "看它怎样弯曲，",
      "startFrame": 7850,
      "endFrame": 7870,
      "startSeconds": 261.6666666666667,
      "endSeconds": 262.3333333333333
    },
    {
      "id": "s032",
      "text": "怎样把这份力沿着连接，",
      "startFrame": 7876,
      "endFrame": 7910,
      "startSeconds": 262.53333333333336,
      "endSeconds": 263.6666666666667
    },
    {
      "id": "s032",
      "text": "一直送回地下。",
      "startFrame": 7913,
      "endFrame": 7932,
      "startSeconds": 263.76666666666665,
      "endSeconds": 264.4
    },
    {
      "id": "s033",
      "text": "看两侧柱子的颜色：",
      "startFrame": 7946,
      "endFrame": 7976,
      "startSeconds": 264.8666666666667,
      "endSeconds": 265.8666666666667
    },
    {
      "id": "s033",
      "text": "气流一推，一边压得更多，",
      "startFrame": 7982,
      "endFrame": 8018,
      "startSeconds": 266.06666666666666,
      "endSeconds": 267.26666666666665
    },
    {
      "id": "s033",
      "text": "另一边压得更少。",
      "startFrame": 8023,
      "endFrame": 8046,
      "startSeconds": 267.43333333333334,
      "endSeconds": 268.2
    },
    {
      "id": "s033",
      "text": "力顺着相连的部件，",
      "startFrame": 8053,
      "endFrame": 8080,
      "startSeconds": 268.43333333333334,
      "endSeconds": 269.3333333333333
    },
    {
      "id": "s033",
      "text": "一路传回基础。",
      "startFrame": 8080,
      "endFrame": 8107,
      "startSeconds": 269.3333333333333,
      "endSeconds": 270.23333333333335
    },
    {
      "id": "s034",
      "text": "楼站得稳，人坐在高处，",
      "startFrame": 8118,
      "endFrame": 8166,
      "startSeconds": 270.6,
      "endSeconds": 272.2
    },
    {
      "id": "s034",
      "text": "却仍然可能觉得晃。",
      "startFrame": 8168,
      "endFrame": 8193,
      "startSeconds": 272.26666666666665,
      "endSeconds": 273.1
    },
    {
      "id": "s034",
      "text": "到了这里，工程师还要照顾另一件事：",
      "startFrame": 8202,
      "endFrame": 8254,
      "startSeconds": 273.4,
      "endSeconds": 275.1333333333333
    },
    {
      "id": "s034",
      "text": "让人的感觉也稳下来。",
      "startFrame": 8259,
      "endFrame": 8291,
      "startSeconds": 275.3,
      "endSeconds": 276.3666666666667
    },
    {
      "id": "s035",
      "text": "这位帮手，叫调好频率的质量阻尼器。",
      "startFrame": 8301,
      "endFrame": 8364,
      "startSeconds": 276.7,
      "endSeconds": 278.8
    },
    {
      "id": "s035",
      "text": "上海中心楼顶悬着一块约一千吨的重物，",
      "startFrame": 8372,
      "endFrame": 8430,
      "startSeconds": 279.06666666666666,
      "endSeconds": 281.0
    },
    {
      "id": "s035",
      "text": "能相对大楼来回摆动。",
      "startFrame": 8433,
      "endFrame": 8465,
      "startSeconds": 281.1,
      "endSeconds": 282.1666666666667
    },
    {
      "id": "s036",
      "text": "气流把大楼推得左右摇，",
      "startFrame": 8483,
      "endFrame": 8525,
      "startSeconds": 282.76666666666665,
      "endSeconds": 284.1666666666667
    },
    {
      "id": "s036",
      "text": "重物就跟着相对摆动。",
      "startFrame": 8531,
      "endFrame": 8561,
      "startSeconds": 284.3666666666667,
      "endSeconds": 285.3666666666667
    },
    {
      "id": "s036",
      "text": "把它的节奏调到合适，",
      "startFrame": 8567,
      "endFrame": 8599,
      "startSeconds": 285.56666666666666,
      "endSeconds": 286.6333333333333
    },
    {
      "id": "s036",
      "text": "就能在运动中牵住大楼，减轻晃动。",
      "startFrame": 8603,
      "endFrame": 8661,
      "startSeconds": 286.76666666666665,
      "endSeconds": 288.7
    },
    {
      "id": "s037",
      "text": "阻尼装置再把一部分运动能量消耗掉。",
      "startFrame": 8675,
      "endFrame": 8734,
      "startSeconds": 289.1666666666667,
      "endSeconds": 291.1333333333333
    },
    {
      "id": "s037",
      "text": "你可以把它理解成：",
      "startFrame": 8740,
      "endFrame": 8762,
      "startSeconds": 291.3333333333333,
      "endSeconds": 292.06666666666666
    },
    {
      "id": "s037",
      "text": "让来回的摇摆，",
      "startFrame": 8767,
      "endFrame": 8787,
      "startSeconds": 292.23333333333335,
      "endSeconds": 292.9
    },
    {
      "id": "s037",
      "text": "一点点平静下来。",
      "startFrame": 8791,
      "endFrame": 8814,
      "startSeconds": 293.03333333333336,
      "endSeconds": 293.8
    },
    {
      "id": "s038",
      "text": "它主要照顾大风天气下的舒适度。",
      "startFrame": 8821,
      "endFrame": 8871,
      "startSeconds": 294.03333333333336,
      "endSeconds": 295.7
    },
    {
      "id": "s038",
      "text": "真正支撑大楼的，",
      "startFrame": 8876,
      "endFrame": 8902,
      "startSeconds": 295.8666666666667,
      "endSeconds": 296.73333333333335
    },
    {
      "id": "s038",
      "text": "还是下面这套一路相连的结构和基础。",
      "startFrame": 8907,
      "endFrame": 8958,
      "startSeconds": 296.9,
      "endSeconds": 298.6
    },
    {
      "id": "s039",
      "text": "现在从顶上往下看，",
      "startFrame": 8965,
      "endFrame": 8999,
      "startSeconds": 298.8333333333333,
      "endSeconds": 299.96666666666664
    },
    {
      "id": "s039",
      "text": "外衣削弱风的影响，",
      "startFrame": 9006,
      "endFrame": 9034,
      "startSeconds": 300.2,
      "endSeconds": 301.1333333333333
    },
    {
      "id": "s039",
      "text": "骨架接住力，",
      "startFrame": 9036,
      "endFrame": 9056,
      "startSeconds": 301.2,
      "endSeconds": 301.8666666666667
    },
    {
      "id": "s039",
      "text": "阻尼器再照顾人的感受，",
      "startFrame": 9061,
      "endFrame": 9100,
      "startSeconds": 302.03333333333336,
      "endSeconds": 303.3333333333333
    },
    {
      "id": "s039",
      "text": "分工就清楚了。",
      "startFrame": 9103,
      "endFrame": 9125,
      "startSeconds": 303.43333333333334,
      "endSeconds": 304.1666666666667
    },
    {
      "id": "s040",
      "text": "这栋楼又是怎么造起来的？",
      "startFrame": 9136,
      "endFrame": 9177,
      "startSeconds": 304.53333333333336,
      "endSeconds": 305.9
    },
    {
      "id": "s040",
      "text": "施工时，核心筒先向上爬升，",
      "startFrame": 9186,
      "endFrame": 9234,
      "startSeconds": 306.2,
      "endSeconds": 307.8
    },
    {
      "id": "s040",
      "text": "后面的工序接着跟上。",
      "startFrame": 9243,
      "endFrame": 9272,
      "startSeconds": 308.1,
      "endSeconds": 309.06666666666666
    },
    {
      "id": "s041",
      "text": "工人站在会自己向上走的钢平台上，",
      "startFrame": 9287,
      "endFrame": 9337,
      "startSeconds": 309.56666666666666,
      "endSeconds": 311.23333333333335
    },
    {
      "id": "s041",
      "text": "一段段把混凝土浇进去。",
      "startFrame": 9337,
      "endFrame": 9377,
      "startSeconds": 311.23333333333335,
      "endSeconds": 312.56666666666666
    },
    {
      "id": "s041",
      "text": "完成这一段，",
      "startFrame": 9381,
      "endFrame": 9401,
      "startSeconds": 312.7,
      "endSeconds": 313.3666666666667
    },
    {
      "id": "s041",
      "text": "平台再上移，",
      "startFrame": 9404,
      "endFrame": 9424,
      "startSeconds": 313.46666666666664,
      "endSeconds": 314.1333333333333
    },
    {
      "id": "s041",
      "text": "接着造下一段。",
      "startFrame": 9429,
      "endFrame": 9451,
      "startSeconds": 314.3,
      "endSeconds": 315.03333333333336
    },
    {
      "id": "s042",
      "text": "巨型柱通常落后中间的骨架六到九层，",
      "startFrame": 9465,
      "endFrame": 9535,
      "startSeconds": 315.5,
      "endSeconds": 317.8333333333333
    },
    {
      "id": "s042",
      "text": "楼面再落后巨型柱四到七层。",
      "startFrame": 9541,
      "endFrame": 9593,
      "startSeconds": 318.03333333333336,
      "endSeconds": 319.76666666666665
    },
    {
      "id": "s042",
      "text": "几个工作面，",
      "startFrame": 9595,
      "endFrame": 9608,
      "startSeconds": 319.8333333333333,
      "endSeconds": 320.26666666666665
    },
    {
      "id": "s042",
      "text": "一前一后，把大楼越盖越高。",
      "startFrame": 9608,
      "endFrame": 9655,
      "startSeconds": 320.26666666666665,
      "endSeconds": 321.8333333333333
    },
    {
      "id": "s043",
      "text": "主体升到大约三分之一高度，",
      "startFrame": 9669,
      "endFrame": 9711,
      "startSeconds": 322.3,
      "endSeconds": 323.7
    },
    {
      "id": "s043",
      "text": "外层玻璃才开始跟进。",
      "startFrame": 9716,
      "endFrame": 9745,
      "startSeconds": 323.8666666666667,
      "endSeconds": 324.8333333333333
    },
    {
      "id": "s043",
      "text": "一块块玻璃装上去，",
      "startFrame": 9751,
      "endFrame": 9777,
      "startSeconds": 325.03333333333336,
      "endSeconds": 325.9
    },
    {
      "id": "s043",
      "text": "连接处还要给结构变形留出空间。",
      "startFrame": 9781,
      "endFrame": 9826,
      "startSeconds": 326.03333333333336,
      "endSeconds": 327.53333333333336
    },
    {
      "id": "s044",
      "text": "连接钢架也要等合适时机再锁定。",
      "startFrame": 9841,
      "endFrame": 9894,
      "startSeconds": 328.03333333333336,
      "endSeconds": 329.8
    },
    {
      "id": "s044",
      "text": "楼心骨架和巨型柱收缩的节奏不同，",
      "startFrame": 9903,
      "endFrame": 9954,
      "startSeconds": 330.1,
      "endSeconds": 331.8
    },
    {
      "id": "s044",
      "text": "连接太早，就会给骨架增加额外的力。",
      "startFrame": 9962,
      "endFrame": 10021,
      "startSeconds": 332.06666666666666,
      "endSeconds": 334.03333333333336
    },
    {
      "id": "s045",
      "text": "当玻璃重新合拢，",
      "startFrame": 10032,
      "endFrame": 10065,
      "startSeconds": 334.4,
      "endSeconds": 335.5
    },
    {
      "id": "s045",
      "text": "那些粗壮的柱子、巨大的钢架，",
      "startFrame": 10068,
      "endFrame": 10110,
      "startSeconds": 335.6,
      "endSeconds": 337.0
    },
    {
      "id": "s045",
      "text": "连同六米厚的底盘，",
      "startFrame": 10110,
      "endFrame": 10143,
      "startSeconds": 337.0,
      "endSeconds": 338.1
    },
    {
      "id": "s045",
      "text": "又都藏了起来。",
      "startFrame": 10143,
      "endFrame": 10163,
      "startSeconds": 338.1,
      "endSeconds": 338.76666666666665
    },
    {
      "id": "s046",
      "text": "这些结构藏进了曲线里，",
      "startFrame": 10173,
      "endFrame": 10214,
      "startSeconds": 339.1,
      "endSeconds": 340.46666666666664
    },
    {
      "id": "s046",
      "text": "却还在一刻不停地接力。",
      "startFrame": 10217,
      "endFrame": 10249,
      "startSeconds": 340.56666666666666,
      "endSeconds": 341.6333333333333
    },
    {
      "id": "s046",
      "text": "楼层的重量向下走，",
      "startFrame": 10256,
      "endFrame": 10285,
      "startSeconds": 341.8666666666667,
      "endSeconds": 342.8333333333333
    },
    {
      "id": "s046",
      "text": "风的推力沿框架散开，",
      "startFrame": 10290,
      "endFrame": 10324,
      "startSeconds": 343.0,
      "endSeconds": 344.1333333333333
    },
    {
      "id": "s046",
      "text": "最后都交到脚下的土地。",
      "startFrame": 10331,
      "endFrame": 10362,
      "startSeconds": 344.3666666666667,
      "endSeconds": 345.4
    },
    {
      "id": "s047",
      "text": "六百三十二米的高度，",
      "startFrame": 10368,
      "endFrame": 10398,
      "startSeconds": 345.6,
      "endSeconds": 346.6
    },
    {
      "id": "s047",
      "text": "靠的是每一处连接，",
      "startFrame": 10398,
      "endFrame": 10432,
      "startSeconds": 346.6,
      "endSeconds": 347.73333333333335
    },
    {
      "id": "s047",
      "text": "都能把力送到下一站。",
      "startFrame": 10434,
      "endFrame": 10467,
      "startSeconds": 347.8,
      "endSeconds": 348.9
    },
    {
      "id": "s047",
      "text": "外形越轻盈，",
      "startFrame": 10472,
      "endFrame": 10493,
      "startSeconds": 349.06666666666666,
      "endSeconds": 349.76666666666665
    },
    {
      "id": "s047",
      "text": "里面的配合越精细。",
      "startFrame": 10496,
      "endFrame": 10525,
      "startSeconds": 349.8666666666667,
      "endSeconds": 350.8333333333333
    },
    {
      "id": "s048",
      "text": "每天五分钟，",
      "startFrame": 10534,
      "endFrame": 10558,
      "startSeconds": 351.1333333333333,
      "endSeconds": 351.93333333333334
    },
    {
      "id": "s048",
      "text": "认识生活里的新知识。",
      "startFrame": 10561,
      "endFrame": 10592,
      "startSeconds": 352.03333333333336,
      "endSeconds": 353.06666666666666
    },
    {
      "id": "s048",
      "text": "我们下次见。",
      "startFrame": 10594,
      "endFrame": 10610,
      "startSeconds": 353.1333333333333,
      "endSeconds": 353.6666666666667
    }
  ]
}