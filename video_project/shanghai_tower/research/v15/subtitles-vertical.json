{
  "version": "v15",
  "kind": "vertical",
  "fps": 30,
  "durationFrames": 2700,
  "durationSeconds": 90.0,
  "source": "src/timeline-v15-vertical.json",
  "entries": [
    {
      "id": "s001",
      "text": "上海中心，六百三十二米。",
      "startFrame": 3,
      "endFrame": 20,
      "startSeconds": 0.1,
      "endSeconds": 0.6666666666666666
    },
    {
      "id": "s001",
      "text": "先把这座楼拆开，",
      "startFrame": 20,
      "endFrame": 32,
      "startSeconds": 0.6666666666666666,
      "endSeconds": 1.0666666666666667
    },
    {
      "id": "s001",
      "text": "摊在眼前。看着像一排排重复的构件，",
      "startFrame": 34,
      "endFrame": 54,
      "startSeconds": 1.1333333333333333,
      "endSeconds": 1.8
    },
    {
      "id": "s001",
      "text": "其实每一组都有自己的位置和任务。",
      "startFrame": 54,
      "endFrame": 74,
      "startSeconds": 1.8,
      "endSeconds": 2.466666666666667
    },
    {
      "id": "s001",
      "text": "名字旁边写着它来自哪一段、站在哪个位置，",
      "startFrame": 74,
      "endFrame": 104,
      "startSeconds": 2.466666666666667,
      "endSeconds": 3.466666666666667
    },
    {
      "id": "s001",
      "text": "合起来，就是这栋楼的骨架。",
      "startFrame": 104,
      "endFrame": 119,
      "startSeconds": 3.466666666666667,
      "endSeconds": 3.966666666666667
    },
    {
      "id": "s002",
      "text": "最外面，玻璃和边框挡住风雨，",
      "startFrame": 122,
      "endFrame": 144,
      "startSeconds": 4.066666666666666,
      "endSeconds": 4.8
    },
    {
      "id": "s002",
      "text": "围出室内空间。",
      "startFrame": 145,
      "endFrame": 153,
      "startSeconds": 4.833333333333333,
      "endSeconds": 5.1
    },
    {
      "id": "s002",
      "text": "往里一层，楼板接住人和家具，",
      "startFrame": 156,
      "endFrame": 175,
      "startSeconds": 5.2,
      "endSeconds": 5.833333333333333
    },
    {
      "id": "s002",
      "text": "脚下的钢梁再把这些重量，",
      "startFrame": 177,
      "endFrame": 192,
      "startSeconds": 5.9,
      "endSeconds": 6.4
    },
    {
      "id": "s002",
      "text": "交给旁边的柱子。",
      "startFrame": 192,
      "endFrame": 204,
      "startSeconds": 6.4,
      "endSeconds": 6.8
    },
    {
      "id": "s002",
      "text": "人走在上面，",
      "startFrame": 206,
      "endFrame": 213,
      "startSeconds": 6.866666666666666,
      "endSeconds": 7.1
    },
    {
      "id": "s002",
      "text": "看不见这场接力。",
      "startFrame": 216,
      "endFrame": 224,
      "startSeconds": 7.2,
      "endSeconds": 7.466666666666667
    },
    {
      "id": "s003",
      "text": "这些斜着交叉的杆件，",
      "startFrame": 226,
      "endFrame": 239,
      "startSeconds": 7.533333333333333,
      "endSeconds": 7.966666666666667
    },
    {
      "id": "s003",
      "text": "就像一座座小钢桥。",
      "startFrame": 239,
      "endFrame": 252,
      "startSeconds": 7.966666666666667,
      "endSeconds": 8.4
    },
    {
      "id": "s003",
      "text": "上下两根横杆，",
      "startFrame": 255,
      "endFrame": 263,
      "startSeconds": 8.5,
      "endSeconds": 8.766666666666667
    },
    {
      "id": "s003",
      "text": "分别叫上弦和下弦。",
      "startFrame": 263,
      "endFrame": 277,
      "startSeconds": 8.766666666666667,
      "endSeconds": 9.233333333333333
    },
    {
      "id": "s003",
      "text": "斜杆把中间连成三角形。",
      "startFrame": 279,
      "endFrame": 293,
      "startSeconds": 9.3,
      "endSeconds": 9.766666666666667
    },
    {
      "id": "s003",
      "text": "伸臂从中间搭到外圈，",
      "startFrame": 296,
      "endFrame": 309,
      "startSeconds": 9.866666666666667,
      "endSeconds": 10.3
    },
    {
      "id": "s003",
      "text": "环带沿着周边接力，",
      "startFrame": 310,
      "endFrame": 321,
      "startSeconds": 10.333333333333334,
      "endSeconds": 10.7
    },
    {
      "id": "s003",
      "text": "把巨柱连成一伙。",
      "startFrame": 321,
      "endFrame": 332,
      "startSeconds": 10.7,
      "endSeconds": 11.066666666666666
    },
    {
      "id": "s003",
      "text": "风从侧面推来，",
      "startFrame": 336,
      "endFrame": 344,
      "startSeconds": 11.2,
      "endSeconds": 11.466666666666667
    },
    {
      "id": "s003",
      "text": "它们就一起分担。",
      "startFrame": 346,
      "endFrame": 354,
      "startSeconds": 11.533333333333333,
      "endSeconds": 11.8
    },
    {
      "id": "s004",
      "text": "中间的厚墙，",
      "startFrame": 359,
      "endFrame": 367,
      "startSeconds": 11.966666666666667,
      "endSeconds": 12.233333333333333
    },
    {
      "id": "s004",
      "text": "围成核心筒。",
      "startFrame": 367,
      "endFrame": 376,
      "startSeconds": 12.233333333333333,
      "endSeconds": 12.533333333333333
    },
    {
      "id": "s004",
      "text": "它和外圈巨柱一起，",
      "startFrame": 378,
      "endFrame": 386,
      "startSeconds": 12.6,
      "endSeconds": 12.866666666666667
    },
    {
      "id": "s004",
      "text": "把力送往地下的筏板和桩群。",
      "startFrame": 386,
      "endFrame": 404,
      "startSeconds": 12.866666666666667,
      "endSeconds": 13.466666666666667
    },
    {
      "id": "s004",
      "text": "现在，把这些部分放回原位，",
      "startFrame": 407,
      "endFrame": 423,
      "startSeconds": 13.566666666666666,
      "endSeconds": 14.1
    },
    {
      "id": "s004",
      "text": "再顺着传力的路，",
      "startFrame": 425,
      "endFrame": 432,
      "startSeconds": 14.166666666666666,
      "endSeconds": 14.4
    },
    {
      "id": "s004",
      "text": "从地下看起。",
      "startFrame": 432,
      "endFrame": 442,
      "startSeconds": 14.4,
      "endSeconds": 14.733333333333333
    },
    {
      "id": "s005",
      "text": "先往地下看。",
      "startFrame": 446,
      "endFrame": 453,
      "startSeconds": 14.866666666666667,
      "endSeconds": 15.1
    },
    {
      "id": "s005",
      "text": "上海中心脚下是软土地基，",
      "startFrame": 455,
      "endFrame": 466,
      "startSeconds": 15.166666666666666,
      "endSeconds": 15.533333333333333
    },
    {
      "id": "s005",
      "text": "楼越高，地面要接住的重量也越大。",
      "startFrame": 467,
      "endFrame": 481,
      "startSeconds": 15.566666666666666,
      "endSeconds": 16.033333333333335
    },
    {
      "id": "s006",
      "text": "桩伸进更深的土层，",
      "startFrame": 484,
      "endFrame": 492,
      "startSeconds": 16.133333333333333,
      "endSeconds": 16.4
    },
    {
      "id": "s006",
      "text": "楼的重量沿着桩身向下传。",
      "startFrame": 494,
      "endFrame": 504,
      "startSeconds": 16.466666666666665,
      "endSeconds": 16.8
    },
    {
      "id": "s006",
      "text": "周围的土贴着桩身，",
      "startFrame": 505,
      "endFrame": 512,
      "startSeconds": 16.833333333333332,
      "endSeconds": 17.066666666666666
    },
    {
      "id": "s006",
      "text": "从侧面提供向上的阻力；",
      "startFrame": 513,
      "endFrame": 523,
      "startSeconds": 17.1,
      "endSeconds": 17.433333333333334
    },
    {
      "id": "s006",
      "text": "桩底的土，再托住一部分。",
      "startFrame": 524,
      "endFrame": 532,
      "startSeconds": 17.466666666666665,
      "endSeconds": 17.733333333333334
    },
    {
      "id": "s006",
      "text": "这两条传力路线，",
      "startFrame": 534,
      "endFrame": 540,
      "startSeconds": 17.8,
      "endSeconds": 18.0
    },
    {
      "id": "s006",
      "text": "一起接住上面的重量。",
      "startFrame": 540,
      "endFrame": 547,
      "startSeconds": 18.0,
      "endSeconds": 18.233333333333334
    },
    {
      "id": "s007",
      "text": "再看一根独立的桩模型，",
      "startFrame": 550,
      "endFrame": 559,
      "startSeconds": 18.333333333333332,
      "endSeconds": 18.633333333333333
    },
    {
      "id": "s007",
      "text": "给它一段变化的侧向推力。",
      "startFrame": 562,
      "endFrame": 570,
      "startSeconds": 18.733333333333334,
      "endSeconds": 19.0
    },
    {
      "id": "s007",
      "text": "桩头先移动，",
      "startFrame": 571,
      "endFrame": 576,
      "startSeconds": 19.033333333333335,
      "endSeconds": 19.2
    },
    {
      "id": "s007",
      "text": "桩身跟着弯曲，",
      "startFrame": 578,
      "endFrame": 583,
      "startSeconds": 19.266666666666666,
      "endSeconds": 19.433333333333334
    },
    {
      "id": "s007",
      "text": "周围的土沿着深度抵住它。",
      "startFrame": 585,
      "endFrame": 594,
      "startSeconds": 19.5,
      "endSeconds": 19.8
    },
    {
      "id": "s007",
      "text": "颜色把桩身的受力标出来，",
      "startFrame": 596,
      "endFrame": 605,
      "startSeconds": 19.866666666666667,
      "endSeconds": 20.166666666666668
    },
    {
      "id": "s007",
      "text": "哪一段更吃力，",
      "startFrame": 607,
      "endFrame": 612,
      "startSeconds": 20.233333333333334,
      "endSeconds": 20.4
    },
    {
      "id": "s007",
      "text": "就更容易看清。",
      "startFrame": 612,
      "endFrame": 618,
      "startSeconds": 20.4,
      "endSeconds": 20.6
    },
    {
      "id": "s007",
      "text": "推力撤掉以后，",
      "startFrame": 620,
      "endFrame": 626,
      "startSeconds": 20.666666666666668,
      "endSeconds": 20.866666666666667
    },
    {
      "id": "s007",
      "text": "桩还会轻轻摆几下，",
      "startFrame": 628,
      "endFrame": 634,
      "startSeconds": 20.933333333333334,
      "endSeconds": 21.133333333333333
    },
    {
      "id": "s007",
      "text": "能量逐渐耗散。",
      "startFrame": 636,
      "endFrame": 642,
      "startSeconds": 21.2,
      "endSeconds": 21.4
    },
    {
      "id": "s007",
      "text": "这是一根桩的计算例子，",
      "startFrame": 644,
      "endFrame": 651,
      "startSeconds": 21.466666666666665,
      "endSeconds": 21.7
    },
    {
      "id": "s007",
      "text": "用来读懂桩和土怎样配合。",
      "startFrame": 652,
      "endFrame": 662,
      "startSeconds": 21.733333333333334,
      "endSeconds": 22.066666666666666
    },
    {
      "id": "s008",
      "text": "桩的上面，是厚达六米的基础底板。",
      "startFrame": 664,
      "endFrame": 680,
      "startSeconds": 22.133333333333333,
      "endSeconds": 22.666666666666668
    },
    {
      "id": "s008",
      "text": "你可以把它理解成一块厚底盘，",
      "startFrame": 681,
      "endFrame": 691,
      "startSeconds": 22.7,
      "endSeconds": 23.033333333333335
    },
    {
      "id": "s008",
      "text": "把基础连成整体。",
      "startFrame": 692,
      "endFrame": 698,
      "startSeconds": 23.066666666666666,
      "endSeconds": 23.266666666666666
    },
    {
      "id": "s009",
      "text": "这块厚底盘把桩和大楼连在一起。",
      "startFrame": 702,
      "endFrame": 715,
      "startSeconds": 23.4,
      "endSeconds": 23.833333333333332
    },
    {
      "id": "s009",
      "text": "顺着它往上，",
      "startFrame": 716,
      "endFrame": 721,
      "startSeconds": 23.866666666666667,
      "endSeconds": 24.033333333333335
    },
    {
      "id": "s009",
      "text": "是一根贯穿大楼的硬骨头。",
      "startFrame": 721,
      "endFrame": 730,
      "startSeconds": 24.033333333333335,
      "endSeconds": 24.333333333333332
    },
    {
      "id": "s010",
      "text": "它叫核心筒。",
      "startFrame": 734,
      "endFrame": 740,
      "startSeconds": 24.466666666666665,
      "endSeconds": 24.666666666666668
    },
    {
      "id": "s010",
      "text": "电梯、楼梯和不少设备管线，",
      "startFrame": 741,
      "endFrame": 753,
      "startSeconds": 24.7,
      "endSeconds": 25.1
    },
    {
      "id": "s010",
      "text": "都集中在这片靠近楼中心的区域。",
      "startFrame": 753,
      "endFrame": 766,
      "startSeconds": 25.1,
      "endSeconds": 25.533333333333335
    },
    {
      "id": "s011",
      "text": "从上面看，底部排着九个格子，",
      "startFrame": 767,
      "endFrame": 780,
      "startSeconds": 25.566666666666666,
      "endSeconds": 26.0
    },
    {
      "id": "s011",
      "text": "像一个九宫格。",
      "startFrame": 780,
      "endFrame": 786,
      "startSeconds": 26.0,
      "endSeconds": 26.2
    },
    {
      "id": "s011",
      "text": "里面的墙和外围的墙连在一起，",
      "startFrame": 787,
      "endFrame": 798,
      "startSeconds": 26.233333333333334,
      "endSeconds": 26.6
    },
    {
      "id": "s011",
      "text": "让它更难被推弯。",
      "startFrame": 800,
      "endFrame": 805,
      "startSeconds": 26.666666666666668,
      "endSeconds": 26.833333333333332
    },
    {
      "id": "s012",
      "text": "钢材和混凝土，",
      "startFrame": 809,
      "endFrame": 816,
      "startSeconds": 26.966666666666665,
      "endSeconds": 27.2
    },
    {
      "id": "s012",
      "text": "一起承担楼层的重量，",
      "startFrame": 816,
      "endFrame": 824,
      "startSeconds": 27.2,
      "endSeconds": 27.466666666666665
    },
    {
      "id": "s012",
      "text": "也抵抗从侧面吹来的风。",
      "startFrame": 824,
      "endFrame": 834,
      "startSeconds": 27.466666666666665,
      "endSeconds": 27.8
    },
    {
      "id": "s013",
      "text": "风把楼顶推向一边，",
      "startFrame": 837,
      "endFrame": 846,
      "startSeconds": 27.9,
      "endSeconds": 28.2
    },
    {
      "id": "s013",
      "text": "核心筒会像竖起的尺子那样弯曲，",
      "startFrame": 848,
      "endFrame": 859,
      "startSeconds": 28.266666666666666,
      "endSeconds": 28.633333333333333
    },
    {
      "id": "s013",
      "text": "越高的位置移动越明显。",
      "startFrame": 860,
      "endFrame": 870,
      "startSeconds": 28.666666666666668,
      "endSeconds": 29.0
    },
    {
      "id": "s013",
      "text": "画面放大了位移，",
      "startFrame": 871,
      "endFrame": 877,
      "startSeconds": 29.033333333333335,
      "endSeconds": 29.233333333333334
    },
    {
      "id": "s013",
      "text": "旁边的直线保留原来的位置，",
      "startFrame": 878,
      "endFrame": 888,
      "startSeconds": 29.266666666666666,
      "endSeconds": 29.6
    },
    {
      "id": "s013",
      "text": "两相对照，就能看清它怎样变形。",
      "startFrame": 888,
      "endFrame": 901,
      "startSeconds": 29.6,
      "endSeconds": 30.033333333333335
    },
    {
      "id": "s014",
      "text": "只靠中间这根硬骨头，",
      "startFrame": 904,
      "endFrame": 912,
      "startSeconds": 30.133333333333333,
      "endSeconds": 30.4
    },
    {
      "id": "s014",
      "text": "离六百多米的目标还差一把力。",
      "startFrame": 912,
      "endFrame": 922,
      "startSeconds": 30.4,
      "endSeconds": 30.733333333333334
    },
    {
      "id": "s014",
      "text": "帮手就在钢梁另一头，",
      "startFrame": 924,
      "endFrame": 933,
      "startSeconds": 30.8,
      "endSeconds": 31.1
    },
    {
      "id": "s014",
      "text": "大楼的外圈。",
      "startFrame": 934,
      "endFrame": 939,
      "startSeconds": 31.133333333333333,
      "endSeconds": 31.3
    },
    {
      "id": "s015",
      "text": "这些粗壮的柱子，",
      "startFrame": 941,
      "endFrame": 948,
      "startSeconds": 31.366666666666667,
      "endSeconds": 31.6
    },
    {
      "id": "s015",
      "text": "叫巨型柱。它们和中间的骨架，",
      "startFrame": 948,
      "endFrame": 960,
      "startSeconds": 31.6,
      "endSeconds": 32.0
    },
    {
      "id": "s015",
      "text": "一起承担整座建筑的重量。",
      "startFrame": 960,
      "endFrame": 970,
      "startSeconds": 32.0,
      "endSeconds": 32.333333333333336
    },
    {
      "id": "s016",
      "text": "楼板接住人和设备的重量，",
      "startFrame": 972,
      "endFrame": 984,
      "startSeconds": 32.4,
      "endSeconds": 32.8
    },
    {
      "id": "s016",
      "text": "钢梁把这些重量交给柱子和中间的骨架，",
      "startFrame": 986,
      "endFrame": 999,
      "startSeconds": 32.86666666666667,
      "endSeconds": 33.3
    },
    {
      "id": "s016",
      "text": "一路传进基础。",
      "startFrame": 1000,
      "endFrame": 1006,
      "startSeconds": 33.333333333333336,
      "endSeconds": 33.53333333333333
    },
    {
      "id": "s017",
      "text": "遇到侧面的气流，",
      "startFrame": 1008,
      "endFrame": 1016,
      "startSeconds": 33.6,
      "endSeconds": 33.86666666666667
    },
    {
      "id": "s017",
      "text": "光有几根各自立着的柱子还不够，",
      "startFrame": 1017,
      "endFrame": 1028,
      "startSeconds": 33.9,
      "endSeconds": 34.266666666666666
    },
    {
      "id": "s017",
      "text": "它们需要和中间的骨架拉起手来。",
      "startFrame": 1030,
      "endFrame": 1041,
      "startSeconds": 34.333333333333336,
      "endSeconds": 34.7
    },
    {
      "id": "s018",
      "text": "把两边接起来的，",
      "startFrame": 1043,
      "endFrame": 1050,
      "startSeconds": 34.766666666666666,
      "endSeconds": 35.0
    },
    {
      "id": "s018",
      "text": "是伸臂钢架。",
      "startFrame": 1050,
      "endFrame": 1056,
      "startSeconds": 35.0,
      "endSeconds": 35.2
    },
    {
      "id": "s018",
      "text": "先拆开看：上下两条横杆，",
      "startFrame": 1056,
      "endFrame": 1068,
      "startSeconds": 35.2,
      "endSeconds": 35.6
    },
    {
      "id": "s018",
      "text": "叫上弦和下弦；",
      "startFrame": 1069,
      "endFrame": 1076,
      "startSeconds": 35.63333333333333,
      "endSeconds": 35.86666666666667
    },
    {
      "id": "s018",
      "text": "中间的斜杆，",
      "startFrame": 1078,
      "endFrame": 1082,
      "startSeconds": 35.93333333333333,
      "endSeconds": 36.06666666666667
    },
    {
      "id": "s018",
      "text": "把它们连成一个个三角形。",
      "startFrame": 1084,
      "endFrame": 1092,
      "startSeconds": 36.13333333333333,
      "endSeconds": 36.4
    },
    {
      "id": "s018",
      "text": "上下弦连住两端，",
      "startFrame": 1094,
      "endFrame": 1100,
      "startSeconds": 36.46666666666667,
      "endSeconds": 36.666666666666664
    },
    {
      "id": "s018",
      "text": "斜杆撑在中间。",
      "startFrame": 1102,
      "endFrame": 1107,
      "startSeconds": 36.733333333333334,
      "endSeconds": 36.9
    },
    {
      "id": "s018",
      "text": "楼一弯，这些连接就把力传到外圈。",
      "startFrame": 1109,
      "endFrame": 1122,
      "startSeconds": 36.96666666666667,
      "endSeconds": 37.4
    },
    {
      "id": "s018",
      "text": "合起来以后，",
      "startFrame": 1125,
      "endFrame": 1129,
      "startSeconds": 37.5,
      "endSeconds": 37.63333333333333
    },
    {
      "id": "s018",
      "text": "这座小钢桥就能把核心筒和外圈柱连在一起。",
      "startFrame": 1130,
      "endFrame": 1146,
      "startSeconds": 37.666666666666664,
      "endSeconds": 38.2
    },
    {
      "id": "s018",
      "text": "上海中心的六处关键高度，",
      "startFrame": 1149,
      "endFrame": 1157,
      "startSeconds": 38.3,
      "endSeconds": 38.56666666666667
    },
    {
      "id": "s018",
      "text": "都有这种钢架。",
      "startFrame": 1157,
      "endFrame": 1163,
      "startSeconds": 38.56666666666667,
      "endSeconds": 38.766666666666666
    },
    {
      "id": "s019",
      "text": "核心筒向一边弯，",
      "startFrame": 1165,
      "endFrame": 1172,
      "startSeconds": 38.833333333333336,
      "endSeconds": 39.06666666666667
    },
    {
      "id": "s019",
      "text": "就会带着伸臂一起转动。",
      "startFrame": 1172,
      "endFrame": 1180,
      "startSeconds": 39.06666666666667,
      "endSeconds": 39.333333333333336
    },
    {
      "id": "s019",
      "text": "伸臂的一头向下压，",
      "startFrame": 1180,
      "endFrame": 1189,
      "startSeconds": 39.333333333333336,
      "endSeconds": 39.63333333333333
    },
    {
      "id": "s019",
      "text": "另一头向上提，",
      "startFrame": 1190,
      "endFrame": 1195,
      "startSeconds": 39.666666666666664,
      "endSeconds": 39.833333333333336
    },
    {
      "id": "s019",
      "text": "这个动作把外圈的巨型柱也调动起来。",
      "startFrame": 1196,
      "endFrame": 1210,
      "startSeconds": 39.86666666666667,
      "endSeconds": 40.333333333333336
    },
    {
      "id": "s019",
      "text": "看这两根斜杆的颜色，",
      "startFrame": 1210,
      "endFrame": 1219,
      "startSeconds": 40.333333333333336,
      "endSeconds": 40.63333333333333
    },
    {
      "id": "s019",
      "text": "就能看见这一刻的受力变化。",
      "startFrame": 1219,
      "endFrame": 1229,
      "startSeconds": 40.63333333333333,
      "endSeconds": 40.96666666666667
    },
    {
      "id": "s020",
      "text": "橙色，表示向受压方向变化；",
      "startFrame": 1231,
      "endFrame": 1244,
      "startSeconds": 41.03333333333333,
      "endSeconds": 41.46666666666667
    },
    {
      "id": "s020",
      "text": "蓝色，表示向受拉方向变化。",
      "startFrame": 1246,
      "endFrame": 1256,
      "startSeconds": 41.53333333333333,
      "endSeconds": 41.86666666666667
    },
    {
      "id": "s020",
      "text": "这张色图，读的是风带来的增量。",
      "startFrame": 1258,
      "endFrame": 1270,
      "startSeconds": 41.93333333333333,
      "endSeconds": 42.333333333333336
    },
    {
      "id": "s020",
      "text": "再看外圈的柱子，",
      "startFrame": 1271,
      "endFrame": 1277,
      "startSeconds": 42.36666666666667,
      "endSeconds": 42.56666666666667
    },
    {
      "id": "s020",
      "text": "它原本还压着整栋楼的重量。",
      "startFrame": 1278,
      "endFrame": 1288,
      "startSeconds": 42.6,
      "endSeconds": 42.93333333333333
    },
    {
      "id": "s020",
      "text": "压力减小的一边，",
      "startFrame": 1289,
      "endFrame": 1294,
      "startSeconds": 42.96666666666667,
      "endSeconds": 43.13333333333333
    },
    {
      "id": "s020",
      "text": "也可能仍然在受压。",
      "startFrame": 1294,
      "endFrame": 1302,
      "startSeconds": 43.13333333333333,
      "endSeconds": 43.4
    },
    {
      "id": "s021",
      "text": "伸臂把力带到外圈，",
      "startFrame": 1306,
      "endFrame": 1314,
      "startSeconds": 43.53333333333333,
      "endSeconds": 43.8
    },
    {
      "id": "s021",
      "text": "环带钢架再沿着周边，",
      "startFrame": 1316,
      "endFrame": 1324,
      "startSeconds": 43.86666666666667,
      "endSeconds": 44.13333333333333
    },
    {
      "id": "s021",
      "text": "把这份力分给更多柱子。",
      "startFrame": 1325,
      "endFrame": 1334,
      "startSeconds": 44.166666666666664,
      "endSeconds": 44.46666666666667
    },
    {
      "id": "s021",
      "text": "中间、外圈和上下楼层相互连接，",
      "startFrame": 1334,
      "endFrame": 1348,
      "startSeconds": 44.46666666666667,
      "endSeconds": 44.93333333333333
    },
    {
      "id": "s021",
      "text": "大楼就能借整个宽度，",
      "startFrame": 1349,
      "endFrame": 1356,
      "startSeconds": 44.96666666666667,
      "endSeconds": 45.2
    },
    {
      "id": "s021",
      "text": "抵抗侧面的推力。",
      "startFrame": 1356,
      "endFrame": 1364,
      "startSeconds": 45.2,
      "endSeconds": 45.46666666666667
    },
    {
      "id": "s022",
      "text": "骨架站稳以后，",
      "startFrame": 1368,
      "endFrame": 1374,
      "startSeconds": 45.6,
      "endSeconds": 45.8
    },
    {
      "id": "s022",
      "text": "人要怎样在里面生活？",
      "startFrame": 1376,
      "endFrame": 1382,
      "startSeconds": 45.86666666666667,
      "endSeconds": 46.06666666666667
    },
    {
      "id": "s022",
      "text": "上海中心把很高的一栋楼，",
      "startFrame": 1384,
      "endFrame": 1392,
      "startSeconds": 46.13333333333333,
      "endSeconds": 46.4
    },
    {
      "id": "s022",
      "text": "分成了九个垂直分区。",
      "startFrame": 1392,
      "endFrame": 1401,
      "startSeconds": 46.4,
      "endSeconds": 46.7
    },
    {
      "id": "s023",
      "text": "每一段都有自己的活动空间，",
      "startFrame": 1404,
      "endFrame": 1415,
      "startSeconds": 46.8,
      "endSeconds": 47.166666666666664
    },
    {
      "id": "s023",
      "text": "分区之间设置空中大堂和公共空间，",
      "startFrame": 1416,
      "endFrame": 1430,
      "startSeconds": 47.2,
      "endSeconds": 47.666666666666664
    },
    {
      "id": "s023",
      "text": "像把街区往上叠起来。",
      "startFrame": 1431,
      "endFrame": 1439,
      "startSeconds": 47.7,
      "endSeconds": 47.96666666666667
    },
    {
      "id": "s024",
      "text": "从街上看到的，",
      "startFrame": 1442,
      "endFrame": 1449,
      "startSeconds": 48.06666666666667,
      "endSeconds": 48.3
    },
    {
      "id": "s024",
      "text": "是外面的玻璃；",
      "startFrame": 1450,
      "endFrame": 1455,
      "startSeconds": 48.333333333333336,
      "endSeconds": 48.5
    },
    {
      "id": "s024",
      "text": "人真正活动的房间，",
      "startFrame": 1456,
      "endFrame": 1463,
      "startSeconds": 48.53333333333333,
      "endSeconds": 48.766666666666666
    },
    {
      "id": "s024",
      "text": "包在更里面一层。",
      "startFrame": 1463,
      "endFrame": 1470,
      "startSeconds": 48.766666666666666,
      "endSeconds": 49.0
    },
    {
      "id": "s025",
      "text": "靠里的玻璃围住使用空间，",
      "startFrame": 1473,
      "endFrame": 1484,
      "startSeconds": 49.1,
      "endSeconds": 49.46666666666667
    },
    {
      "id": "s025",
      "text": "外层玻璃包住整座塔，",
      "startFrame": 1486,
      "endFrame": 1495,
      "startSeconds": 49.53333333333333,
      "endSeconds": 49.833333333333336
    },
    {
      "id": "s025",
      "text": "两层玻璃之间空出了高大的中庭。",
      "startFrame": 1497,
      "endFrame": 1509,
      "startSeconds": 49.9,
      "endSeconds": 50.3
    },
    {
      "id": "s026",
      "text": "阳光可以照进来，",
      "startFrame": 1512,
      "endFrame": 1519,
      "startSeconds": 50.4,
      "endSeconds": 50.63333333333333
    },
    {
      "id": "s026",
      "text": "外界的冷热又多经过一层缓冲。",
      "startFrame": 1520,
      "endFrame": 1532,
      "startSeconds": 50.666666666666664,
      "endSeconds": 51.06666666666667
    },
    {
      "id": "s026",
      "text": "这些空间，也给高空里的日常生活留了余地。",
      "startFrame": 1532,
      "endFrame": 1548,
      "startSeconds": 51.06666666666667,
      "endSeconds": 51.6
    },
    {
      "id": "s027",
      "text": "再回头看外形：",
      "startFrame": 1552,
      "endFrame": 1558,
      "startSeconds": 51.733333333333334,
      "endSeconds": 51.93333333333333
    },
    {
      "id": "s027",
      "text": "圆润的三角轮廓，",
      "startFrame": 1560,
      "endFrame": 1566,
      "startSeconds": 52.0,
      "endSeconds": 52.2
    },
    {
      "id": "s027",
      "text": "一边向上收小，",
      "startFrame": 1567,
      "endFrame": 1573,
      "startSeconds": 52.233333333333334,
      "endSeconds": 52.43333333333333
    },
    {
      "id": "s027",
      "text": "一边旋转，最终一共转过一百二十度。",
      "startFrame": 1574,
      "endFrame": 1587,
      "startSeconds": 52.46666666666667,
      "endSeconds": 52.9
    },
    {
      "id": "s028",
      "text": "这一扭，改变了风撞上大楼的方式。",
      "startFrame": 1589,
      "endFrame": 1604,
      "startSeconds": 52.96666666666667,
      "endSeconds": 53.46666666666667
    },
    {
      "id": "s028",
      "text": "越往高处走，",
      "startFrame": 1606,
      "endFrame": 1610,
      "startSeconds": 53.53333333333333,
      "endSeconds": 53.666666666666664
    },
    {
      "id": "s028",
      "text": "迎风的轮廓就越不一样。",
      "startFrame": 1611,
      "endFrame": 1619,
      "startSeconds": 53.7,
      "endSeconds": 53.96666666666667
    },
    {
      "id": "s029",
      "text": "同样的来风，",
      "startFrame": 1623,
      "endFrame": 1629,
      "startSeconds": 54.1,
      "endSeconds": 54.3
    },
    {
      "id": "s029",
      "text": "碰到大楼不同的位置，",
      "startFrame": 1631,
      "endFrame": 1638,
      "startSeconds": 54.36666666666667,
      "endSeconds": 54.6
    },
    {
      "id": "s029",
      "text": "效果很不一样。",
      "startFrame": 1640,
      "endFrame": 1644,
      "startSeconds": 54.666666666666664,
      "endSeconds": 54.8
    },
    {
      "id": "s029",
      "text": "先看表面的平均风压：",
      "startFrame": 1646,
      "endFrame": 1654,
      "startSeconds": 54.86666666666667,
      "endSeconds": 55.13333333333333
    },
    {
      "id": "s029",
      "text": "迎风的一面受到推压，",
      "startFrame": 1655,
      "endFrame": 1662,
      "startSeconds": 55.166666666666664,
      "endSeconds": 55.4
    },
    {
      "id": "s029",
      "text": "气流绕过转角，",
      "startFrame": 1664,
      "endFrame": 1669,
      "startSeconds": 55.46666666666667,
      "endSeconds": 55.63333333333333
    },
    {
      "id": "s029",
      "text": "侧面和背面的压力也会改变。",
      "startFrame": 1670,
      "endFrame": 1680,
      "startSeconds": 55.666666666666664,
      "endSeconds": 56.0
    },
    {
      "id": "s029",
      "text": "把颜色贴在表面，",
      "startFrame": 1682,
      "endFrame": 1688,
      "startSeconds": 56.06666666666667,
      "endSeconds": 56.266666666666666
    },
    {
      "id": "s029",
      "text": "就能看见哪一片在被推，",
      "startFrame": 1688,
      "endFrame": 1696,
      "startSeconds": 56.266666666666666,
      "endSeconds": 56.53333333333333
    },
    {
      "id": "s029",
      "text": "哪一片在被向外吸。",
      "startFrame": 1698,
      "endFrame": 1705,
      "startSeconds": 56.6,
      "endSeconds": 56.833333333333336
    },
    {
      "id": "s030",
      "text": "先把空气横着切开，",
      "startFrame": 1708,
      "endFrame": 1716,
      "startSeconds": 56.93333333333333,
      "endSeconds": 57.2
    },
    {
      "id": "s030",
      "text": "停在一百米高处。",
      "startFrame": 1718,
      "endFrame": 1723,
      "startSeconds": 57.266666666666666,
      "endSeconds": 57.43333333333333
    },
    {
      "id": "s030",
      "text": "看平均风速：",
      "startFrame": 1724,
      "endFrame": 1729,
      "startSeconds": 57.46666666666667,
      "endSeconds": 57.63333333333333
    },
    {
      "id": "s030",
      "text": "来风迎上大楼，",
      "startFrame": 1729,
      "endFrame": 1736,
      "startSeconds": 57.63333333333333,
      "endSeconds": 57.86666666666667
    },
    {
      "id": "s030",
      "text": "再从两边绕过去，",
      "startFrame": 1737,
      "endFrame": 1744,
      "startSeconds": 57.9,
      "endSeconds": 58.13333333333333
    },
    {
      "id": "s030",
      "text": "背后留下一片较慢的区域。",
      "startFrame": 1745,
      "endFrame": 1754,
      "startSeconds": 58.166666666666664,
      "endSeconds": 58.46666666666667
    },
    {
      "id": "s030",
      "text": "切面升到三百米，",
      "startFrame": 1755,
      "endFrame": 1762,
      "startSeconds": 58.5,
      "endSeconds": 58.733333333333334
    },
    {
      "id": "s030",
      "text": "楼的轮廓已经转了一个角度。",
      "startFrame": 1763,
      "endFrame": 1772,
      "startSeconds": 58.766666666666666,
      "endSeconds": 59.06666666666667
    },
    {
      "id": "s030",
      "text": "来风方向没变，",
      "startFrame": 1773,
      "endFrame": 1778,
      "startSeconds": 59.1,
      "endSeconds": 59.266666666666666
    },
    {
      "id": "s030",
      "text": "气流遇到的转角却变了，",
      "startFrame": 1780,
      "endFrame": 1788,
      "startSeconds": 59.333333333333336,
      "endSeconds": 59.6
    },
    {
      "id": "s030",
      "text": "绕行路线也跟着变化。",
      "startFrame": 1789,
      "endFrame": 1796,
      "startSeconds": 59.63333333333333,
      "endSeconds": 59.86666666666667
    },
    {
      "id": "s030",
      "text": "再升到五百米，",
      "startFrame": 1798,
      "endFrame": 1803,
      "startSeconds": 59.93333333333333,
      "endSeconds": 60.1
    },
    {
      "id": "s030",
      "text": "塔身收得更细，",
      "startFrame": 1804,
      "endFrame": 1809,
      "startSeconds": 60.13333333333333,
      "endSeconds": 60.3
    },
    {
      "id": "s030",
      "text": "方向又不一样。",
      "startFrame": 1810,
      "endFrame": 1815,
      "startSeconds": 60.333333333333336,
      "endSeconds": 60.5
    },
    {
      "id": "s030",
      "text": "沿着同一套颜色比较，",
      "startFrame": 1817,
      "endFrame": 1824,
      "startSeconds": 60.56666666666667,
      "endSeconds": 60.8
    },
    {
      "id": "s030",
      "text": "就能看见三个高度的风，",
      "startFrame": 1825,
      "endFrame": 1832,
      "startSeconds": 60.833333333333336,
      "endSeconds": 61.06666666666667
    },
    {
      "id": "s030",
      "text": "分别从哪里经过。",
      "startFrame": 1834,
      "endFrame": 1839,
      "startSeconds": 61.13333333333333,
      "endSeconds": 61.3
    },
    {
      "id": "s031",
      "text": "再把切面竖起来，",
      "startFrame": 1841,
      "endFrame": 1849,
      "startSeconds": 61.36666666666667,
      "endSeconds": 61.63333333333333
    },
    {
      "id": "s031",
      "text": "沿着来风的方向，",
      "startFrame": 1850,
      "endFrame": 1854,
      "startSeconds": 61.666666666666664,
      "endSeconds": 61.8
    },
    {
      "id": "s031",
      "text": "穿过塔身中间。",
      "startFrame": 1854,
      "endFrame": 1862,
      "startSeconds": 61.8,
      "endSeconds": 62.06666666666667
    },
    {
      "id": "s031",
      "text": "楼前、楼顶和背后的空气，",
      "startFrame": 1862,
      "endFrame": 1873,
      "startSeconds": 62.06666666666667,
      "endSeconds": 62.43333333333333
    },
    {
      "id": "s031",
      "text": "就连在同一张图里了。",
      "startFrame": 1873,
      "endFrame": 1881,
      "startSeconds": 62.43333333333333,
      "endSeconds": 62.7
    },
    {
      "id": "s031",
      "text": "顺着塔身往上看，",
      "startFrame": 1881,
      "endFrame": 1889,
      "startSeconds": 62.7,
      "endSeconds": 62.96666666666667
    },
    {
      "id": "s031",
      "text": "我们能看清楼顶上方的风怎样越过去，",
      "startFrame": 1891,
      "endFrame": 1904,
      "startSeconds": 63.03333333333333,
      "endSeconds": 63.46666666666667
    },
    {
      "id": "s031",
      "text": "大楼后面的气流，",
      "startFrame": 1904,
      "endFrame": 1910,
      "startSeconds": 63.46666666666667,
      "endSeconds": 63.666666666666664
    },
    {
      "id": "s031",
      "text": "又在哪些地方慢了下来。",
      "startFrame": 1910,
      "endFrame": 1919,
      "startSeconds": 63.666666666666664,
      "endSeconds": 63.96666666666667
    },
    {
      "id": "s032",
      "text": "在风洞里，工程师比较过多种方案，",
      "startFrame": 1921,
      "endFrame": 1935,
      "startSeconds": 64.03333333333333,
      "endSeconds": 64.5
    },
    {
      "id": "s032",
      "text": "最后选定一百二十度的扭转。",
      "startFrame": 1936,
      "endFrame": 1945,
      "startSeconds": 64.53333333333333,
      "endSeconds": 64.83333333333333
    },
    {
      "id": "s032",
      "text": "接下来，再给里面的骨架一段变化的侧向推力，",
      "startFrame": 1946,
      "endFrame": 1962,
      "startSeconds": 64.86666666666666,
      "endSeconds": 65.4
    },
    {
      "id": "s032",
      "text": "看它怎样弯曲，",
      "startFrame": 1962,
      "endFrame": 1968,
      "startSeconds": 65.4,
      "endSeconds": 65.6
    },
    {
      "id": "s032",
      "text": "怎样把这份力沿着连接，",
      "startFrame": 1969,
      "endFrame": 1978,
      "startSeconds": 65.63333333333334,
      "endSeconds": 65.93333333333334
    },
    {
      "id": "s032",
      "text": "一直送回地下。",
      "startFrame": 1978,
      "endFrame": 1983,
      "startSeconds": 65.93333333333334,
      "endSeconds": 66.1
    },
    {
      "id": "s033",
      "text": "看两侧柱子的颜色：",
      "startFrame": 1986,
      "endFrame": 1994,
      "startSeconds": 66.2,
      "endSeconds": 66.46666666666667
    },
    {
      "id": "s033",
      "text": "气流一推，一边压得更多，",
      "startFrame": 1996,
      "endFrame": 2004,
      "startSeconds": 66.53333333333333,
      "endSeconds": 66.8
    },
    {
      "id": "s033",
      "text": "另一边压得更少。",
      "startFrame": 2006,
      "endFrame": 2012,
      "startSeconds": 66.86666666666666,
      "endSeconds": 67.06666666666666
    },
    {
      "id": "s033",
      "text": "力顺着相连的部件，",
      "startFrame": 2013,
      "endFrame": 2020,
      "startSeconds": 67.1,
      "endSeconds": 67.33333333333333
    },
    {
      "id": "s033",
      "text": "一路传回基础。",
      "startFrame": 2020,
      "endFrame": 2027,
      "startSeconds": 67.33333333333333,
      "endSeconds": 67.56666666666666
    },
    {
      "id": "s034",
      "text": "楼站得稳，人坐在高处，",
      "startFrame": 2030,
      "endFrame": 2042,
      "startSeconds": 67.66666666666667,
      "endSeconds": 68.06666666666666
    },
    {
      "id": "s034",
      "text": "却仍然可能觉得晃。",
      "startFrame": 2042,
      "endFrame": 2048,
      "startSeconds": 68.06666666666666,
      "endSeconds": 68.26666666666667
    },
    {
      "id": "s034",
      "text": "到了这里，工程师还要照顾另一件事：",
      "startFrame": 2050,
      "endFrame": 2064,
      "startSeconds": 68.33333333333333,
      "endSeconds": 68.8
    },
    {
      "id": "s034",
      "text": "让人的感觉也稳下来。",
      "startFrame": 2065,
      "endFrame": 2073,
      "startSeconds": 68.83333333333333,
      "endSeconds": 69.1
    },
    {
      "id": "s035",
      "text": "这位帮手，叫调好频率的质量阻尼器。",
      "startFrame": 2075,
      "endFrame": 2091,
      "startSeconds": 69.16666666666667,
      "endSeconds": 69.7
    },
    {
      "id": "s035",
      "text": "上海中心楼顶悬着一块约一千吨的重物，",
      "startFrame": 2093,
      "endFrame": 2108,
      "startSeconds": 69.76666666666667,
      "endSeconds": 70.26666666666667
    },
    {
      "id": "s035",
      "text": "能相对大楼来回摆动。",
      "startFrame": 2108,
      "endFrame": 2116,
      "startSeconds": 70.26666666666667,
      "endSeconds": 70.53333333333333
    },
    {
      "id": "s036",
      "text": "气流把大楼推得左右摇，",
      "startFrame": 2121,
      "endFrame": 2131,
      "startSeconds": 70.7,
      "endSeconds": 71.03333333333333
    },
    {
      "id": "s036",
      "text": "重物就跟着相对摆动。",
      "startFrame": 2133,
      "endFrame": 2140,
      "startSeconds": 71.1,
      "endSeconds": 71.33333333333333
    },
    {
      "id": "s036",
      "text": "把它的节奏调到合适，",
      "startFrame": 2142,
      "endFrame": 2150,
      "startSeconds": 71.4,
      "endSeconds": 71.66666666666667
    },
    {
      "id": "s036",
      "text": "就能在运动中牵住大楼，减轻晃动。",
      "startFrame": 2151,
      "endFrame": 2165,
      "startSeconds": 71.7,
      "endSeconds": 72.16666666666667
    },
    {
      "id": "s037",
      "text": "阻尼装置再把一部分运动能量消耗掉。",
      "startFrame": 2169,
      "endFrame": 2184,
      "startSeconds": 72.3,
      "endSeconds": 72.8
    },
    {
      "id": "s037",
      "text": "你可以把它理解成：",
      "startFrame": 2185,
      "endFrame": 2190,
      "startSeconds": 72.83333333333333,
      "endSeconds": 73.0
    },
    {
      "id": "s037",
      "text": "让来回的摇摆，",
      "startFrame": 2192,
      "endFrame": 2197,
      "startSeconds": 73.06666666666666,
      "endSeconds": 73.23333333333333
    },
    {
      "id": "s037",
      "text": "一点点平静下来。",
      "startFrame": 2198,
      "endFrame": 2204,
      "startSeconds": 73.26666666666667,
      "endSeconds": 73.46666666666667
    },
    {
      "id": "s038",
      "text": "它主要照顾大风天气下的舒适度。",
      "startFrame": 2205,
      "endFrame": 2218,
      "startSeconds": 73.5,
      "endSeconds": 73.93333333333334
    },
    {
      "id": "s038",
      "text": "真正支撑大楼的，",
      "startFrame": 2219,
      "endFrame": 2226,
      "startSeconds": 73.96666666666667,
      "endSeconds": 74.2
    },
    {
      "id": "s038",
      "text": "还是下面这套一路相连的结构和基础。",
      "startFrame": 2227,
      "endFrame": 2240,
      "startSeconds": 74.23333333333333,
      "endSeconds": 74.66666666666667
    },
    {
      "id": "s039",
      "text": "现在从顶上往下看，",
      "startFrame": 2241,
      "endFrame": 2250,
      "startSeconds": 74.7,
      "endSeconds": 75.0
    },
    {
      "id": "s039",
      "text": "外衣削弱风的影响，",
      "startFrame": 2252,
      "endFrame": 2258,
      "startSeconds": 75.06666666666666,
      "endSeconds": 75.26666666666667
    },
    {
      "id": "s039",
      "text": "骨架接住力，",
      "startFrame": 2259,
      "endFrame": 2264,
      "startSeconds": 75.3,
      "endSeconds": 75.46666666666667
    },
    {
      "id": "s039",
      "text": "阻尼器再照顾人的感受，",
      "startFrame": 2265,
      "endFrame": 2275,
      "startSeconds": 75.5,
      "endSeconds": 75.83333333333333
    },
    {
      "id": "s039",
      "text": "分工就清楚了。",
      "startFrame": 2276,
      "endFrame": 2281,
      "startSeconds": 75.86666666666666,
      "endSeconds": 76.03333333333333
    },
    {
      "id": "s040",
      "text": "这栋楼又是怎么造起来的？",
      "startFrame": 2284,
      "endFrame": 2294,
      "startSeconds": 76.13333333333334,
      "endSeconds": 76.46666666666667
    },
    {
      "id": "s040",
      "text": "施工时，核心筒先向上爬升，",
      "startFrame": 2296,
      "endFrame": 2308,
      "startSeconds": 76.53333333333333,
      "endSeconds": 76.93333333333334
    },
    {
      "id": "s040",
      "text": "后面的工序接着跟上。",
      "startFrame": 2311,
      "endFrame": 2318,
      "startSeconds": 77.03333333333333,
      "endSeconds": 77.26666666666667
    },
    {
      "id": "s041",
      "text": "工人站在会自己向上走的钢平台上，",
      "startFrame": 2322,
      "endFrame": 2334,
      "startSeconds": 77.4,
      "endSeconds": 77.8
    },
    {
      "id": "s041",
      "text": "一段段把混凝土浇进去。",
      "startFrame": 2334,
      "endFrame": 2344,
      "startSeconds": 77.8,
      "endSeconds": 78.13333333333334
    },
    {
      "id": "s041",
      "text": "完成这一段，",
      "startFrame": 2345,
      "endFrame": 2350,
      "startSeconds": 78.16666666666667,
      "endSeconds": 78.33333333333333
    },
    {
      "id": "s041",
      "text": "平台再上移，",
      "startFrame": 2351,
      "endFrame": 2356,
      "startSeconds": 78.36666666666666,
      "endSeconds": 78.53333333333333
    },
    {
      "id": "s041",
      "text": "接着造下一段。",
      "startFrame": 2357,
      "endFrame": 2363,
      "startSeconds": 78.56666666666666,
      "endSeconds": 78.76666666666667
    },
    {
      "id": "s042",
      "text": "巨型柱通常落后中间的骨架六到九层，",
      "startFrame": 2366,
      "endFrame": 2384,
      "startSeconds": 78.86666666666666,
      "endSeconds": 79.46666666666667
    },
    {
      "id": "s042",
      "text": "楼面再落后巨型柱四到七层。",
      "startFrame": 2385,
      "endFrame": 2398,
      "startSeconds": 79.5,
      "endSeconds": 79.93333333333334
    },
    {
      "id": "s042",
      "text": "几个工作面，",
      "startFrame": 2399,
      "endFrame": 2402,
      "startSeconds": 79.96666666666667,
      "endSeconds": 80.06666666666666
    },
    {
      "id": "s042",
      "text": "一前一后，把大楼越盖越高。",
      "startFrame": 2402,
      "endFrame": 2414,
      "startSeconds": 80.06666666666666,
      "endSeconds": 80.46666666666667
    },
    {
      "id": "s043",
      "text": "主体升到大约三分之一高度，",
      "startFrame": 2417,
      "endFrame": 2428,
      "startSeconds": 80.56666666666666,
      "endSeconds": 80.93333333333334
    },
    {
      "id": "s043",
      "text": "外层玻璃才开始跟进。",
      "startFrame": 2429,
      "endFrame": 2436,
      "startSeconds": 80.96666666666667,
      "endSeconds": 81.2
    },
    {
      "id": "s043",
      "text": "一块块玻璃装上去，",
      "startFrame": 2438,
      "endFrame": 2444,
      "startSeconds": 81.26666666666667,
      "endSeconds": 81.46666666666667
    },
    {
      "id": "s043",
      "text": "连接处还要给结构变形留出空间。",
      "startFrame": 2445,
      "endFrame": 2456,
      "startSeconds": 81.5,
      "endSeconds": 81.86666666666666
    },
    {
      "id": "s044",
      "text": "连接钢架也要等合适时机再锁定。",
      "startFrame": 2460,
      "endFrame": 2474,
      "startSeconds": 82.0,
      "endSeconds": 82.46666666666667
    },
    {
      "id": "s044",
      "text": "楼心骨架和巨型柱收缩的节奏不同，",
      "startFrame": 2476,
      "endFrame": 2488,
      "startSeconds": 82.53333333333333,
      "endSeconds": 82.93333333333334
    },
    {
      "id": "s044",
      "text": "连接太早，就会给骨架增加额外的力。",
      "startFrame": 2490,
      "endFrame": 2505,
      "startSeconds": 83.0,
      "endSeconds": 83.5
    },
    {
      "id": "s045",
      "text": "当玻璃重新合拢，",
      "startFrame": 2508,
      "endFrame": 2516,
      "startSeconds": 83.6,
      "endSeconds": 83.86666666666666
    },
    {
      "id": "s045",
      "text": "那些粗壮的柱子、巨大的钢架，",
      "startFrame": 2517,
      "endFrame": 2528,
      "startSeconds": 83.9,
      "endSeconds": 84.26666666666667
    },
    {
      "id": "s045",
      "text": "连同六米厚的底盘，",
      "startFrame": 2528,
      "endFrame": 2536,
      "startSeconds": 84.26666666666667,
      "endSeconds": 84.53333333333333
    },
    {
      "id": "s045",
      "text": "又都藏了起来。",
      "startFrame": 2536,
      "endFrame": 2541,
      "startSeconds": 84.53333333333333,
      "endSeconds": 84.7
    },
    {
      "id": "s046",
      "text": "这些结构藏进了曲线里，",
      "startFrame": 2543,
      "endFrame": 2554,
      "startSeconds": 84.76666666666667,
      "endSeconds": 85.13333333333334
    },
    {
      "id": "s046",
      "text": "却还在一刻不停地接力。",
      "startFrame": 2554,
      "endFrame": 2562,
      "startSeconds": 85.13333333333334,
      "endSeconds": 85.4
    },
    {
      "id": "s046",
      "text": "楼层的重量向下走，",
      "startFrame": 2564,
      "endFrame": 2571,
      "startSeconds": 85.46666666666667,
      "endSeconds": 85.7
    },
    {
      "id": "s046",
      "text": "风的推力沿框架散开，",
      "startFrame": 2572,
      "endFrame": 2581,
      "startSeconds": 85.73333333333333,
      "endSeconds": 86.03333333333333
    },
    {
      "id": "s046",
      "text": "最后都交到脚下的土地。",
      "startFrame": 2583,
      "endFrame": 2590,
      "startSeconds": 86.1,
      "endSeconds": 86.33333333333333
    },
    {
      "id": "s047",
      "text": "六百三十二米的高度，",
      "startFrame": 2592,
      "endFrame": 2600,
      "startSeconds": 86.4,
      "endSeconds": 86.66666666666667
    },
    {
      "id": "s047",
      "text": "靠的是每一处连接，",
      "startFrame": 2600,
      "endFrame": 2608,
      "startSeconds": 86.66666666666667,
      "endSeconds": 86.93333333333334
    },
    {
      "id": "s047",
      "text": "都能把力送到下一站。",
      "startFrame": 2608,
      "endFrame": 2617,
      "startSeconds": 86.93333333333334,
      "endSeconds": 87.23333333333333
    },
    {
      "id": "s047",
      "text": "外形越轻盈，",
      "startFrame": 2618,
      "endFrame": 2623,
      "startSeconds": 87.26666666666667,
      "endSeconds": 87.43333333333334
    },
    {
      "id": "s047",
      "text": "里面的配合越精细。",
      "startFrame": 2624,
      "endFrame": 2631,
      "startSeconds": 87.46666666666667,
      "endSeconds": 87.7
    },
    {
      "id": "s048",
      "text": "每天五分钟，",
      "startFrame": 2634,
      "endFrame": 2640,
      "startSeconds": 87.8,
      "endSeconds": 88.0
    },
    {
      "id": "s048",
      "text": "认识生活里的新知识。",
      "startFrame": 2640,
      "endFrame": 2648,
      "startSeconds": 88.0,
      "endSeconds": 88.26666666666667
    },
    {
      "id": "s048",
      "text": "我们下次见。",
      "startFrame": 2648,
      "endFrame": 2652,
      "startSeconds": 88.26666666666667,
      "endSeconds": 88.4
    }
  ]
}