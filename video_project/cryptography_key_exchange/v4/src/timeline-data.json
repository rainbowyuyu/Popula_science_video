    {
      "id": "s05",
      "scene": "encrypt",
      "text": "把网络想成一根透明管子。订单直接穿过去，地址和备注也跟着露在外面，路过的人拿到一份就能读。",
      "spokenText": "把网络想成一根透明管子。订单直接穿过去，地址和备注也跟着露在外面，路过的人拿到一份就能读。",
      "pauseAfterSec": 0.16,
      "visualAction": "订单原文穿过透明导轨，旁观窗口完整显示；标记未加密示意。",
      "sources": [
        "RFC8446"
      ],
      "rawDurationSec": 8.960041666666667,
      "actualDurationSec": 9.200041666666667,
      "cleanSamples": 441602,
      "audio": "work/audio/clean/s05.wav",
