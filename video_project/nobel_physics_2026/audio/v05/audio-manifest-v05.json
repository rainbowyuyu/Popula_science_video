    "narration.wav": "805f2619e4fc43a9f79c66b36edb6d4e6c9a03039dd8078aad02e37239a52618",
    "music-source-48k.wav": "2aae9a1dd791e095964ae11392b13b7ecb406b4d5000525782887f6f7acf6828",
    "music.wav": "efb71222e1c32436759c195a0ad8ceaa593b9c30a4483f18873d520d8de85111",
    "premaster.wav": "d023db898bd45f43c05498293b258b6cf59dc8f8c522d3a8e8921ebd0d448b27",
    "master.wav": "c98838e04ef10e6b83e3d5ad485a2f96893a97420323f665c5429e6e2451ee9f"
