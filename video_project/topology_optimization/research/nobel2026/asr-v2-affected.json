{
  "001": "\u4eca\u5e74\u7684\u8afe\u8c9d\u723e\u751f\u7406\u5b78\u6216\u91ab\u5b78\u734e \u7d66\u4e86\u5361\u723e\u8fea\u585e\u7f85\u65af \u5f7c\u5f97\u8d6b\u683c\u66fc\u548c\u683c\u723e\u683c\u7d0d\u683c\u723e\u4e09\u500b\u4eba\u7684\u7b54\u6848\u90fd\u5f9e\u4e00\u675f\u5149\u958b\u59cb",
  "011": "\u65af\u5766\u798f\u7684\u8fea\u585e\u5c14\u00b7\u7f57\u65af\u4e00\u76f4\u5728\u627e\u8fd9\u628a\u5f00\u5173\u3002\u4ed6\u4ece\u7eb3\u683c\u5c14\u90a3\u91cc\u62ff\u5230\u4e8c\u884c\u901a\u9053,\u662f\u7d2b\u7ea2\u8d28\u57fa\u56e0,\u9001\u8fdb\u57f9\u517b\u6c11\u91cc\u7684\u5927\u5c5e\u795e\u7ecf\u56ed\u3002",
  "012": "\u9019\u4e9b\u795e\u7d93\u54e1\u8d77\u51fa\u5b89\u975c \u85cd\u5149\u8108\u885d\u843d\u4e0b \u52d5\u4f5c\u96fb\u4f4d\u56b4\u8ef8\u7a81\u50b3\u958b\u5149\u8108\u885d\u548c\u96fb\u8072\u88e1\u8a18\u9304\u5728\u540c\u4e00\u689d\u6642\u9593\u7dda\u4e0a\u51fa\u73fe2005\u5e74 \u7d50\u679c\u767c\u8868",
  "017": "2012\u5e74,\u8fea\u585e\u5c14\u00b7\u7f57\u65af\u548c\u5229\u6839\u5ddd\u56e2\u961f\u5148\u6807\u8bb0\u6050\u60e7\u8bad\u7ec3\u65f6\u6d3b\u8dc3\u7684\u7ec6\u80de,\u51e0\u5929\u540e,\u6ca1\u6709\u7535\u673a,\u96be\u5149\u91cd\u51fb\u6d3b\u4ed6\u4eec,\u5c0f\u9f20\u5374\u518d\u6b21\u51bb\u7ed3\u3002\u8fd9\u7fa4\u7ec6\u80de\u8db3\u4ee5\u6362\u56de\u90a3\u6bb5\u8bb0\u5fc6\u3002",
  "020": "\u9019\u9805\u8afe\u8c9d\u723e\u734e\u6253\u52d5\u4eba\u7684\u5730\u65b9\u662f\u628a\u4e00\u500b\u5927\u554f\u984c\u62c6\u6210\u56db\u500b\u80fd\u9a57\u8b49\u7684\u5c0f\u554f\u984c\u54ea\u7a2e\u7d30\u80de \u54ea\u7a2e\u86cb\u767d \u54ea\u4e00\u675f\u5149 \u7522\u751f\u4e86\u54ea\u4e00\u500b\u4fe1\u865f",
  "021": "\u5f9e\u4e00\u65e9\u773c\u9ede\u7684\u534a\u6beb\u79d2,\u5230\u5c0f\u9f20\u9b0d\u9b1a\u7684\u8f15\u8f15\u4e00\u52d5,\u8d6b\u683c\u66fc,\u7d0d\u683c\u723e\u548c\u8fea\u85a9\u723e\u00b7\u7f85\u65af\u628a\u5206\u5b50\u958b\u95dc\u4e00\u8def\u5e36\u9032\u4e86\u795e\u7d93\u56de\u8def,\u9019\u5c31\u662f\u4eca\u5e74\u8afe\u8c9d\u723e\u751f\u7406\u5b78\u6216\u91ab\u5b78\u8b1b\u8b1b\u7684\u6545\u4e8b\u3002"
}