    "file": "public/nobel2026/voice-v2-raw/006.wav",
    "seconds": 10.240041666666666,
    "sampleRate": 24000,
    "sha256": "61f8afaa82c1bf538e8c9383ff19f0cd947f2b10442eb22bc7f594b8cb0a248d",
    "elapsedSeconds": 38.39162635803223
  },
  "007": {
    "text": "转机来自基因测序。赫格曼把候选基因交给法兰克福的纳格尔。纳格尔把基因分别注入蛙卵，让蛙卵把蛋白摆到细胞膜上。",
    "referenceSha256": "dd8b89f70ab634af820966c01f3af535adcba7323427866d646c0dc1f6280bf7",
    "model": "Qwen3-TTS-0.6B",
