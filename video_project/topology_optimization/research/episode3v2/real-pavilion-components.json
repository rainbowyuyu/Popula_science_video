          "velocity_mps": 20,
          "rho_kg_m3": 1.225,
          "use": "演示工况；不作为建筑设计荷载"
        },
        {
          "id": "W45",
          "windDirectionDeg": 45,
          "velocity_mps": 20,
          "rho_kg_m3": 1.225,
          "use": "斜向来流，突出四角攒尖汇流"
        },
        {
          "id": "W90",
          "windDirectionDeg": 90,
          "velocity_mps": 20,
          "rho_kg_m3": 1.225,
          "use": "侧向来流，观察檐口和枓栱局部峰值"
        }
      ],
      "boundaryConditions": "四个PAV_BASE_STONE底面固定；柱—闌额、梁—枓栱、角梁—棖杆按jointMap接触；屋面风压施加到PAV_ROOF_PANEL并传递到PAV_RAFTER/PAV_EAVE_RAIL。",
      "outputs": [
        "pressure_cp",
        "surface_shear",
        "displacement",
        "von_mises_proxy",
        "reaction_force_at_base"
      ],
      "inverseForceVisual": "使用Zwind压力结果反向沿jointMap回溯到各部件；画面标注“反向载荷路径”，不把热力图当作真实材料应力。",
      "diffusionVisual": "扩散模型用于将离散压力/温湿度采样平滑映射到部件表面；若未运行结构求解，必须标注“可视化扩散代理”，不能宣称为FEA反算结果。"
    },
    "modeling_qa": [
      "每一根PAV_LAN_E的两端都与对应柱卯相交，且装配前不穿模；",
      "PAV_EAVE_BEAM的端部只落在枓口/柱心，不允许悬空；",
      "四根PAV_HIP_MAIN在中心棖杆具有同一汇交点；",
      "椽条数量、间距和方向与四面坡一致；",
      "侧脚导致柱顶向中心轻微收，不得显示为四根垂直圆柱；",
      "按assemblyOrder反向拆解，所有零件沿jointMap允许轴退出；",
      "Zwind载荷面与屋面法向一致，热力图覆盖整个亭体而非漂浮在旁侧。"
    ]
  },
