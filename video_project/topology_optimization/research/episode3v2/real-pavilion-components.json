        "base": "柱下櫍 + 独立础石（可拆）"
      },
      "horizontalFrame": {
        "闌額": {
          "count": 4,
          "section_cai": "广=2材=2.0；厚=广×2/3=1.333",
          "length": "柱心距=16.0",
          "joint": "两端入柱卯，横向贯入"
        },
        "檐栿": {
          "count": 4,
          "section_cai": "按四铺作/五铺作的两材一契组合",
          "joint": "梁端入枓口，枓上承栱"
        },
        "橑檐方": {
          "count": 4,
          "section_cai": "广=2材；厚=1材",
          "joint": "与檐栿/槫相交"
        }
      },
      "bracketSets": {
        "count": 4,
        "perSet": [
          "櫨枓×1",
          "泥道栱×1",
          "華栱×1",
          "令栱×1",
          "交互枓/齊心枓×3",
          "耍頭/昂×1"
        ],
        "assembly": "柱顶→櫨枓→栱→枓→令栱/昂→檐栿"
      },
      "roof": {
        "type": "四角斗尖（四角攒尖）",
        "slopeRule": "第一段 rise/run=1:5；上簇角梁收束段 rise/run=1:2",
        "radial_run_cai": "outer_eave_square_cai/2×sqrt(2)=20.506（中心至角）",
        "first_rise_cai": 4.101,
        "hipRafters": {
          "大角樑": 4,
          "子角樑": 4,
          "隱角樑": 4,
          "joint": "斜向榫/抱槫口，端部以中央棖杆/角部枓口定位"
        },
