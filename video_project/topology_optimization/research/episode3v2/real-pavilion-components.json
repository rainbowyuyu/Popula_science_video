        "roofPanels": {
          "count": 4,
          "type": "可拆木基层/轻瓦面板",
          "joint": "面板压在椽上，隐藏卡扣不参与主传力"
        }
      }
    },
    "parts_bom": [
      {
        "group": "PAV_BASE_STONE",
        "name": "础石/柱下櫍",
        "qty": 4,
        "role": "固定柱脚并可拆卸"
      },
      {
        "group": "PAV_COL",
        "name": "梭柱（含侧脚）",
        "qty": 4,
        "role": "主竖向受力件"
      },
      {
        "group": "PAV_LAN_E",
        "name": "闌额",
        "qty": 4,
        "role": "柱间水平拉结，贯入柱卯"
      },
      {
        "group": "PAV_EAVE_BEAM",
        "name": "檐栿/乳栿",
        "qty": 4,
        "role": "承接枓栱和屋面"
      },
      {
        "group": "PAV_EAVE_RAIL",
        "name": "橑檐方/槫",
        "qty": 4,
        "role": "椽条支座"
      },
      {
        "group": "PAV_BRACKET",
        "name": "枓栱套件",
        "qty": 4,
        "role": "多级悬臂与节点传力"
      },
      {
        "group": "PAV_HIP_MAIN",
        "name": "大角樑",
        "qty": 4,
        "role": "四角攒尖主斜梁"
      },
      {
        "group": "PAV_HIP_SUB",
        "name": "子角樑/隱角樑",
        "qty": 8,
        "role": "连续屋面斜向骨架"
      },
      {
        "group": "PAV_RAFTER",
        "name": "椽条",
        "qty": "192 full / 48 proxy",
        "role": "面荷载分配至檐方"
      },
      {
        "group": "PAV_HUB",
        "name": "中央棖杆/宝顶芯",
        "qty": 1,
        "role": "四根大角樑共同节点"
      },
      {
        "group": "PAV_ROOF_PANEL",
        "name": "可拆屋面板",
        "qty": 4,
        "role": "可视化风压载荷面"
      }
    ],
    "joint_map": [
      {
        "id": "J01",
        "name": "柱—闌额贯入榫",
        "a": "PAV_COL",
        "b": "PAV_LAN_E",
        "axis": "梁水平轴",
        "constraint": "禁止竖向和法向拔出，拆解仅沿梁轴向"
      },
      {
        "id": "J02",
        "name": "柱—櫨枓坐榫",
        "a": "PAV_COL",
        "b": "PAV_BRACKET",
        "axis": "Z",
        "constraint": "枓底落在柱头，侧向由耳口定位"
      },
      {
        "id": "J03",
        "name": "枓—栱开口",
        "a": "PAV_BRACKET",
        "b": "PAV_BRACKET",
        "axis": "水平/交错",
        "constraint": "按枓口滑入，契填入后阻止侧滑"
      },
      {
        "id": "J04",
        "name": "檐栿—枓口",
        "a": "PAV_EAVE_BEAM",
        "b": "PAV_BRACKET",
        "axis": "水平",
        "constraint": "梁端进入交互枓，透明显示抱槫口"
      },
      {
        "id": "J05",
        "name": "大角樑—中央棖杆",
        "a": "PAV_HIP_MAIN",
        "b": "PAV_HUB",
        "axis": "斜向",
        "constraint": "四向汇交，中心键锁定，拆解先拔中心键再沿斜向退出"
      },
      {
        "id": "J06",
        "name": "椽—槫/橑檐方",
        "a": "PAV_RAFTER",
        "b": "PAV_EAVE_RAIL",
        "axis": "坡向",
        "constraint": "椽头搭接，尾部落入槫槽；屋面板不替代椽的连接"
      }
    ],
    "assembly_order": [
      {
        "step": 1,
        "name": "础石定位",
        "parts": [
          "PAV_BASE_STONE"
        ],
        "motion": "四点落位，柱脚榫轴线竖直"
      },
      {
        "step": 2,
        "name": "立柱",
        "parts": [
          "PAV_COL"
        ],
        "motion": "柱底沿Z插入櫍卯；柱顶按侧脚向中心收"
      },
      {
        "step": 3,
        "name": "闌额闭合",
        "parts": [
          "PAV_LAN_E"
        ],
        "motion": "梁从屏幕外沿水平轴向柱卯滑入，四面闭合后锁定"
      },
      {
        "step": 4,
        "name": "檐栿和橑檐方",
        "parts": [
          "PAV_EAVE_BEAM",
          "PAV_EAVE_RAIL"
        ],
        "motion": "先梁后檐方，端部进入枓口/柱心卯"
      },
      {
        "step": 5,
        "name": "枓栱",
        "parts": [
          "PAV_BRACKET"
        ],
        "motion": "每组从柱顶逐级向外搭接，透明剖切显示开口和契"
      },
      {
        "step": 6,
        "name": "攒尖骨架",
        "parts": [
          "PAV_HIP_MAIN",
          "PAV_HIP_SUB",
          "PAV_HUB"
        ],
        "motion": "四根大角樑由四角向中央棖杆同步收拢，子角樑随后落位"
      },
      {
        "step": 7,
        "name": "椽阵列",
        "parts": [
          "PAV_RAFTER"
        ],
        "motion": "沿四面檐方阵列，椽尾搭入槫并以实例化动画显示"
      },
      {
        "step": 8,
        "name": "屋面板",
        "parts": [
          "PAV_ROOF_PANEL"
        ],
        "motion": "四块面板沿坡向滑入并压在椽上；作为风压载荷面"
      },
      {
        "step": 9,
        "name": "节点验证",
        "parts": [
          "ALL"
        ],
        "motion": "反向拆解按相反路径，检查每个榫卯仅沿允许自由度脱开"
      }
    ],
    "simulation_ready": {
      "meshGroups": [
        "PAV_BASE_STONE",
        "PAV_COL",
        "PAV_LAN_E",
        "PAV_EAVE_BEAM",
