{
  "fps": 30,
  "durationFrames": 9671,
  "seconds": 322.3666666666667,
  "timelineSha256": "5487802be3ce7d7c4e672ef7d38d698a36416c54bbc1f9f1134cc4e9df191640",
  "clips": [
    {
      "id": "h001",
      "scene": "intro",
      "start": 18,
      "end": 250,
      "text": "体检那天，袖带一点点收紧。人明明坐着没动，血压计上的数字却让人心里一紧。",
      "rawSeconds": 7.52
    },
    {
      "id": "h002",
      "scene": "intro",
      "start": 253,
      "end": 447,
      "text": "我也没头晕，怎么血压就高了？很多人的第一次发现，就是这样平平静静的。",
      "rawSeconds": 6.2400416666666665
    },
    {
      "id": "h003",
      "scene": "intro",
      "start": 450,
      "end": 627,
      "text": "那股看不见的压力，到底从哪儿来？我们顺着一次心跳，进身体里面看看。",
      "rawSeconds": 5.68
    },
    {
      "id": "h004",
      "scene": "intro",
      "start": 630,
      "end": 756,
      "text": "心脏、血管、肾脏，一直调节这个数字。",
      "rawSeconds": 4.0
    },
    {
      "id": "h005",
      "scene": "intro",
      "start": 759,
      "end": 902,
      "text": "某几处慢慢失衡，人没感觉，压力却先升上去了。",
      "rawSeconds": 4.560041666666667
    },
    {
      "id": "h006",
      "scene": "anatomy",
      "start": 911,
      "end": 1061,
      "text": "先找到胸口这颗心脏。它每次收缩，都把一股血液送进动脉。",
      "rawSeconds": 4.8
    },
    {
      "id": "h007",
      "scene": "anatomy",
      "start": 1064,
      "end": 1226,
      "text": "血液沿大血管分流，走进细小分支，把氧送遍全身。",
      "rawSeconds": 5.2
    },
    {
      "id": "h008",
      "scene": "anatomy",
      "start": 1229,
      "end": 1418,
      "text": "血液推着管壁。每单位面积承受的力，就是这里的压强，也叫血压。",
      "rawSeconds": 6.08
    },
    {
      "id": "h009",
      "scene": "anatomy",
      "start": 1421,
      "end": 1603,
      "text": "主动脉壁很有弹性。血液涌进来，它会扩张，暂时储存一部分能量。",
      "rawSeconds": 5.84
    },
    {
      "id": "h010",
      "scene": "anatomy",
      "start": 1606,
      "end": 1725,
      "text": "不同器官需要多少血，循环会主动调节。",
      "rawSeconds": 3.76
    },
    {
      "id": "h011",
      "scene": "pump",
      "start": 1734,
      "end": 1921,
      "text": "心脏收缩，把血推进主动脉，管壁被撑开，压强随之上升。",
      "rawSeconds": 6.000041666666666
    },
    {
      "id": "h012",
      "scene": "pump",
      "start": 1924,
      "end": 2115,
      "text": "心脏舒张，主动脉弹回来，继续推着血液向前，压强逐渐回落。",
      "rawSeconds": 6.16
    },
    {
      "id": "h013",
      "scene": "pump",
      "start": 2118,
      "end": 2302,
      "text": "血压计上面的数是收缩压，下面的是舒张压，记录着这一高一低。",
      "rawSeconds": 5.92
    },
    {
      "id": "h014",
      "scene": "pump",
      "start": 2305,
      "end": 2472,
      "text": "跑步、爬楼后心脏多送些血，血压暂时变化很正常。",
      "rawSeconds": 5.36
    },
    {
      "id": "h015",
      "scene": "pump",
      "start": 2475,
      "end": 2652,
      "text": "值得留意的，是人在安静状态下，经过反复测量，血压仍然偏高。",
      "rawSeconds": 5.68
    },
    {
      "id": "h016",
      "scene": "pump",
      "start": 2655,
      "end": 2820,
      "text": "常见的两条路：心脏每分钟送得更多，或血液遇到的阻力更大。",
      "rawSeconds": 5.28
    },
    {
      "id": "h017",
      "scene": "resistance",
      "start": 2829,
      "end": 2999,
      "text": "血流继续分支。到了小动脉，调节阻力的主角换成了平滑肌。",
      "rawSeconds": 5.44
    },
    {
      "id": "h018",
      "scene": "resistance",
      "start": 3002,
      "end": 3186,
      "text": "看看围在外面的平滑肌。它一收缩，管腔就变窄，血液通过更费劲。",
      "rawSeconds": 5.92
    },
    {
      "id": "h019",
      "scene": "resistance",
      "start": 3189,
      "end": 3402,
      "text": "让这段小动脉慢慢收紧，流量先保持不变。管腔越窄，需要的压力差就越大。",
      "rawSeconds": 6.88
    },
    {
      "id": "h020",
      "scene": "resistance",
      "start": 3405,
      "end": 3575,
      "text": "这段细管，用来观察管径、流量和压差怎样一起变化。",
      "rawSeconds": 5.44
    },
    {
      "id": "h021",
      "scene": "resistance",
      "start": 3578,
      "end": 3740,
      "text": "当许多小动脉长期偏紧，心脏把血送出去，就要面对更高的压力。",
      "rawSeconds": 5.2
    },
    {
      "id": "h022",
      "scene": "resistance",
      "start": 3743,
      "end": 3879,
      "text": "管壁放松，阻力又降下来，血液就更容易通过。",
      "rawSeconds": 4.320041666666667
    },
    {
      "id": "h023",
      "scene": "resistance",
      "start": 3882,
      "end": 4016,
      "text": "小动脉为何总紧着？线索藏在调水盐的肾脏里。",
      "rawSeconds": 4.24
    },
    {
      "id": "h024",
      "scene": "kidney",
      "start": 4025,
      "end": 4221,
      "text": "腰背两侧的肾脏，每天都在调整，多少水和钠留下，多少从尿里排走。",
      "rawSeconds": 6.32
    },
    {
      "id": "h025",
      "scene": "kidney",
      "start": 4224,
      "end": 4401,
      "text": "盐里的钠，参与体液平衡；水和钠的去留，常常一起变化。",
      "rawSeconds": 5.68
    },
    {
      "id": "h026",
      "scene": "kidney",
      "start": 4404,
      "end": 4588,
      "text": "看这条细小的肾小管。一部分水和钠被收回，剩下的继续走向尿液。",
      "rawSeconds": 5.92
    },
    {
      "id": "h027",
      "scene": "kidney",
      "start": 4591,
      "end": 4756,
      "text": "摄入过多、排出跟不上，体内可能留住更多水，循环负担就重。",
      "rawSeconds": 5.28
    },
    {
      "id": "h028",
      "scene": "kidney",
      "start": 4759,
      "end": 4943,
      "text": "同一顿咸饭，有人血压波动大，有人小，这和盐敏感性有关。",
      "rawSeconds": 5.92
    },
    {
      "id": "h029",
      "scene": "kidney",
      "start": 4946,
      "end": 5128,
      "text": "遗传、年龄和肾脏的状态，都会影响这种反应，所以每个人并不一样。",
      "rawSeconds": 5.84
    },
    {
      "id": "h030",
      "scene": "kidney",
      "start": 5131,
      "end": 5281,
      "text": "肾脏还会发出信号，联络血管和其他器官，一起调节血压。",
      "rawSeconds": 4.8
    },
    {
      "id": "h031",
      "scene": "control",
      "start": 5290,
      "end": 5438,
      "text": "这条信号从肾素开始，经过几步接力，传向身体各处。",
      "rawSeconds": 4.72
    },
    {
      "id": "h032",
      "scene": "control",
      "start": 5441,
      "end": 5579,
      "text": "收到信号，小动脉收紧，身体会多留一些盐和水。",
      "rawSeconds": 4.4
    },
    {
      "id": "h033",
      "scene": "control",
      "start": 5582,
      "end": 5771,
      "text": "在需要维持循环时，这套调节很有用；持续活跃，却可能把血压推高。",
      "rawSeconds": 6.08
    },
    {
      "id": "h034",
      "scene": "control",
      "start": 5774,
      "end": 5956,
      "text": "还有一条更快的线路：交感神经。紧张时，心跳加快，就有它的参与。",
      "rawSeconds": 5.84
    },
    {
      "id": "h035",
      "scene": "control",
      "start": 5959,
      "end": 6121,
      "text": "它能让心脏加把劲，让部分血管收紧，也会影响肾脏的调节。",
      "rawSeconds": 5.2
    },
    {
      "id": "h036",
      "scene": "control",
      "start": 6124,
      "end": 6315,
      "text": "肥胖、睡眠呼吸暂停等问题，可能让这些调节持续偏向升压的一边。",
      "rawSeconds": 6.16
    },
    {
      "id": "h037",
      "scene": "control",
      "start": 6318,
      "end": 6473,
      "text": "几条线路彼此影响，高血压常常就在这样的长期失衡中形成。",
      "rawSeconds": 4.96
    },
    {
      "id": "h038",
      "scene": "remodel",
      "start": 6482,
      "end": 6632,
      "text": "再看主动脉。年纪增长时，管壁可能渐渐变硬。",
      "rawSeconds": 4.8
    },
    {
      "id": "h039",
      "scene": "remodel",
      "start": 6635,
      "end": 6802,
      "text": "同样一股血涌进来，柔软的血管能先撑开一些，缓冲这次冲击。",
      "rawSeconds": 5.36
    },
    {
      "id": "h040",
      "scene": "remodel",
      "start": 6805,
      "end": 6924,
      "text": "较硬的管壁扩张有限，收缩压就更容易冲高。",
      "rawSeconds": 3.76
    },
    {
      "id": "h040a",
      "scene": "remodel",
      "start": 6927,
      "end": 7106,
      "text": "血脂也影响管壁。肝脏把脂肪装进极低密度脂蛋白，送进血液。",
      "rawSeconds": 5.76
    },
    {
      "id": "h040b",
      "scene": "remodel",
      "start": 7109,
      "end": 7298,
      "text": "沿途卸下甘油三酯，颗粒逐渐缩小，经过中间阶段，形成低密度脂蛋白。",
      "rawSeconds": 6.08
    },
    {
      "id": "h040c",
      "scene": "remodel",
      "start": 7301,
      "end": 7497,
      "text": "肝脏靠受体把它收回来。生成多了，或清除慢了，血里的水平就会上升。",
      "rawSeconds": 6.32
    },
    {
      "id": "h041",
      "scene": "remodel",
      "start": 7500,
      "end": 7653,
      "text": "血液里的低密度脂蛋白，还可能进入并滞留在动脉内膜。",
      "rawSeconds": 4.88
    },
    {
      "id": "h042",
      "scene": "remodel",
      "start": 7656,
      "end": 7814,
      "text": "免疫细胞吞下脂质，变成泡沫细胞，慢慢积成斑块。",
      "rawSeconds": 5.04
    },
    {
      "id": "h043",
      "scene": "remodel",
      "start": 7817,
      "end": 8008,
      "text": "斑块表面一旦破裂，血小板聚集，凝血反应形成血栓，可能堵住血管。",
      "rawSeconds": 6.16
    },
    {
      "id": "h044",
      "scene": "remodel",
      "start": 8011,
      "end": 8181,
      "text": "高血压常由多种因素叠加。持续高压，会伤到心、脑和肾。",
      "rawSeconds": 5.44
    },
    {
      "id": "h045",
      "scene": "measure",
      "start": 8190,
      "end": 8374,
      "text": "好在，这些风险可以降低。少盐、多活动、管理体重，都能帮上忙。",
      "rawSeconds": 5.92
    },
    {
      "id": "h046",
      "scene": "measure",
      "start": 8377,
      "end": 8551,
      "text": "需要治疗时，按医生制定的方案管理，别凭感觉停药，也别等到难受。",
      "rawSeconds": 5.6
    },
    {
      "id": "h047",
      "scene": "measure",
      "start": 8554,
      "end": 8752,
      "text": "量血压前，先安静坐五分钟。背靠椅背，双脚平放，手臂与心脏同高。",
      "rawSeconds": 6.4
    },
    {
      "id": "h048",
      "scene": "measure",
      "start": 8755,
      "end": 8929,
      "text": "用合适的上臂式袖带，测量时不说话，按规范重复测量并记录。",
      "rawSeconds": 5.6
    },
    {
      "id": "h049",
      "scene": "measure",
      "start": 8932,
      "end": 9123,
      "text": "反复偏高，应及时就医。带上一段时间的记录，让医生判断，更有意义。",
      "rawSeconds": 6.16
    },
    {
      "id": "h050",
      "scene": "measure",
      "start": 9126,
      "end": 9308,
      "text": "血压计上的两个数，藏着整个循环系统的配合。看懂它，也记得量一量。",
      "rawSeconds": 5.84
    }
  ],
