{
  "purpose": "V4 flowing camera scientific narration; direct phrasing and LDL lifecycle",
  "previousTimelineSha256": "783e5f51a704e3a138bbb89414871c7386c889caaaf952e2e27a86332db3b619",
  "changedClips": [
    {
      "id": "h008",
      "before": "流动需要压力，血液作用在动脉壁上的压力，就是血压。",
      "after": "血液推着管壁。每单位面积承受的力，就是这里的压强，也叫血压。",
      "oldSeconds": 4.8,
      "newSeconds": 6.08,
      "rawSha256": "8c1c401bf06d07e1641b5148ebdc3b2e787315731ac1f8109b1e5a3f19637c17"
    },
    {
      "id": "h009",
      "before": "把血管剖开看，它的壁有肌肉，也有弹性，能收紧，也能舒展。",
      "after": "主动脉壁很有弹性。血液涌进来，它会扩张，暂时储存一部分能量。",
      "oldSeconds": 5.84,
      "newSeconds": 5.84,
      "rawSha256": "22ad028d1474b2ba8c4a46d5b89224ddd1baef1b5fffa24f3f9596e0b2132485"
    },
    {
      "id": "h011",
      "before": "心脏收缩时，血液涌入，大动脉被撑开，压力跟着抬高。",
      "after": "心脏收缩，把血推进主动脉，管壁被撑开，压强随之上升。",
      "oldSeconds": 5.52,
      "newSeconds": 6.000041666666666,
      "rawSha256": "ecc31e30715bda1a83e06f0fc51592d87b17a0c5ce6a55e206db423244866292"
    },
    {
      "id": "h012",
      "before": "心脏舒张时，动脉又弹回来，继续推动血液，压力也逐渐回落。",
      "after": "心脏舒张，主动脉弹回来，继续推着血液向前，压强逐渐回落。",
      "oldSeconds": 5.76,
      "newSeconds": 6.16,
      "rawSha256": "8c09428a7b361c9693ca6f9e027b5259da98f031445213636498382065a343d0"
    },
    {
      "id": "h017",
      "before": "先跟着血流，来到这些小动脉。这里是调节血流阻力的重要位置。",
      "after": "血流继续分支。到了小动脉，调节阻力的主角换成了平滑肌。",
      "oldSeconds": 5.2,
      "newSeconds": 5.44,
      "rawSha256": "d8f7395a4a7b605ac0f8863a675b28e08cac295eab511fac3b53efd01517d51c"
    },
    {
      "id": "h020",
      "before": "这是简化模型的对照。人体更复杂，但小动脉收紧，确实会增加阻力。",
      "after": "这段细管，用来观察管径、流量和压差怎样一起变化。",
      "oldSeconds": 5.76,
      "newSeconds": 5.44,
      "rawSha256": "69eedcfe651b15bef77d4a7084baa9937e66e83f7b3e0f7d44f632aa9ad14237"
    },
    {
      "id": "h022",
      "before": "所以血压高，不等于血管堵住；关键常是小动脉长期偏紧。",
      "after": "管壁放松，阻力又降下来，血液就更容易通过。",
      "oldSeconds": 5.36,
      "newSeconds": 4.320041666666667,
      "rawSha256": "e75be8b1bda74189c03b7fd3296c90c3cc58024343c87668fed07964f112007e"
    },
    {
      "id": "h031",
      "before": "由肾素启动的信号链，能收紧血管，也让身体留下盐和水。",
      "after": "这条信号从肾素开始，经过几步接力，传向身体各处。",
      "oldSeconds": 5.04,
      "newSeconds": 4.72,
      "rawSha256": "59f6a6ec4c8f4240f37264ee674465201aefcb65776c4808496b184e785c28cb"
    },
    {
      "id": "h032",
      "before": "这条信号会让血管收紧，肾脏也会多留盐和水。",
      "after": "收到信号，小动脉收紧，身体会多留一些盐和水。",
      "oldSeconds": 4.48,
      "newSeconds": 4.4,
      "rawSha256": "861733351864f64427d298ad4773dc785dc637fc8d06ac0dd7f2d7c9e1abb263"
    },
    {
      "id": "h038",
      "before": "再回到大动脉。随着年龄增长，它可能渐渐变硬，弹性也不如从前。",
      "after": "再看主动脉。年纪增长时，管壁可能渐渐变硬。",
      "oldSeconds": 6.16,
      "newSeconds": 4.8,
      "rawSha256": "ced4407ffe587358ba4a1b20e169745cd140142d38a1e1e75dce67637c42bc2d"
    },
    {
      "id": "h040",
      "before": "较硬的血管不容易撑开，收缩时的压力就更容易冲高。",
      "after": "较硬的管壁扩张有限，收缩压就更容易冲高。",
      "oldSeconds": 4.16,
      "newSeconds": 3.76,
      "rawSha256": "b61e33014f8c4addbd8a534b4a8122a14b84e41eae54ace03bfa8b6b148ad8f6"
    },
    {
      "id": "h041",
      "before": "长期高压损伤内皮，低密度脂蛋白更容易进入管壁。",
      "after": "血液里的低密度脂蛋白，还可能进入并滞留在动脉内膜。",
      "oldSeconds": 4.24,
      "newSeconds": 4.88,
      "rawSha256": "15dd485d1aa6265972913ad56863f6d54b4b3fff0ef8ce8537d20fabe3952dc3"
    },
    {
      "id": "h042",
      "before": "它和炎症形成斑块，让动脉变硬、变窄；但高血压不等于血管堵了。",
      "after": "免疫细胞吞下脂质，变成泡沫细胞，慢慢积成斑块。",
      "oldSeconds": 6.08,
      "newSeconds": 5.04,
      "rawSha256": "de01add58e0d95cbec72c63911dbc711c2245ba43c9d20e8165a51f38961dceb"
    },
    {
      "id": "h043",
      "before": "斑块若破裂，血小板会形成血栓，风险突然升级；这和慢性升压是两回事。",
      "after": "斑块表面一旦破裂，血小板聚集，凝血反应形成血栓，可能堵住血管。",
      "oldSeconds": 6.2400416666666665,
      "newSeconds": 6.16,
      "rawSha256": "368fe51694be0d21e34a19a34e722256b76610ca7013e2ad30a80772775f65e3"
    },
    {
      "id": "h044",
      "before": "多数高血压是多因素叠加，少数与肾病、激素或药物有关，长期会伤心、脑、肾。",
      "after": "高血压常由多种因素叠加。持续高压，会伤到心、脑和肾。",
      "oldSeconds": 8.08,
      "newSeconds": 5.44,
      "rawSha256": "86e36b693886e111a99e155eef792e86d2d3f03c8ce7f2014d7e177c6b88aa12"
    }
  ],
