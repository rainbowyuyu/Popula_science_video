  "reviewNotes": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\research\\revision-v7\\encoded-review-h046-h089.md",
  "reviewNotesSHA256": "d9ba1c8ddc4336ab8cffa7ff6d2b26a9f0bb5b0e13851ead87496cd721569cb8",
  "sheets": [
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h045-h046.jpg",
      "sha256": "6d1403e2df52f852d075518b262fdb56344fed18efc232992c53dde940818010",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h046",
          "text": "无论糖还是脂质，运输都靠心脏推动血液。血液对管壁形成压力，血压计测到的，就是这股压力的变化。",
          "frames": [
            13043,
            13141,
            13231
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h047-h048.jpg",
      "sha256": "a34bfc960db73deac01323ea0969c1ab0c2dba707042a236cb0dcc4b7500bea2",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h047",
          "text": "心脏收缩，把血推出去，压力升高；心脏舒张时，大动脉的弹性回缩继续推着血走，压力也不会掉到零。",
          "frames": [
            13323,
            13420,
            13509
          ]
        },
        {
          "id": "h048",
          "text": "血液还要经过许多小动脉。管壁上的肌肉收紧，通道变窄；要维持流动，就得有更大的压力差。",
          "frames": [
            13598,
            13690,
            13774
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h049-h050.jpg",
      "sha256": "a2a477e7d54b48a2ccedb468985b77203dd77de2d1899b6a515c192576417b3a",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h049",
          "text": "所以，血压高有多种来路：小动脉偏紧、循环里的水钠偏多、大动脉变硬，都可能参与其中。",
          "frames": [
            13860,
            13949,
            14031
          ]
        },
        {
          "id": "h050",
          "text": "要找水钠这一头，得顺着血液到肾脏。它把水和小分子滤出来，再把身体要留下的部分收回去。",
          "frames": [
            14114,
            14200,
            14279
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h051-h052.jpg",
      "sha256": "ab7b0897dfa9e23b3b53c3fb16eaa34958525c8dcfd3fecb46245309f09cdbac",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h051",
          "text": "肾小管多收回一些钠，水也容易跟着留下。循环里的液体增多，推动血流的负担就可能随之增加。",
          "frames": [
            14359,
            14445,
            14523
          ]
        },
        {
          "id": "h052",
          "text": "饭桌上的盐，不只在盐罐里。汤、酱油、腌菜和加工肉，也能积出不少；先少喝咸汤，是很具体的一步。",
          "frames": [
            14611,
            14712,
            14803
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h053-h054.jpg",
      "sha256": "5e40f4cff868cde92e69d5dbbd43a970c23db8ce2604606dd166cd92bd9cb286",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h053",
          "text": "肾脏还有一套保住血压的办法。感到灌注不足时，它能释放肾素，接力生成一种让血管收紧的信号。",
          "frames": [
            14895,
            14989,
            15074
          ]
        },
        {
          "id": "h054",
          "text": "这种信号叫血管紧张素二。它让小动脉收紧，还能促使肾上腺释放醛固酮，通知肾脏多留一点钠。",
          "frames": [
            15167,
            15268,
            15361
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h055-h056.jpg",
      "sha256": "77ad13656503ee519202492f245fa45f0ead1a8bc95a8406a2789b343981854c",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h055",
          "text": "失血、缺水时，这套办法有用；可它长期偏活跃，血管一直收紧、水钠留得多，血压就更难降下来。",
          "frames": [
            15455,
            15553,
            15643
          ]
        },
        {
          "id": "h056",
          "text": "内脏和肾脏周围的脂肪增多，会通过多种方式干扰这套调节。交感神经、激素和肾脏留钠，都可能参与。",
          "frames": [
            15737,
            15838,
            15931
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h057-h058.jpg",
      "sha256": "f36e8190512f59405b57895ea464b4e36d0c2949a292d7bd0c1a1bf4e0ccd438",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h057",
          "text": "交感神经一兴奋，心脏会加把劲，一些血管也会收紧。长期睡不好、反复缺氧等问题，也会增加调节负担。",
          "frames": [
            16025,
            16122,
            16211
          ]
        },
        {
          "id": "h058",
          "text": "如果睡觉打鼾，还反复憋醒、白天犯困，要想到睡眠呼吸暂停。它和肥胖常常相伴，也会牵动血压。",
          "frames": [
            16302,
            16397,
            16485
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h059-h060.jpg",
      "sha256": "0cd725717ee878a6716dd32339cc268d8e5d9fd31e8bd4e06be8048e21023442",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h059",
          "text": "确诊阻塞性睡眠呼吸暂停后，有人需要正压通气，用气压撑住上气道，减少反复缺氧；减重也能帮忙。",
          "frames": [
            16575,
            16671,
            16759
          ]
        },
        {
          "id": "h060",
          "text": "当生活调整还不够，降压药会从不同环节帮忙。像氨氯地平，会减少钙进入管壁肌肉细胞，让小动脉放松。",
          "frames": [
            16849,
            16943,
            17028
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h061-h062.jpg",
      "sha256": "189aa6f83d99fd52ad0ae56d1b867592467326508b93b92372f58c7b7eb347e5",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h061",
          "text": "小动脉松开，外周阻力就会下降。部分人会出现脚踝肿、脸热或头晕，这些反应也要和血压一起观察。",
          "frames": [
            17120,
            17220,
            17311
          ]
        },
        {
          "id": "h062",
          "text": "另一类常见的沙坦类药物，会挡住血管紧张素二的接收位置。血管少收紧一些，醛固酮相关的留钠信号也减弱。",
          "frames": [
            17406,
            17507,
            17600
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h063-h064.jpg",
      "sha256": "6fb52677bc8b4765e6840ddfef9cf474de414648f424af2fac65050605d98a72",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h063",
          "text": "这类药可能让血钾升高，肾功能也需要监测。正在用药时，别因为听说低钠盐好，就自行大量加含钾的盐。",
          "frames": [
            17696,
            17797,
            17890
          ]
        },
        {
          "id": "h064",
          "text": "还有常用的噻嗪或噻嗪样利尿剂，减少肾小管回收钠，让多余的钠和水排出去，帮助控制血压。",
          "frames": [
            17981,
            18074,
            18160
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h065-h066.jpg",
      "sha256": "533ee049f1b2663fb16e6d8b1a19d1288b4afa72ec8bd7de0d57b249eae5d373",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h065",
          "text": "但排水排盐也可能带走过多钾，出现乏力、抽筋或头晕。身体脱水时更要留意，复查电解质有实际用处。",
          "frames": [
            18251,
            18352,
            18443
          ]
        },
        {
          "id": "h066",
          "text": "用药以后，要看一段时间的记录。今天偏低、明天偏高，可能和测量条件、睡眠或活动有关，别只盯一个数。",
          "frames": [
            18539,
            18640,
            18733
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h067-h068.jpg",
      "sha256": "6ad12f9d5e4e4aad3cd468b94c620ddf412027043035f5385a1e4570808861dc",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h067",
          "text": "测量前安静坐至少五分钟，背靠稳、双脚落地。把手臂托好，让上臂袖带的中部接近心脏高度，再记录读数。",
          "frames": [
            18831,
            18938,
            19035
          ]
        },
        {
          "id": "h068",
          "text": "血压控制，是为了减轻血管和器官持续承受的负担。高血压和高血糖，也会让本来就有斑块的血管更容易出问题。",
          "frames": [
            19132,
            19233,
            19324
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h069-h070.jpg",
      "sha256": "3deea80fad330644c6f9630cd39c2c98a035b1299aeaf3ac8c4d443e949bf869",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h069",
          "text": "斑块在管壁里慢慢长；血栓，则是血液在不该凝固的地方结成一团。有时，危险就发生在两者接上的那一刻。",
          "frames": [
            19420,
            19521,
            19614
          ]
        },
        {
          "id": "h070",
          "text": "斑块表面一旦破裂，血液接触到里面的成分，血小板会黏过来、聚成团，凝血反应也被启动。",
          "frames": [
            19702,
            19789,
            19869
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h071-h072.jpg",
      "sha256": "ec06801a2728bdddff8ca48af8977becff9a7084553ca8dfd0fc9d850dc6b414",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h071",
          "text": "同时，纤维蛋白像细丝一样织成网，把血细胞和血小板固定住。血块越长越大，就可能突然堵住血流。",
          "frames": [
            19954,
            20047,
            20133
          ]
        },
        {
          "id": "h072",
          "text": "阿司匹林这一类抗血小板药，重点是减少血小板聚集。在某些已经发生心梗、缺血性卒中等情况下，会用到它。",
          "frames": [
            20225,
            20326,
            20419
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h073-h074.jpg",
      "sha256": "e9b84345538787c182d405e2cc7109208da7831b4a3258dcc6e293de44c01214",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h073",
          "text": "还有一种情况是房颤：心房收缩乱了，局部血流容易淤滞，可能在心脏里形成血栓，再顺着血流跑到脑部。",
          "frames": [
            20515,
            20616,
            20709
          ]
        },
        {
          "id": "h074",
          "text": "这时需要考虑的抗凝药，作用在凝血过程中的不同环节，减少血栓形成或继续长大的机会，和抗血小板药用途有区别。",
          "frames": [
            20808,
            20916,
            21015
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h075-h076.jpg",
      "sha256": "481f3a1be5dca2dab03cf43f682354fe56eb8ec509b2cd5eb7330838cf718412",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h075",
          "text": "抗凝药不能拿来降血压。降压管压力，降脂减少有害脂质负担，抗血小板和抗凝处理特定的血栓风险。",
          "frames": [
            21111,
            21207,
            21295
          ]
        },
        {
          "id": "h076",
          "text": "抗栓治疗的另一面，是更容易出血。仅仅有三高，就自己加上阿司匹林或抗凝药，可能添出新的麻烦。",
          "frames": [
            21385,
            21480,
            21567
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h077-h078.jpg",
      "sha256": "01f15cf2124fa71d1f791ff98a80c0f1c094c5748cbf60bf327732994560683a",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h077",
          "text": "如果突然嘴歪、说不清话、一侧胳膊没力，要立即拨打一二零。急症来时，不能等吃点药、睡一觉再看看。",
          "frames": [
            21659,
            21760,
            21851
          ]
        },
        {
          "id": "h078",
          "text": "再看这顿饭：甜饮换水，咸汤少喝；主食配好份量，蔬菜和蛋白质留下。每个改动，都对应刚才的一段过程。",
          "frames": [
            21947,
            22049,
            22143
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h079-h080.jpg",
      "sha256": "8979a7053583a158cb9b58e466570dd5966daf663b3b94e08d7693711dbdfa78",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h079",
          "text": "活动也能拆开做：饭后走一段，久坐时起身动动，再留些时间练力量。强度从自己能完成的程度慢慢加。",
          "frames": [
            22239,
            22340,
            22433
          ]
        },
        {
          "id": "h080",
          "text": "如果每晚饿得睡不着，第二天又吃到撑，这种办法就很难维持。把每餐安排得有饱足感，比天天硬忍更实际。",
          "frames": [
            22529,
            22630,
            22723
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h081-h082.jpg",
      "sha256": "6c7e758721c97dc233079cbdc7e00ac1c83bdda9f56b35573282f8918ff3d536",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h081",
          "text": "睡眠也在这张网里。经常睡不够，会影响食欲调节，让人更想吃，也更难察觉已经吃饱。",
          "frames": [
            22806,
            22883,
            22954
          ]
        },
        {
          "id": "h082",
          "text": "当多余脂肪逐渐减少，肌肉和肝脏对胰岛素的反应可能改善；肾脏留钠、神经升压的负担，也可能减轻。",
          "frames": [
            23034,
            23127,
            23213
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h083-h084.jpg",
      "sha256": "be68bfdf71e4d6383f5373e0a6cad44e65271c5224673fb6ac0c1643e32c3f3c",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h083",
          "text": "体重负担轻一些，活动可能更容易；肌肉练得更有力，又更有条件保持活动。这些变化，可以互相帮一把。",
          "frames": [
            23305,
            23406,
            23499
          ]
        },
        {
          "id": "h084",
          "text": "但体重回落时，身体也可能增加饥饿感、减少能量消耗，把人往原来的体重拉。遇到平台期，并不稀奇。",
          "frames": [
            23593,
            23690,
            23779
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h085-h086.jpg",
      "sha256": "3275965a5760eb1dfbf39b41dd9af285af750203454e8a3b4b74c7a69c2172f5",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h085",
          "text": "这时更需要能重复的饭菜、活动和睡眠安排；需要药物帮助的人，也要把营养和生活习惯一起接上。",
          "frames": [
            23870,
            23966,
            24054
          ]
        },
        {
          "id": "h086",
          "text": "接下来，除了体重，还看腰围、血压、血糖和血脂的趋势。能不能走得稳、吃得下、有力气，同样值得记录。",
          "frames": [
            24152,
            24263,
            24364
          ]
        }
      ]
    },
    {
      "path": "D:\\python_project\\manim_extend_rainbow\\video_project\\glp1_nobel_2026\\tmp\\v7-encoded-qa\\sheets\\h087-h088.jpg",
      "sha256": "44e2ca228cd18e78b830aa88d02839364da0d4f2114afdc43c3655481d275bb0",
      "actuallyViewed": true,
      "clips": [
        {
          "id": "h087",
