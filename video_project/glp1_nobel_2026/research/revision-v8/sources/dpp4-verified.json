        "journalInfo": {
          "issue": "2",
          "volume": "49",
          "journalIssueId": 741196,
          "dateOfPublication": "1993 Dec",
          "monthOfPublication": 12,
          "yearOfPublication": 1993,
          "journal": {
            "medlineAbbreviation": "Regul Pept",
            "title": "Regulatory peptides",
            "essn": "1873-1686",
            "issn": "0167-0115",
            "isoabbreviation": "Regul Pept",
            "nlmid": "8100479"
