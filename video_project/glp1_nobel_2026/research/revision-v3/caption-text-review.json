  "scope": "Pre-alignment display text clause review; actual timestamp checks follow final voice selection.",
  "rows": [
    {
      "id": "g001",
      "parts": [
        "今年诺奖开奖前，",
        "法新社把减肥药背后的肠道信号研究，",
        "列为医学奖热门。",
        "它特别在哪里？"
      ]
    },
    {
      "id": "g002",
      "parts": [
        "它叫胰高血糖素样肽-1（GLP-1）。",
        "今年虽未获奖，",
        "却已成为重要药物的起点。",
        "故事，",
        "从一顿饭讲起。"
      ]
    },
    {
      "id": "g003",
      "parts": [
        "晚饭吃完了，",
        "桌上还有一块甜点。",
        "明明觉得饱了，",
        "为什么还想来一口？"
      ]
    },
    {
      "id": "g004",
      "parts": [
        "胃里的空间只是一个因素。",
        "肠道、大脑和血液里的信号，",
        "也在参与这个决定。"
      ]
    },
    {
      "id": "g005",
      "parts": [
        "科学家最初追查它，",
        "却是为了血糖：",
        "吃下去的糖，",
        "为什么让身体作出不同反应？"
      ]
    },
    {
      "id": "g006",
      "parts": [
        "我们沿着食物的路线，",
        "找到信号从哪里来，",
        "再看看研究者怎样摸清它的作用。"
      ]
    },
    {
      "id": "g007",
      "parts": [
        "食物经过胃，",
        "进入肠道。",
        "营养接触肠壁，",
        "一些感知营养的细胞，",
        "开始发送消息。"
      ]
    },
    {
      "id": "g008",
      "parts": [
        "放大肠壁，",
        "可以看到L细胞。",
        "它从朝向身体内部的一侧，",
        "把小肽释放出去。"
      ]
    },
    {
      "id": "g009",
      "parts": [
        "小肽进入周围组织和毛细血管。",
        "食物还在肠道，",
        "消息却已经能传向其他器官。"
      ]
    },
    {
      "id": "g010",
      "parts": [
        "早期研究比较了喝糖水和静脉输糖。",
        "血糖升到相近水平时，",
        "喝糖水的一侧，",
        "胰岛素释放更多。"
      ]
    },
    {
      "id": "g011",
      "parts": [
        "这个差别，",
        "提示肠道会帮助胰腺工作。",
        "研究者继续追查，",
        "找到了这条小肽。"
      ]
    },
    {
      "id": "g012",
      "parts": [
        "先找到胃后面的胰腺，",
        "再找到里面的胰岛。",
        "选其中一个放大，",
        "直径约零点一五毫米。"
      ]
    },
    {
      "id": "g013",
      "parts": [
        "胰岛里，",
        "直径十几微米的β细胞分泌胰岛素。",
        "再放大上千倍，",
        "才看清膜上纳米级的受体。"
      ]
    },
    {
      "id": "g014",
      "parts": [
        "一九八七年，",
        "莫伊索夫等人把两种长度的小肽，",
        "分别加入离体大鼠胰腺。",
        "葡萄糖条件相同，",
        "短片段促进胰岛素释放，",
        "长片段却没有这个效果。"
      ]
    },
    {
      "id": "g015",
      "parts": [
        "同年，",
        "德鲁克等人在培养的大鼠细胞里发现，",
        "短片段让内部传信分子增加，",
        "制造胰岛素的分子指令和胰岛素释放，",
        "也跟着增加。"
      ]
    },
    {
      "id": "g016",
      "parts": [
        "小肽结合膜上受体，",
        "把消息传进细胞。",
        "血糖较高时，",
        "装着胰岛素的小泡，",
        "更容易与细胞膜融合。"
      ]
    },
    {
      "id": "g017",
      "parts": [
        "胰岛素随之释放；",
        "催促肝脏放糖的胰高血糖素也受到抑制，",
        "一起帮助调节餐后血糖。"
      ]
    },
    {
      "id": "g018",
      "parts": [
        "研究者因此看到一种可能：",
        "顺着身体已有的信号，",
        "帮助治疗血糖异常。"
      ]
    },
    {
      "id": "g019",
      "parts": [
        "这条信号，",
        "会不会也影响想吃东西的感觉？",
        "接下来，",
        "研究转向了大脑。"
      ]
    },
    {
      "id": "g020",
      "parts": [
        "一九九六年，",
        "研究者把小肽注入大鼠脑室，",
        "进食减少。",
        "先挡住对应受体，",
        "这个效果就被阻断了。"
      ]
    },
    {
      "id": "g021",
      "parts": [
        "后来的人体研究直接测量进食量。",
        "使用相关药物的人，",
        "饥饿感减轻，",
        "吃下的食物也减少了。"
      ]
    },
    {
      "id": "g022",
      "parts": [
        "日常的肠脑沟通，",
        "还会经过迷走神经等路线。",
        "食欲，",
        "是多条消息一起调节的。"
      ]
    },
    {
      "id": "g023",
      "parts": [
        "药物也会减慢胃排空。",
        "不过，",
        "长期减重，",
        "还要结合持续的食欲和能量摄入变化来理解。"
      ]
    },
    {
      "id": "g024",
      "parts": [
        "吃进去的能量持续减少，",
        "体重才在数周、数月里改变。",
        "这也让我们更理解减重为什么难。"
      ]
    },
    {
      "id": "g025",
      "parts": [
        "但做成药还有一个难题：",
        "天然活性小肽进入血液后，",
        "大约一两分钟就减少一半。"
      ]
    },
    {
      "id": "g026",
      "parts": [
        "研究者在人血清里发现，",
        "它开头会少掉两个氨基酸。",
        "抑制那把分子剪刀后，",
        "这种剪切就停了。"
      ]
    },
    {
      "id": "g027",
      "parts": [
        "先保护剪切点。",
        "研究者换掉一个容易被剪的氨基酸，",
        "再检查受体还能不能认出它。"
      ]
    },
    {
      "id": "g028",
      "parts": [
        "接着延长停留。",
        "给小肽接上侧链，",
        "就能暂时搭上血液中的白蛋白，",
        "减慢清除。"
      ]
    },
    {
      "id": "g029",
      "parts": [
        "侧链多长，",
        "怎样连接，",
        "都得比较。",
        "既要延长停留，",
        "也要保留激活受体的能力。"
      ]
    },
    {
      "id": "g030",
      "parts": [
        "比较多种组合后，",
        "十八个碳的脂肪二酸侧链，",
        "加上合适的连接臂，",
        "取得了好的平衡。"
      ]
    },
    {
      "id": "g031",
      "parts": [
        "这些改造组成了司美格鲁肽。",
        "它在人体内的半衰期约一周，",
        "支持每周一次皮下注射。"
      ]
    },
    {
      "id": "g032",
      "parts": [
        "设计得巧，",
        "到了人身上能帮多少忙？",
        "这要用临床试验来检验。"
      ]
    },
    {
      "id": "g033",
      "parts": [
        "一项试验，",
        "将约两千名",
        "无糖尿病、符合超重或肥胖条件的成年人，",
        "随机分组。"
      ]
    },
    {
      "id": "g034",
      "parts": [
        "两组都有饮食运动指导，",
        "分别注射司美格鲁肽或安慰剂，",
        "观察六十八周。"
      ]
    },
    {
      "id": "g035",
      "parts": [
        "平均减重，",
        "药物组百分之十四点九，",
        "安慰剂组百分之二点四。"
      ]
    },
    {
      "id": "g036",
      "parts": [
        "这是群体平均结果。",
        "个人效果和耐受情况，",
        "还需要持续观察。"
      ]
    },
    {
      "id": "g037",
      "parts": [
        "另一项试验，",
        "关注已有心血管病、超重或肥胖，",
        "却没有糖尿病的人。"
      ]
    },
    {
      "id": "g038",
      "parts": [
        "平均随访约四十个月，",
        "主要心血管事件比例，",
        "是百分之六点五，",
        "对百分之八。"
      ]
    },
    {
      "id": "g039",
      "parts": [
        "相当于每百人约少一点五人，",
        "发生心血管死亡、非致死性心梗或卒中。"
      ]
    },
    {
      "id": "g040",
      "parts": [
        "同时，",
        "也有人出现恶心、呕吐、腹泻，",
        "甚至因此停止治疗。"
      ]
    },
    {
      "id": "g041",
      "parts": [
        "停止药物和试验生活方式干预一年后，",
        "原药物组平均长回了此前减重的约三分之二。"
      ]
    },
    {
      "id": "g042",
      "parts": [
        "平均体重仍低于起点，",
        "却明显回升。",
        "怎样长期管理，",
        "成了必须继续回答的问题。"
      ]
    },
    {
      "id": "g043",
      "parts": [
        "回头看，",
        "发现来自具体的问题：",
        "哪个片段有效，",
        "经由哪个受体，",
        "为什么又很快失效？"
      ]
    },
    {
      "id": "g044",
      "parts": [
        "研究者反复比较不同片段、不同侧链，",
        "再测量每种设计的结果。"
      ]
    },
    {
      "id": "g045",
      "parts": [
        "接着用对照试验，",
        "检验这些改动，",
        "究竟给患者带来了多少帮助。"
      ]
    },
    {
      "id": "g046",
      "parts": [
        "从找出身体的消息，",
        "到延长它的作用，",
        "这条路走了几十年，",
        "也仍在继续。"
      ]
    },
    {
      "id": "g047",
      "parts": [
        "再回到这顿晚饭。",
        "饱腹背后，",
        "有器官之间细小的交流；",
        "刚刚追过的，",
        "只是其中一条。"
      ]
    },
    {
      "id": "g048",
      "parts": [
        "一个吃饭的问题，",
        "就这样连起了肠道、细胞和药物。",
        "下一次感到吃饱了，",
        "也许你会想起这条小小的消息。"
      ]
    }
  ]
}
