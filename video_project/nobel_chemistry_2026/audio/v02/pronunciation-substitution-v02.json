        "label": "Kagan",
        "start": 2.22,
        "end": 2.66,
        "nativeSource": "kagan-native-short.wav",
        "nativeStart": 0.6,
        "nativeEnd": 1.4,
        "actualReading": "Kagan",
        "note": "Native carrier surname; short vowel, not English kay-gan",
        "gain": 1.383335129496199,
        "crossfadeMs": 12,
        "replacementSeconds": 0.86
      }
    ],
    "sameReferenceVoice": true,
    "originalPitchAndSpeed": true,
    "humanListeningChecked": false,
