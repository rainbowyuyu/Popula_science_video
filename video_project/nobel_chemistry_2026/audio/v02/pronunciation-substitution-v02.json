        "nativeEnd": 1.12,
        "actualReading": "ケンソー・ソアイ",
        "note": "Japanese katakana; independent Japanese recognition ケンソーソアイ",
        "gain": 0.9601169291661004,
        "crossfadeMs": 12,
        "replacementSeconds": 1.18
